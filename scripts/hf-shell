#!/usr/bin/env bash
# hf-shell — arranca Quickshell (fondo, barra, paneles) y lo mantiene vivo.
#   hf-shell           arranca el shell si no está, y el vigilante (lo usa autostart.lua)
#   hf-shell restart   lo reinicia (Ctrl + Super + R)
#   hf-shell watch     vigilante: si el shell se cae, lo reabre a los pocos segundos. Pasa, por ejemplo,
#                      con monitores que «desconectan» el HDMI al apagarse la pantalla por inactividad.
#                      Si el shell se cae safeModeCrashLimit veces (por defecto 3) en los primeros minutos,
#                      avisa y ofrece el modo seguro (hf-safe offer). Si lleva un rato estable, guarda tus
#                      ajustes como «copia buena» (hf-safe mark-good) para poder volver a ella.
# Un cerrojo por sesión de Hyprland (flock) evita dos shells a la vez; cada sesión anidada lleva el suyo.
set -u
for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
ROOT="${HF_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
SIG="${HYPRLAND_INSTANCE_SIGNATURE:-sin-hyprland}"
RUN="${XDG_RUNTIME_DIR:-/tmp}/hf-shell-$SIG"
LOCK="$RUN.lock"
CMD="qs -p $ROOT/config/quickshell"

running() { ! flock -n "$LOCK" true 2>/dev/null; }
# El socket queda como archivo tras cerrar una sesión anidada: hay que preguntar a Hyprland
alive_session() { [ -S "${XDG_RUNTIME_DIR:-/tmp}/hypr/$SIG/.socket.sock" ] && HYPRLAND_INSTANCE_SIGNATURE=$SIG timeout 3 hyprctl version >/dev/null 2>&1; }
# -o: los hijos de qs (web apps…) no heredan el candado; si no, lo retienen tras cerrarse la barra
start() { running || setsid -f flock -n -o "$LOCK" $CMD >/dev/null 2>&1; }

# Solo los Quickshell de ESTA sesión (no los de una sesión de prueba anidada con el mismo repo)
mine() {
  local p
  for p in $(pgrep -xf "$CMD"); do
    tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qx "HYPRLAND_INSTANCE_SIGNATURE=$SIG" && echo "$p"
  done
}

case "${1:-}" in
  restart)
    pids="$(mine)"; [ -n "$pids" ] && kill $pids
    for _ in $(seq 30); do [ -z "$(mine)" ] && ! running && break; sleep 0.1; done
    start
    ;;
  watch)
    exec 9>"$RUN.watch"; flock -n 9 || exit 0          # un solo vigilante por sesión
    # Caídas al arrancar → ofrecer el modo seguro; shell estable → copia buena de los ajustes
    LIMIT="$(jq -r '.safeModeCrashLimit // empty' "$HOME/.config/hyprfrijol/settings.json" 2>/dev/null)"
    case "$LIMIT" in ''|*[!0-9]*) LIMIT=3 ;; esac
    T0=$SECONDS CRASHES=0 OFFERED=0 GOOD=0 UP_SINCE=$SECONDS
    while sleep 3; do
      alive_session || { sleep 3; alive_session; } || exit 0   # Hyprland ya no está: fin
      if running || [ -n "$(mine)" ]; then
        if [ "$GOOD" = 0 ] && [ -z "${HF_TRY:-}" ] && [ $((SECONDS - UP_SINCE)) -ge 90 ]; then   # (no en dev/try.sh: sus ajustes son temporales)
          GOOD=1; "$ROOT/scripts/hf-safe" mark-good >/dev/null 2>&1 &
        fi
        continue
      fi
      sleep 2; { running || [ -n "$(mine)" ]; } && continue   # deja terminar un reinicio en curso
      command -v logger >/dev/null && logger -t hf-shell "Quickshell no estaba en marcha: lo reabro"
      if [ $((SECONDS - T0)) -le 300 ]; then CRASHES=$((CRASHES + 1)); fi
      if [ "$LIMIT" -gt 0 ] && [ "$CRASHES" -ge "$LIMIT" ] && [ "$OFFERED" = 0 ]; then
        OFFERED=1
        setsid -f "$ROOT/scripts/hf-safe" offer "El shell (Quickshell) se ha cerrado $CRASHES veces al arrancar." >/dev/null 2>&1
      fi
      start; UP_SINCE=$SECONDS
    done
    ;;
  *)
    [ -n "$(mine)" ] || start
    setsid -f "$0" watch >/dev/null 2>&1
    # Actualizaciones de hyprfrijol (hfUpdateCheck: semanal por defecto); solo en una sesión real
    [ -z "${HF_NESTED:-}" ] && [ -x "$ROOT/scripts/hf-update" ] && setsid -f "$ROOT/scripts/hf-update" auto >/dev/null 2>&1
    ;;
esac
