    ("window_mode", "Modo de ventanas del escritorio: mosaico, desplazamiento (columnas) o flotante.",
     {"type": "object", "properties": {"mode": {"enum": ["mosaico", "desplazamiento", "flotante"]}}, "required": ["mode"]},
     "action", lambda a: {"type": "winmode", "value": a.get("mode")}),
    ("pomodoro", "Pomodoro: start (minutos), pause o reset.",
     {"type": "object", "properties": {"op": {"enum": ["start", "pause", "reset"]}, "minutes": {"type": "integer"}}, "required": ["op"]},
     "action", lambda a: {"type": "pomodoro", "value": a.get("op"), "minutes": a.get("minutes") or 25}),
    ("clear_notifications", "Borra todas las notificaciones.",
     {"type": "object", "properties": {}}, "action", lambda a: {"type": "notifications", "op": "clear"}),
    # Ronda 8: dispositivos (hf-devices), descargas (hf-download) y Wallhaven (hf-wallhaven)
    ("list_devices", "Memorias USB, tarjetas SD y discos: dev, nombre, tipo, espacio usado/libre y dónde están montados.",
     {"type": "object", "properties": {}}, "query", lambda a: {"type": "devices"}),
    ("device_action", "Monta, desmonta, abre o expulsa (desmonta y apaga) una unidad extraíble; eject-all expulsa todas. "
     "dev: el de list_devices (/dev/sdb1) o su etiqueta.",
     {"type": "object", "properties": {"op": {"enum": ["mount", "unmount", "open", "eject", "eject-all"]}, "dev": {"type": "string"}},
      "required": ["op"]}, "action", lambda a: {"type": "device", "op": a.get("op"), "dev": a.get("dev")}),
    ("list_downloads", "La cola de descargas: id, nombre, estado (queued/running/paused/done/error/canceled), progreso 0–1 y error.",
     {"type": "object", "properties": {}}, "query", lambda a: {"type": "downloads"}),
    ("download", "Añade enlaces a la cola de descargas (vídeo/audio con yt-dlp, galerías con gallery-dl, archivos con aria2c; "
     "la herramienta y la carpeta se eligen solas). kind: auto|video|audio|image|file · format: best|1080|720|480 (vídeo) o mp3|opus|m4a (audio).",
     {"type": "object", "properties": {"urls": {"type": "array", "items": {"type": "string"}}, "kind": {"enum": ["auto", "video", "audio", "image", "file"]},
                                       "format": {"enum": ["best", "1080", "720", "480", "mp3", "opus", "m4a"]}}, "required": ["urls"]},
     "action", lambda a: {"type": "download", "urls": a.get("urls"), "kind": a.get("kind") or "auto", "format": a.get("format") or ""}),
    ("download_control", "Pausa, reanuda, cancela o reintenta una descarga (id de list_downloads) o todas (id 'all').",
     {"type": "object", "properties": {"op": {"enum": ["pause", "resume", "cancel", "retry"]}, "id": {"type": "string"}}, "required": ["op"]},
     "action", lambda a: {"type": "download_ctl", "op": a.get("op"), "id": a.get("id") or "all"}),
    ("wallhaven_search", "Busca fondos en wallhaven.cc (solo aptos salvo que el usuario diga otra cosa en Ajustes; al menos la resolución de su pantalla).",
     {"type": "object", "properties": {"query": {"type": "string"}, "sorting": {"enum": ["toplist", "random", "date_added", "relevance", "views", "favorites"]}}},
     "query", lambda a: {"type": "wallhaven", "query": a.get("query", ""), "sorting": a.get("sorting")}),
    ("wallhaven_wallpaper", "Con un id de wallhaven_search: 'add' lo añade a los fondos del usuario, 'set' lo pone de fondo.",
     {"type": "object", "properties": {"op": {"enum": ["add", "set"]}, "id": {"type": "string"}}, "required": ["op", "id"]},
     "action", lambda a: {"type": "wallhaven", "op": a.get("op"), "id": a.get("id")}),
    # Ronda 9: lo mismo que los comandos de voz (scripts/hf-voice)
    ("play_music", "Reproduce una canción o vídeo: busca «query» y abre el primer resultado en YouTube (arranca solo), "
     "YouTube Music o Spotify (búsqueda). Ej.: query «Walk Foo Fighters».",
     {"type": "object", "properties": {"query": {"type": "string"}, "service": {"enum": ["youtube", "music", "spotify"]}}, "required": ["query"]},
     "action", lambda a: {"type": "youtube", "query": a.get("query"), "service": a.get("service") or "youtube"}),
    ("browser_control", "Manda teclas al navegador (enfoca uno si la ventana activa no lo es): new-tab, close-tab, reopen-tab, "
     "next-tab, prev-tab, back, forward, reload, scroll-down, scroll-up, top, bottom, fullscreen, zoom-in, zoom-out, "
     "find (value: texto a buscar en la página), search (value: búsqueda en Google), open (value: web o dirección).",
     {"type": "object", "properties": {"op": {"enum": list(BROWSER_OPS)}, "value": {"type": "string"}}, "required": ["op"]},
     "action", lambda a: {"type": "browser", "op": a.get("op"), "value": a.get("value") or ""}),
]
# Herramientas que pueden borrar o quitar algo sin vuelta atrás (hf-mcp lo anuncia como destructiveHint)
DESTRUCTIVE_TOOLS = {"window_action", "clear_notifications", "device_action", "download_control", "browser_control"}

def tool_call(name, args):
    t = next((x for x in TOOL_SPECS if x[0] == name), None)
    if not t:
        return {"error": f"Herramienta desconocida: {name}"}
    q = t[4](args or {})
    if t[3] == "query":
        lab, res = run_query(q, {"window": True})
        res = redact(res)[0]   # también por MCP (Claude Desktop…): el filtro de secretos vale para todo lo que sale
        try:
            return {"result": json.loads(res)}
        except Exception:
            return {"result": res}
    acts = validate([{k: v for k, v in q.items() if v is not None}])
    if not acts:
        return {"error": "Acción no válida (revisa los argumentos; ¿existe la app o la ventana?)"}
    return do_apply(acts)

PROVIDERS["mock"] = call_mock

def do_handoff(req):
    msgs = req.get("messages") or []
    md = "Conversación desde el panel de hyprfrijol:\n\n" + transcript(msgs)
    ctx = redact(gather(req.get("context") or {}))[0]
    if ctx:
        md += "\n\n---\n" + ctx
    subprocess.run(["wl-copy"], input=md, text=True)
    desktop = shutil.which("claude-desktop") or shutil.which("claude-desktop-bin")
    if desktop:
        subprocess.Popen([desktop], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return {"target": "desktop", "text": "Abierta en Claude Desktop", "sub": "La conversación está en el portapapeles: pégala con Ctrl+V"}
    if shutil.which("claude"):
        term = settings().get("terminal") or "kitty"
        subprocess.Popen([term, "-e", "claude", md], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return {"target": "code", "text": "Abierta en Claude Code", "sub": "Se envió la conversación y el contexto que elegiste"}
    return {"target": "clipboard", "text": "Copiada al portapapeles", "sub": "No encontré Claude Desktop ni Claude Code"}

def status():
    s = settings()
    prov = s.get("aiProvider") or "claude-code"
    ok, hint = True, ""
    if prov == "claude-code":
        ok = bool(shutil.which("claude"))
        hint = "" if ok else "Falta el comando claude"
    elif prov == "gemini":
        ok = bool(gemini_key()[0])
        hint = "" if ok else "Falta la clave"
    elif prov == "off":
        ok, hint = False, "Desactivado"
    model = gemini_model(s) if prov == "gemini" else (s.get("aiModel") or "")
    return {"provider": prov, "model": model, "available": ok, "hint": hint,
            "desktop": bool(shutil.which("claude-desktop") or shutil.which("claude-desktop-bin")), "voiceLocal": piper_ready()}

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return
    cmd, rest = argv[0], argv[1:]
    arg = rest[0] if rest else ""
    if arg == "-" and cmd != "attach":
        arg = sys.stdin.read()
    if cmd == "chat":
        pr = "--print-request" in rest or "--dry-run" in rest
        rest = [r for r in rest if r not in ("--print-request", "--dry-run")]
        arg = rest[0] if rest else ""
        if arg == "-":
            arg = sys.stdin.read()
        req = json.loads(arg or "{}")
        if req.get("stream") and not pr:
            global LIVE
            LIVE = Live()
            try:
                out = do_chat(req)
            except Exception as e:   # que el panel reciba siempre su línea final
                out = {"text": "", "actions": [], "labels": [], "code": "", "error": f"hf-ai falló: {e}"[:300]}
            LIVE.emit({"final": out}); return
        out = do_chat(req, print_request=pr)
        if pr:
            print(json.dumps(out, ensure_ascii=False, indent=2)); return
    elif cmd == "ask":
        out = do_chat({"messages": [{"role": "user", "text": " ".join(rest)}], "context": {"window": False, "clipboard": False}})
        print(out.get("error") or out["text"])
        if out.get("labels"):
            print("\nCambios propuestos: " + " · ".join(out["labels"]))
        return
    elif cmd == "apply":
        out = do_apply(json.loads(arg))
    elif cmd == "log":                      # registro de acciones (lo que aún se puede deshacer), lo más nuevo arriba
        out = []
        for f in sorted(UNDO.glob("*.json"), reverse=True):
            rec = load(f, {}) or {}
            out.append({"id": f.stem, "time": time.strftime("%d/%m %H:%M", time.localtime(f.stat().st_mtime)),
                        "labels": [label(a) for a in rec.get("actions") or []]})
    elif cmd == "selftest":
        _selftest_redact()
        out = {"ok": True}
    elif cmd == "undo":
        out = do_undo(arg)
    elif cmd == "labels":
        acts = validate(json.loads(arg))
        out = {"labels": [label(a) for a in acts], "plan": [meta(a) for a in acts],
               "auto": bool(acts) and all(meta(a)["kind"] in set(settings().get("aiAlwaysApprove") or []) and not meta(a)["confirm"] for a in acts)}
    elif cmd == "query":
        q = json.loads(arg) if arg.strip().startswith("{") else {"type": arg, **({"query": rest[1], "filter": rest[1]} if len(rest) > 1 else {})}
        lab, res = run_query(q, {"window": True})
        out = {"label": lab, "result": res}
    elif cmd == "tool":
        out = tool_call(arg, json.loads(rest[1]) if len(rest) > 1 else {})
    elif cmd == "tools":
        out = [{"name": n, "description": d, "kind": k, "approval": k == "action"} for n, d, _, k, _ in TOOL_SPECS]
    elif cmd == "summon":
        out = do_summon()
    elif cmd == "approvals":
        # hf-ai approvals → [{kind, label}] de lo «aprobado siempre» (aiAlwaysApprove; lo revoca Ajustes › IA)
        out = [{"kind": k, "label": kind_label(k)} for k in (settings().get("aiAlwaysApprove") or [])]
    elif cmd == "timers":
        out = timers_list()
    elif cmd == "timer":
        # hf-ai timer start <min> [etiqueta…] · hf-ai timer cancel <id|all>
        if arg == "start" and len(rest) > 1:
            try:
                mins = float(rest[1].replace(",", "."))
            except ValueError:
                raise SystemExit("minutos no válidos: " + rest[1])
            if not 0 < mins <= 24 * 60:
                raise SystemExit("minutos fuera de rango (0–1440)")
            out = {"id": timer_start(mins, " ".join(rest[2:]).strip()[:60]), "timers": timers_list()}
        elif arg == "cancel" and len(rest) > 1:
            timer_cancel(rest[1]); out = {"timers": timers_list()}
        else:
            raise SystemExit("uso: hf-ai timer start <min> [etiqueta] | hf-ai timer cancel <id|all>")
    elif cmd == "handoff":
        out = do_handoff(json.loads(arg or "{}"))
    elif cmd == "attach":
        # hf-ai attach clipboard | pick | - (base64 por stdin) | <ruta | file://… | https://…> [más…]
        out = {"images": [], "error": None}
        for src in (rest or ["clipboard"]):
            r = do_attach(src)
            out["images"] += [p for p in r["images"] if p not in out["images"]]
            out.setdefault("files", [])
            out["files"] += [p for p in r.get("files", []) if p not in out["files"]]
            out["error"] = out["error"] or r["error"]
        if out["images"] or out.get("files"):
            out["error"] = None
    elif cmd == "capture":
        out = {"text": capture_text(arg or None)}
    elif cmd == "status":
        out = status()
    elif cmd == "mcp":
        # hf-ai mcp list | check <id> | call <id> <herramienta> '<json>'
        if arg == "check" and len(rest) > 1:
            out = mcp_check(rest[1])
        elif arg == "call" and len(rest) > 2:
            try:
                r = mcp_call(rest[1], rest[2], json.loads(rest[3]) if len(rest) > 3 else {})
                out = {"ok": not r.get("isError"), "text": mcp_result_text(r)}
            except (McpError, ValueError) as e:
                out = {"ok": False, "error": str(e)}
        else:
            s = settings()
            cache = mcp_cache()
            out = {"localOnly": local_only(s), "servers": [
                {**{k: x.get(k) for k in ("id", "name", "command", "url", "authEnv", "enabled", "autoRead")},
                 "tools": [{k: t[k] for k in ("name", "title", "description", "readOnly")} for t in mcp_entry(x, cache).get("tools") or []],
                 "checked": mcp_entry(x, cache).get("checked"), "error": mcp_entry(x, cache).get("error"),
                 "urlProblem": mcp_url_problem(x["url"]) if x.get("url") else None}
                for x in mcp_servers(dict(s, aiLocalOnly=False), enabled_only=False)]}
    elif cmd == "models":
        prov = arg or provider_for(settings())[0]      # el que responde de verdad (en modo local, Ollama)
        out = models_for(prov)
    elif cmd == "test":
        out = test_provider()
    elif cmd == "transform":
        # hf-ai transform "<instrucción>" < texto  → texto transformado en plano (lo usa hf-dictate)
        text = sys.stdin.read()
        try:
            print(transform_text(" ".join(rest), text) or text.strip())
        except AIError as e:
            print(text.strip()); print(str(e), file=sys.stderr); sys.exit(1)
        return
    elif cmd == "recipes":
        out = recipes()
    elif cmd == "recipe":
        out = run_recipe(arg)
    elif cmd == "recipe-save":
        out = recipe_save(json.loads(arg))
    elif cmd == "recipe-remove":
        out = recipe_remove(arg)
    elif cmd == "talk":                     # Super + Alt + H: hablar con el asistente (empieza / termina)
        run(QS + ["ipc", "call", "dictado", "talk"]); return
    elif cmd == "speak":
        if arg == "--stop":
            speak_stop(); out = {"ok": True, "error": ""}
        else:
            out = speak(arg)
    elif cmd == "announce":
        out = greet() if arg == "--greet" else announce(arg)
    elif cmd == "voice-install":
        sys.exit(voice_install(tty="--tty" in rest))
    elif cmd == "key":
        sub, prov = (rest + ["", ""])[:2]
        prov = prov or "gemini"
        if sub == "set":
            k = os.environ.get("HF_AI_KEY_IN") or ("" if sys.stdin.isatty() else sys.stdin.read())
            out = key_set(prov, k)
        elif sub == "clear":
            out = key_clear(prov)
        else:
            out = key_status(prov)
    else:
        print(f"Orden desconocida: {cmd}", file=sys.stderr); sys.exit(1)
    print(json.dumps(out, ensure_ascii=False))

if __name__ == "__main__":
    main(sys.argv[1:])
