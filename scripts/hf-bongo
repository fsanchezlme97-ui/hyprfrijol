#!/usr/bin/env python3
# hf-bongo — escucha el teclado para el gato bongo de la barra (config/quickshell/bar/BongoChip.qml).
# Privacidad: nunca dice QUÉ tecla se pulsa, solo con qué mano tocaría el gato:
#   L   tecla de la mitad izquierda del teclado      R   de la mitad derecha
#   (espacio y teclas sin lado: alternando)
#   noperm   no se puede leer el teclado (hay que estar en el grupo «input»; vale tras volver a entrar)
#   nokbd    no hay ningún teclado conectado (se sigue buscando)
# Lee /dev/input/event* (solo los que tienen letras), sin dependencias. Se adapta a teclados que se conectan
# o desconectan. Se cierra solo cuando el shell deja de escucharlo.
import glob
import os
import select
import struct
import sys
import time

EV_KEY = 1
FMT = "llHHi"   # struct input_event (timeval, type, code, value)
SZ = struct.calcsize(FMT)
# Teclas de la mitad izquierda (códigos de linux/input-event-codes.h)
LEFT = {1, 2, 3, 4, 5, 6, 15, 16, 17, 18, 19, 20, 29, 30, 31, 32, 33, 34, 41, 42, 44, 45, 46, 47, 48, 56, 58,
        59, 60, 61, 62, 63, 64, 86, 125}
SIDELESS = {57}   # espacio


def is_keyboard(ev: str) -> bool:
    try:
        with open(f"/sys/class/input/{ev}/device/capabilities/key") as f:
            words = f.read().split()
    except OSError:
        return False
    bits = int("".join(w.zfill(16) for w in words) or "0", 16)
    return all(bits >> k & 1 for k in (30, 44, 57))   # A, Z y espacio: un teclado de verdad


def say(s: str) -> None:
    try:
        sys.stdout.write(s + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        sys.exit(0)


def main() -> None:
    fds: dict[int, str] = {}
    last_scan = 0.0
    told = ""
    alt = False
    while True:
        now = time.monotonic()
        if now - last_scan > 8 or not fds:
            last_scan = now
            denied = found = 0
            for path in sorted(glob.glob("/dev/input/event*")):
                if path in fds.values() or not is_keyboard(os.path.basename(path)):
                    continue
                found += 1
                try:
                    fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
                except PermissionError:
                    denied += 1
                except OSError:
                    pass
            state = "" if fds else "noperm" if denied else "nokbd" if not found else ""
            if state and state != told:
                say(state)
            told = state
            if not fds:
                time.sleep(5 if state == "nokbd" else 30)
                continue
        try:
            ready, _, _ = select.select(list(fds), [], [], 8)
        except InterruptedError:
            continue
        for fd in ready:
            try:
                data = os.read(fd, SZ * 64)
            except BlockingIOError:
                continue
            except OSError:   # teclado desconectado
                os.close(fd)
                fds.pop(fd, None)
                continue
            for i in range(0, len(data) - SZ + 1, SZ):
                _, _, typ, code, value = struct.unpack_from(FMT, data, i)
                if typ != EV_KEY or value != 1 or code >= 0x100:   # solo pulsaciones de teclas (no repetición ni ratón)
                    continue
                if code in SIDELESS:
                    alt = not alt
                    say("L" if alt else "R")
                else:
                    say("L" if code in LEFT else "R")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
