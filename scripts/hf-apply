                  ("layersIn", 2.4, "hlSuave", "fade"), ("layersOut", 1.8, "hlSuave", "fade")],
        "shell": {"dur": 200, "durIn": 240, "durOut": 160, "ease": [0.25, 0.1, 0.25, 1, 1, 1],
                  "easeIn": [0.25, 0.1, 0.25, 1, 1, 1], "easeOut": [0.25, 0.1, 0.25, 1, 1, 1]},
    },
}

def motion_preset(s):
    """(preset, multiplicador de velocidad). «ninguno» si las animaciones están apagadas o se reduce el movimiento."""
    p = s.get("animPreset", "fluido")
    if p not in MOTION:
        p = "fluido" if p != "ninguno" else "ninguno"
    if s.get("animado", True) is False or s.get("reduceMotion"):
        p = "ninguno"
    try:
        k = max(0.4, min(2.5, float(s.get("animSpeed", 1.0))))
    except Exception:
        k = 1.0
    return p, k

def motion_shell(s, estilo):
    p, k = motion_preset(s)
    if p == "ninguno":
        return {"preset": p, "speed": k, "dur": 0, "durIn": 0, "durOut": 0}
    m = dict(MOTION[p]["shell"])
    for key in ("dur", "durIn", "durOut"):
        m[key] = round(m[key] / k)
    if m.get("easeIn") is None:   # «equilibrado»: SkySoul con rebote, el resto «emphasized»
        m["easeIn"] = [0.34, 1.36, 0.64, 1, 1, 1] if estilo == "skysoul" else m["ease"]
    m.update(preset=p, speed=k)
    return m

def motion_lua(s):
    p, k = motion_preset(s)
    if p == "ninguno":
        return []
    d = MOTION[p]
    out = ["-- movimiento: " + p + (" ×%g" % k if k != 1 else "")]
    for name, (x1, y1, x2, y2) in d["curves"].items():
        out.append('hl.curve("%s", { type = "bezier", points = { {%g, %g}, {%g, %g} } })' % (name, x1, y1, x2, y2))
    for a in d["anims"]:
        leaf, speed, curve, style = a[:4]
        on = a[4] if len(a) > 4 else True
        sp = max(0.5, round(speed / k, 2))
        st = (', style = "%s"' % style) if style else ""
        out.append('hl.animation({ leaf = "%s", enabled = %s, speed = %g, bezier = "%s"%s })'
                   % (leaf, "true" if on else "false", sp, curve, st))
    return out

def style_tokens(c, s):
    """Tokens de estilo (los del diseño, objeto S):
      flat    «Material»: superficies tonales sólidas teñidas por el color de acento (Material 3 / Android),
              sin bordes, elevación por tono, controles rectos con esquinas pequeñas
      skysoul la estructura de Material hecha de cristal: muy transparente sobre un desenfoque muy amplio,
              esmerilado más claro arriba, resplandor del acento y borde de dos trazos (Glass.qml)
      chroma  Nothing Phone: negro puro, gris carbón, letra de puntos, lo activo en blanco y el rojo de acento
      tonal   (solo con «Reducir transparencia» o «Alto contraste») superficies tonales con borde fino
    card/cardBorder: tarjetas de la app de Ajustes · shBlur/shY/shBigBlur/shBigY/shSpread: sombra de los paneles.
    winSolid: fondo de las ventanas grandes (Ajustes, Centro de aplicaciones): en SkySoul más opaco que «win»
    para que lo de detrás (widgets, ventanas) no se transparente; en los demás estilos es sólido.
    Radios: barRad/panelRad/winRad/ctlRad en px; roundK multiplica los radios fijos de los módulos (Theme.r)."""
    LT = bool(c.get("light"))
    estilo = norm_style(s.get("estilo", "flat"))
    high = bool(s.get("highContrast"))
    if estilo == "skysoul" and (s.get("reduceTransparency") or high):
        estilo = "tonal"
    W, K = "#FFFFFF", "#000000"
    none = argb(W, 0)
    if estilo == "skysoul":
        # SkySoul: la estructura y el orden de Material, pero de cristal. Muy transparente sobre un desenfoque muy
        # amplio (10-look.py), con un esmerilado más claro arriba (sheen), un resplandor suave entre el acento y
        # el terciario que se desliza despacio (tint), y un borde de dos trazos: filo exterior oscuro casi
        # invisible (edge) + filo interior de luz brillante arriba (rimTop → border → rimBottom). Los rellenos
        # (bg2) son capas de cristal más claras; lo elegido en los segmentos, una cápsula sólida en contraste.
        base = mix(c["s1"], W, .55) if LT else mix(c["s1"], c["p"], .04)
        S = dict(
            estilo="skysoul", blur=True, pill=False,
            # la barra algo más velada: está siempre sobre el fondo y su texto tiene que leerse en cualquiera
            # en claro, el cristal blanco necesita algo más de cuerpo: sobre zonas oscuras del fondo se volvía gris
            bg=argb(base, .68 if LT else .50), bgPanel=argb(base, .60 if LT else .34),
            bgPopup=argb(base, .70 if LT else .44), bg2=argb(W, .50 if LT else .075),
            border=argb(W, .22 if LT else .06), borderWidth=1,
            highlight=none, glow=none,
            rimTop=argb(W, .55 if LT else .10), rimBottom=argb(W, 0),
            edge=none,   # sin filo oscuro: sobre fondos claros o de colores se leía como un contorno
            sheen=argb(W, .32 if LT else .055), tint=argb(mix(c["p"], c["ter"], .4), .16 if LT else .10),
            tint2=none, tint3=none, rimInner=none,
            # sombras muy tenues: el cristal es translúcido y la sombra se transparentaba como una franja oscura
            # en el borde (y por encima de 0,2 Hyprland la desenfocaba con él)
            shadow=argb(K, .05 if LT else .12), shadowBig=argb(K, .08 if LT else .18),
            win=argb(base, .66 if LT else .48), winBorder=argb(W, .5 if LT else .10),
            winSolid=argb(mix(c["s1"], W, .4) if LT else c["s1"], .62 if LT else .46),
            card=argb(W, .38 if LT else .05), cardBorder=1,
            shBlur=40, shY=14, shBigBlur=70, shBigY=26, shSpread=0)
    elif estilo == "tonal":
        S = dict(
            estilo="tonal", blur=False, pill=False,
            bg=argb(c["s3"], 1), bgPanel=argb(c["s3"], 1), bgPopup=argb(c["s3"], 1), bg2=argb(c["s4"], 1),
            border=argb(c["ov"], 1), borderWidth=1, highlight=none, glow=none,
            rimTop=none, rimBottom=none, sheen=none, tint=none, tint2=none,
            shadow=argb(K, .2), shadowBig=argb(K, .35),
            win=argb(c["s1"], 1), winSolid=argb(c["s1"], 1), winBorder=argb(c["ov"], 1))
    elif estilo == "chroma":
        # Chroma (Nothing OS): negro puro, paneles casi negros con un trazo de 1 px apenas visible, mosaicos y
        # tarjetas gris carbón, títulos con letra de puntos, etiquetas monoespaciadas, lo activo en blanco y el
        # rojo para lo importante; los deslizadores llevan la pista de puntos (SliderBar.qml)
        S = dict(
            estilo="chroma", blur=False, pill=False,
            bg=argb(c["s1"], 1), bgPanel=argb(c["s1"], 1), bgPopup=argb(c["s1"], 1),
            bg2=argb(c["s3"], 1),
            border=argb(c["ov"], 1), borderWidth=1,
            highlight=none, glow=none, sheen=none, tint=none, tint2=none, tint3=none,
            rimTop=none, rimBottom=none,
            accent2=argb(c["ter"], 1),
            shadow=argb(K, .14 if LT else .5), shadowBig=argb(K, .22 if LT else .6),
            win=argb(c["bg"], 1), winSolid=argb(c["bg"], 1), winBorder=argb(c["ov"], 1),
            card=argb(mix(c["s1"], c["s3"], .55), 1), cardBorder=0,
            shBlur=24, shY=8, shBigBlur=48, shBigY=16, shSpread=-2)
    else:
        # Material 3: superficies con un ligero tinte del color primario y niveles de contenedor por tono
        # La barra, los paneles (centro de control, notificaciones, OSD, Spotlight…) y las ventanas del shell usan
        # la misma superficie: antes los paneles iban en s3 y se veían de otro color que la barra. Lo que va
        # dentro (mosaicos, campos, tarjetas) se separa con bg2/s3.
        sur = mix(c["s1"], c["p"], .05 if LT else .04)
        S = dict(
            estilo="flat", blur=False, pill=False,
            bg=argb(sur, 1), bgPanel=argb(sur, 1), bgPopup=argb(sur, 1),
            bg2=argb(mix(mix(c["s3"], c["s4"], .5), c["p"], .08), 1),
            border=argb(c["ov"], .5), borderWidth=0, highlight=none, glow=none,
            rimTop=none, rimBottom=none, sheen=none, tint=none, tint2=none,
            shadow=argb(K, .12 if LT else .30), shadowBig=argb(K, .20 if LT else .45),
            win=argb(sur, 1), winSolid=argb(sur, 1), winBorder=argb(c["ov"], 1))
    S.update(GEOMETRY)
    # Sombras de los paneles del shell (Glass): radio/desplazamiento del estilo y «Sombras» de Apariencia
    base_sh = {"flat": (14, 3, 52, 18, -2), "tonal": (20, 6, 48, 16, 0)}.get(estilo)
    if base_sh:
        S.update(shBlur=base_sh[0], shY=base_sh[1], shBigBlur=base_sh[2], shBigY=base_sh[3], shSpread=base_sh[4])
    sk = SHADOWS.get(s.get("shadows", "suaves"), SHADOWS["suaves"])
    for key in ("shadow", "shadowBig"):
        a = int(S[key][1:3], 16) / 255
        S[key] = argb("#" + S[key][3:], min(1, a * sk["alpha"]))
    for key in ("shBlur", "shBigBlur"):
        S[key] = round(S[key] * sk["blur"])
    for key in ("shY", "shBigY"):
        S[key] = round(S[key] * sk["y"])
    S["shadows"] = s.get("shadows", "suaves") if s.get("shadows") in SHADOWS else "suaves"
    S.setdefault("tint3", none)
    S.setdefault("rimInner", none)
    S.setdefault("edge", none)
    S.setdefault("card", None)
    if S["card"] is None:
        S["card"] = S["bg2"] if estilo == "skysoul" else argb(c["s3"], 1)
        S["cardBorder"] = 1 if estilo == "skysoul" else 0
    k = ROUNDNESS.get(s.get("roundness", "auto"), 1.0)
    for key in ("barRad", "panelRad", "winRad", "ctlRad"):
        S[key] = max(0, round(S[key] * k))
    S["roundK"] = round(S["roundK"] * k, 3)
    S["pill"] = k >= 2.0
    if high:   # también Material: bordes de verdad en lugar de solo tono
        S["borderWidth"] = max(S["borderWidth"], 1)
        S["border"] = argb(c["o"], 1)
    return S

# ---------- salidas ----------
# Resaltado de la ventana activa (Ajustes › Apariencia › Ventanas): borde de Hyprland.
#   sutil    1 px del acento muy rebajado; las inactivas, casi invisibles (por defecto)
#   color    2 px con degradado acento → terciario
#   brillo   como «sutil» y además un halo del acento alrededor (la sombra de la activa, en config/apply/10-look.py)
#   ninguno  sin borde (las sombras separan las ventanas)
def active_border(c, S, s):
    """(border_size, active_border, inactive_border) ya como valores Lua (cadena o degradado)."""
    mode = s.get("activeBorder", "sutil")
    LT = bool(c.get("light"))
    soft_in = rgba_hypr(c["ov"], .45 if LT else .35)
    if mode == "ninguno":
        return 0, '"%s"' % rgba_hypr(c["p"], 0), '"%s"' % rgba_hypr(c["ov"], 0)
    if mode == "color":
        return 2, '{ colors = { "%s", "%s" }, angle = 45 }' % (rgba_hypr(c["p"], .95), rgba_hypr(c.get("ter", c["p"]), .85)), \
            '"%s"' % rgba_hypr(c["ov"], .7)
    # sutil / brillo: el acento mezclado con el contorno, con poca opacidad (Chroma: gris neutro, el rojo no se
    # gasta en los bordes)
    if S.get("estilo") == "skysoul" and S.get("blur"):
        # SkySoul: un filo de luz casi transparente, como el borde del cristal (una línea de color cortaba)
        W = "#FFFFFF"
        return 1, '"%s"' % rgba_hypr(W, .42 if LT else .10), '"%s"' % rgba_hypr(W, .28 if LT else .05)
    ink = c["o"] if S.get("estilo") == "chroma" else c["p"]
    return 1, '"%s"' % rgba_hypr(mix(ink, c["ov"], .25), .55 if LT else .45), '"%s"' % soft_in

def hypr_lua(c, S, s):
    focus = bool(s.get("_focus"))
    gi, go = (0, 0) if focus else (int(s.get("gapsIn", 4)), int(s.get("gapsOut", 4)))
    anim = motion_preset(s)[0] != "ninguno"
    bsize, act, inact = active_border(c, S, s)
    lines = [
        "-- GENERADO por hf-apply a partir de ~/.config/hyprfrijol/settings.json — no editar",
        "hl.config({",
        "    general = {",
        f"        gaps_in = {gi}, gaps_out = {go}, border_size = {0 if focus else bsize},",
        f'        col = {{ active_border = {act}, inactive_border = {inact} }},',
        "    },",
        "    decoration = {",
        f"        rounding = {0 if focus else S['winRad']},",
        f"        rounding_power = {ROUNDING_POWER.get(s.get('roundingShape', 'auto'), 2.6)},",
        # Desenfoque de Hyprland en todos los estilos (antes solo SkySoul): el fondo oscurecido de la vista general,
        # Energía, la bienvenida… se ve esmerilado como en SkySoul. Con paneles opacos (Material, Chroma) no cambia
        # nada más ni cuesta: solo se desenfoca detrás de lo translúcido. Fuera con «Ahorro» o menos transparencias.
        f"        blur = {{ enabled = {'false' if focus or s.get('blurQuality') == 'ahorro' or s.get('reduceTransparency') else 'true'} }},",
        f"        inactive_opacity = {0.97 if S['blur'] else 1.0},",
        "    },",
        f"    animations = {{ enabled = {'true' if anim else 'false'} }},",
        f'    misc = {{ background_color = "{rgba_hypr(c["bg"])}" }},',
        "})",
    ]
    lines += motion_lua(s)
    # Extensiones: cada archivo config/apply/*.py puede añadir líneas (los usa la app de Ajustes)
    for ext in sorted((ROOT / "config/apply").glob("*.py")) if (ROOT / "config/apply").is_dir() else []:
        ns = {"__file__": str(ext), "__name__": "hf_apply_" + ext.stem.replace("-", "_")}   # 90-files.py usa __file__
        try:
            exec(compile(ext.read_text(), str(ext), "exec"), ns)
            extra = ns.get("hypr_lua", lambda s, c: [])(s, c)
            if extra:
                lines.append(f"-- {ext.name}")
                lines.extend(extra)
        except Exception as e:  # una extensión rota no debe romper el resto
            lines.append(f"-- {ext.name}: error {e!r}")
    return "\n".join(lines) + "\n"

def hyprlock_conf(c):
    return "\n".join([
        "# GENERADO por hf-apply",
        f"$primary = {rgba_hypr(c['p'])}",
        f"$surface = {rgba_hypr(c['s1'])}",
        f"$text = {rgba_hypr(c['t'])}",
        f"$textMuted = {rgba_hypr(c['tv'])}",
        f"$outlineVariant = {rgba_hypr(c['ov'], .4)}",
        f"$fieldBg = {rgba_hypr(c['s1'], .45)}",
        "",
    ])

def hsl_hex(h, s, l):
    import colorsys
    r, g, b = colorsys.hls_to_rgb((h % 360) / 360, l, s)
    return "#%02X%02X%02X" % (round(r * 255), round(g * 255), round(b * 255))

def ansi_colors(c):
    """Los 16 colores ANSI del terminal: los de la paleta (palettes.json "ansi", p. ej. Catppuccin o Nord) o,
    si no los trae (paletas propias, matugen, monocromo, variantes derivadas), unos armónicos con ella:
    rojo/verde/amarillo/azul/magenta/cian con la luminosidad del modo y un toque del color principal."""
    a = c.get("ansi")
    if isinstance(a, list) and len(a) == 16 and all(valid_hex(x) for x in a):
        return [x.upper() for x in a]
    LT = bool(c.get("light"))
    hues = (4, 130, 42, 215, 300, 185)        # rojo verde amarillo azul magenta cian
    norm = [mix(hsl_hex(h, .55, .40 if LT else .70), c["p"], .12) for h in hues]
    bright = [mix(hsl_hex(h, .65, .33 if LT else .78), c["p"], .08) for h in hues]
    if LT:
        return [c["t"]] + norm + [c["o"], c["tv"]] + bright + [mix(c["t"], "#000000", .3)]
    return [c["s4"]] + norm + [c["tv"], c["o"]] + bright + [c["t"]]

def kitty_conf(c, S):
    op = 0.86 if S["blur"] else 1.0
    a = ansi_colors(c)
    return "\n".join([
        "# GENERADO por hf-apply · Ajustes › Apariencia › «Aplicar el tema a las apps» lo incluye en kitty.conf",
        "# (include ~/.local/state/hyprfrijol/kitty-colors.conf) y kitty lo recarga en vivo (SIGUSR1)",
        f"background {c['s1']}", f"foreground {c['t']}",
        f"cursor {c['p']}", f"cursor_text_color {c['onP']}",
        f"selection_background {c['pc']}", f"selection_foreground {c['onPc']}",
        f"url_color {c['p']}",
        f"active_border_color {c['p']}", f"inactive_border_color {c['ov']}", f"bell_border_color {c['ter']}",
        f"active_tab_background {c['p']}", f"active_tab_foreground {c['onP']}",
        f"inactive_tab_background {c['s3']}", f"inactive_tab_foreground {c['tv']}",
        f"tab_bar_background {c['bg']}",
        f"mark1_background {c['p']}", f"mark1_foreground {c['onP']}",
        f"mark2_background {c['ter']}", f"mark2_foreground {c['s1']}",
        *[f"color{i} {a[i]}" for i in range(16)],
        f"background_opacity {op}", "",
    ])

def _css(h, a=1.0):
    r, g, b = hex_rgb(h)
    return "rgba(%d, %d, %d, %s)" % (r, g, b, round(a, 3))

def gtk_css(c, S=None, s=None):
    """Colores de GTK 3/4 y, encima, el material del estilo, para que las apps vayan a juego con la shell:
       SkySoul  ventanas de cristal (Hyprland las desenfoca), capas más claras, bordes de luz muy tenues
       Chroma   negro y carbón, lo activo en blanco, el rojo para los enlaces y avisos, filos de 1 px, títulos Doto
       Material superficies tonales sólidas (lo de siempre)"""
    out = [
        "/* GENERADO por hf-apply · @import url(\"file://%s\"); en ~/.config/gtk-4.0/gtk.css */" % (STATE / "gtk-colors.css"),
        f"@define-color accent_color {c['p']};", f"@define-color accent_bg_color {c['p']};",
        f"@define-color accent_fg_color {c['onP']};", f"@define-color window_bg_color {c['s1']};",
        f"@define-color window_fg_color {c['t']};", f"@define-color view_bg_color {c['s3']};",
        f"@define-color headerbar_bg_color {c['s3']};", f"@define-color card_bg_color {c['s4']};", "",
    ]
    S, s = S or {}, s or {}
    est, LT = S.get("estilo"), bool(c.get("light"))
    if est == "skysoul" and S.get("blur"):
        W = "#FFFFFF"
        win = mix(c["s1"], W, .4) if LT else c["s1"]

        def qcss(a8):   # #AARRGGBB del shell (S) → rgba() de CSS
            a8 = (a8 or "#00000000").lstrip("#")
            return _css("#" + a8[2:], int(a8[:2], 16) / 255)
        # El mismo cristal que los paneles del shell (Glass.qml): poca opacidad sobre el desenfoque de Hyprland,
        # esmerilado más claro arriba (sheen) y un resplandor del acento en una esquina (tint). Antes las apps
        # eran solo un color translúcido y, con el contenido encima (view), el fondo apenas se veía desenfocado.
        sheen, tint = qcss(S.get("sheen")), qcss(S.get("tint"))
        out += [
            "/* SkySoul: cristal */",
            f"@define-color window_bg_color {_css(win, .58 if LT else .40)};",
            f"@define-color view_bg_color {_css(W, .16) if LT else _css(W, .02)};",
            f"@define-color headerbar_bg_color {_css(W, .18 if LT else .025)};",
            "@define-color headerbar_backdrop_color @headerbar_bg_color;",
            f"@define-color headerbar_shade_color {_css(W, .45) if LT else _css(W, .05)};",
            f"@define-color sidebar_bg_color {_css(W, .22 if LT else .035)};",
            "@define-color sidebar_backdrop_color @sidebar_bg_color;",
            f"@define-color sidebar_shade_color {_css(W, .4) if LT else _css(W, .05)};",
            f"@define-color sidebar_border_color {_css(W, .4) if LT else _css(W, .05)};",
            f"@define-color secondary_sidebar_bg_color {_css(W, .16 if LT else .02)};",
            "@define-color secondary_sidebar_backdrop_color @secondary_sidebar_bg_color;",
            f"@define-color card_bg_color {_css(W, .42 if LT else .055)};",
            f"@define-color card_shade_color {_css(W, .5) if LT else _css(W, .06)};",
            f"@define-color thumbnail_bg_color {_css(W, .4 if LT else .06)};",
            f"@define-color popover_bg_color {_css(win, .86 if LT else .80)};",
            f"@define-color dialog_bg_color {_css(win, .86 if LT else .78)};",
            f"@define-color borders {_css(W, .45) if LT else _css(W, .07)};",
            f"@define-color shade_color {_css('#000000', .05 if LT else .18)};",
            "window.background, window.background.csd { background-color: @window_bg_color; "
            f"background-image: radial-gradient(circle at 92% 0%, {tint}, transparent 55%), "
            f"linear-gradient(to bottom, {sheen}, transparent 30%); }}",
            # popovers y diálogos: el mismo cristal, algo más opaco para leer bien
            "popover > contents, dialog-host > dialog.background, window.dialog.background { "
            f"background-image: linear-gradient(to bottom, {sheen}, transparent 40%); }}",
            "headerbar, .top-bar, .bottom-bar, toolbarview > .top-bar headerbar { box-shadow: none; }",
            "separator { background-color: @borders; }",
            "",
        ]
    elif est == "chroma":
        out += [
            "/* Chroma (Nothing): lo activo en blanco, el rojo solo para enlaces y avisos */",
            f"@define-color accent_bg_color {c['t']};", f"@define-color accent_fg_color {c['bg']};",
            f"@define-color accent_color {c['p']};",
            f"@define-color window_bg_color {c['bg']};", f"@define-color view_bg_color {c['bg']};",
            f"@define-color headerbar_bg_color {c['bg']};", "@define-color headerbar_backdrop_color @headerbar_bg_color;",
            f"@define-color headerbar_shade_color {c['ov']};",
            f"@define-color sidebar_bg_color {c['s1']};", "@define-color sidebar_backdrop_color @sidebar_bg_color;",
            f"@define-color sidebar_border_color {c['ov']};",
            f"@define-color secondary_sidebar_bg_color {c['s1']};",
            f"@define-color card_bg_color {c['s1']};", f"@define-color card_shade_color {c['ov']};",
            f"@define-color popover_bg_color {c['s1']};", f"@define-color dialog_bg_color {c['s1']};",
            f"@define-color borders {c['ov']};", f"@define-color destructive_bg_color {c['p']};",
            "@define-color destructive_color @accent_color;",
            ".title-1, .title-2, .title-3, .large-title { font-family: \"Doto\", monospace; font-weight: 800; }",
            ".card, .boxed-list, list.boxed-list { box-shadow: 0 0 0 1px @borders; }",
            "",
        ]
    return "\n".join(out)

def real_home():
    """¿Es HOME el del usuario? Con un HOME de prueba no se recargan apps de la sesión real (kitty, Dolphin…)."""
    try:
        import pwd
        return str(HOME) == pwd.getpwuid(os.getuid()).pw_dir
    except Exception:
        return False

def cmd_set(pairs):
    USER.mkdir(parents=True, exist_ok=True)
    cur = load(SETTINGS, {}) or {}
    for p in pairs:
        k, _, v = p.partition("=")
        try:
            cur[k] = json.loads(v)
        except Exception:
            cur[k] = v
    write_if_changed(SETTINGS, json.dumps(cur, indent=2, ensure_ascii=False) + "\n")

def main(argv):
    if argv[:1] == ["toggle-mode"]:
        # Claro ⇄ oscuro (si estaba en «según la hora», pasa al contrario de lo que se ve ahora)
        s = settings()
        _, c = resolve_palette(s)
        cmd_set(["themeMode=" + ("oscuro" if c.get("light") else "claro")])
        argv = [a for a in argv[1:] if a.startswith("--")]
    if argv[:1] == ["set"]:
        cmd_set([a for a in argv[1:] if not a.startswith("--")])
        argv = [a for a in argv[1:] if a.startswith("--")]
    STATE.mkdir(parents=True, exist_ok=True)
    s = settings()
    key, c = resolve_palette(s)
    c = apply_accent(c, s)
    # Chroma trae su propia paleta (Nothing): la del usuario no se usa con él
    est = norm_style(s.get("estilo", "flat"))
    if est == "chroma":
        c = chroma_colors(c)
    c = fix_contrast(c, bool(s.get("highContrast")))
    if est == "chroma" and not s.get("highContrast"):
        # Su paleta ya está ajustada a mano: el ajuste de contraste aguaba el rojo
        c = chroma_colors(c)
    c["ansi"] = ansi_colors(c)   # 16 colores del terminal (kitty, btop, KDE): los de la paleta o armónicos
    S = style_tokens(c, s)
    theme = {
        "paletteKey": key, "paletteName": c.get("name", key), "light": bool(c.get("light")),
        "colorMode": s.get("colorMode"), "c": {k: v for k, v in c.items() if k not in ("name", "light")},
        "S": S, "font": s.get("fontFamily", "Inter"), "fontScale": float(s.get("fontScale", 1.0)),
        "reduceMotion": bool(s.get("reduceMotion")), "highContrast": bool(s.get("highContrast")),
        "motion": motion_shell(s, S["estilo"]),
    }
    if "--print" in argv:
        print(json.dumps(theme, indent=2)); return
    theme_changed = write_if_changed(STATE / "theme.json", json.dumps(theme, indent=2) + "\n")
    hypr_changed = write_if_changed(STATE / "settings.lua", hypr_lua(c, S, s))
    write_if_changed(STATE / "hyprlock-colors.conf", hyprlock_conf(c))
    kitty_changed = write_if_changed(STATE / "kitty-colors.conf", kitty_conf(c, S))
    write_if_changed(STATE / "gtk-colors.css", gtk_css(c, S, s))
    if "--no-reload" in argv:
        return
    # El login usa tu tema: copia en segundo plano, sin contraseña (solo si /etc/greetd/quickshell/live ya es tuya)
    if theme_changed and real_home() and (ROOT / "scripts/hf-greeter-sync").exists():
        subprocess.Popen([str(ROOT / "scripts/hf-greeter-sync"), "--auto"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    if hypr_changed and os.environ.get("HF_SESSION"):
        subprocess.run(["hyprctl", "reload", "config-only"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # kitty: solo con el HOME de verdad (con un HOME de prueba, p. ej. dev/try.sh, no tocar tus terminales)
    if kitty_changed and real_home():
        subprocess.run(["pkill", "-USR1", "-u", str(os.getuid()), "-x", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main(sys.argv[1:])
