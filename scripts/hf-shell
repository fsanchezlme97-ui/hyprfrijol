#!/usr/bin/env bash
# hf-shell — arranca Quickshell (fondo, barra, paneles) y lo mantiene vivo.
#   hf-shell           arranca el shell si no está, y el vigilante (lo usa autostart.lua)
#   hf-shell restart   lo reinicia (Ctrl + Super + R)
#   hf-shell refresh   lo reinicia solo si su código cambió desde que arrancó (lo llama hf-apply)
#   hf-shell watch     vigilante: si el shell se cae, lo reabre a los pocos segundos. Pasa, por ejemplo,
#                      con monitores que «desconectan» el HDMI al apagarse la pantalla por inactividad.
#                      Si el shell se cae safeModeCrashLimit veces (por defecto 3) en los primeros minutos,
#                      avisa y ofrece el modo seguro (hf-safe offer). Si lleva un rato estable, guarda tus
#                      ajustes como «copia buena» (hf-safe mark-good) para poder volver a ella.
# Un cerrojo por sesión de Hyprland (flock) evita dos shells a la vez; cada sesión anidada lleva el suyo.
set -u
for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
ROOT="${HF_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
SIG="${HYPRLAND_INSTANCE_SIGNATURE:-sin-hyprland}"
RUN="${XDG_RUNTIME_DIR:-/tmp}/hf-shell-$SIG"
LOCK="$RUN.lock"
CMD=(qs -p "$ROOT/config/quickshell")
# para pgrep -xf (expresión regular): la carpeta puede llevar espacios, paréntesis o puntos
CMD_RX="$(printf '%s' "qs -p $ROOT/config/quickshell" | sed 's/[][\.*^$+?(){}|]/\\&/g')"

running() { ! flock -n "$LOCK" true 2>/dev/null; }
# El socket queda como archivo tras cerrar una sesión anidada: hay que preguntar a Hyprland
alive_session() { [ -S "${XDG_RUNTIME_DIR:-/tmp}/hypr/$SIG/.socket.sock" ] && HYPRLAND_INSTANCE_SIGNATURE=$SIG timeout 3 hyprctl version >/dev/null 2>&1; }
# -o: los hijos de qs (web apps…) no heredan el candado; si no, lo retienen tras cerrarse la barra
# Sin páginas enormes transparentes (THP) para el shell: con THP «always» (CachyOS y otras) el montón de Qt/QML se
# infla en bloques de 2 MB (~170 MB de RSS de más). prctl(PR_SET_THP_DISABLE) se hereda y sobrevive a exec, así que
# vale para qs y sus hijos; la línea de órdenes sigue siendo la de qs (mine() la busca). Sin python3, tal cual.
NOTHP=()
command -v python3 >/dev/null && NOTHP=(python3 -Ic 'import ctypes,os,sys
try: ctypes.CDLL(None).prctl(41, 1, 0, 0, 0)
except Exception: pass
os.execvp(sys.argv[1], sys.argv[1:])')
# Marca de arranque: refresh compara con ella si el código del shell cambió después (actualización)
start() { running || { touch "$RUN.started"; rm -f "$RUN.pending"; setsid -f flock -n -o "$LOCK" "${NOTHP[@]}" "${CMD[@]}" >/dev/null 2>&1; }; }

# Solo los Quickshell de ESTA sesión (no los de una sesión de prueba anidada con el mismo repo)
mine() {
  local p
  for p in $(pgrep -xf "$CMD_RX"); do
    tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qx "HYPRLAND_INSTANCE_SIGNATURE=$SIG" && echo "$p"
  done
}

case "${1:-}" in
  restart)
    pids="$(mine)"; [ -n "$pids" ] && kill $pids
    for _ in $(seq 30); do [ -z "$(mine)" ] && ! running && break; sleep 0.1; done
    start
    ;;
  refresh)
    # Tras actualizar (hf-apply): si el código del shell cambió desde que arrancó, reiniciarlo limpio. En la sesión
    # real no hay recarga en caliente (shell.qml: watchFiles solo en las anidadas): cada recarga dejaba memoria sin
    # liberar (~20 MB) y tras decenas el shell iba lento (1,2 GB, medio segundo en abrir un panel). Con la pantalla
    # bloqueada o un panel abierto se espera: el vigilante lo vuelve a intentar cada 2 min.
    [ -e "$RUN.started" ] && [ -z "$(find "$ROOT/config/quickshell" -type f -newer "$RUN.started" -print -quit 2>/dev/null)" ] && exit 0
    p="$(mine | head -n1)"
    [ -n "$p" ] || exit 0
    if [ "$(qs ipc --pid "$p" call lock isLocked 2>/dev/null)" = true ] || [ -n "$(qs ipc --pid "$p" call shell current 2>/dev/null)" ]; then
      touch "$RUN.pending"; exit 0
    fi
    exec "$0" restart
    ;;
  watch)
    exec 9>"$RUN.watch"; flock -n 9 || exit 0          # un solo vigilante por sesión
    # Caídas al arrancar → ofrecer el modo seguro; shell estable → copia buena de los ajustes
    LIMIT="$(jq -r '.safeModeCrashLimit // empty' "$HOME/.config/hyprfrijol/settings.json" 2>/dev/null)"
    case "$LIMIT" in ''|*[!0-9]*) LIMIT=3 ;; esac
    T0=$SECONDS CRASHES=0 OFFERED=0 GOOD=0 UP_SINCE=$SECONDS
    # Sin procesos mientras el shell va bien (antes sleep + flock + timeout + hyprctl cada 3 s, ~115 000 al día):
    # espera con read -t (builtin) y mira el pid de qs con kill -0 y /proc. Solo si qs no está se pregunta a
    # Hyprland (cuando Hyprland se cierra, qs se cierra con él, así que el vigilante también termina).
    # Al cerrarse la sesión con el fondo en vídeo pausado (SIGSTOP, wallpaperPauseOn), mpvpaper no se entera de que
    # Wayland se ha ido y se queda parado para siempre: se reanuda para que termine solo. Solo el de esta sesión.
    wake_player() {
      local p
      for p in $(cat "${XDG_RUNTIME_DIR:-/tmp}/hf-motion-$SIG/"motion*.pid 2>/dev/null); do
        tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qx "HYPRLAND_INSTANCE_SIGNATURE=$SIG" && kill -CONT "$p" 2>/dev/null
      done
    }
    exec 7<> <(:)
    QP=""
    qs_alive() { local c; [ -n "$QP" ] && kill -0 "$QP" 2>/dev/null && read -r c < "/proc/$QP/comm" 2>/dev/null && [ "$c" = qs ]; }
    while read -rt 3 -u 7 _ || true; do
      if qs_alive; then
        # actualización a medias (pantalla bloqueada o panel abierto): reintentar cada 2 min
        [ -e "$RUN.pending" ] && [ $((SECONDS % 120)) -lt 3 ] && "$0" refresh
        if [ "$GOOD" = 0 ] && [ -z "${HF_TRY:-}" ] && [ $((SECONDS - UP_SINCE)) -ge 90 ]; then   # (no en dev/try.sh: sus ajustes son temporales)
          GOOD=1; "$ROOT/scripts/hf-safe" mark-good >/dev/null 2>&1 &
        fi
        continue
      fi
      QP="$(mine | head -n1)"
      alive_session || { sleep 3; alive_session; } || { wake_player; exit 0; }   # Hyprland ya no está: fin
      if [ -n "$QP" ] || running; then
        if [ "$GOOD" = 0 ] && [ -z "${HF_TRY:-}" ] && [ $((SECONDS - UP_SINCE)) -ge 90 ]; then   # (no en dev/try.sh: sus ajustes son temporales)
          GOOD=1; "$ROOT/scripts/hf-safe" mark-good >/dev/null 2>&1 &
        fi
        continue
      fi
      sleep 2; { running || [ -n "$(mine)" ]; } && continue   # deja terminar un reinicio en curso
      command -v logger >/dev/null && logger -t hf-shell "Quickshell no estaba en marcha: lo reabro"
      if [ $((SECONDS - T0)) -le 300 ]; then CRASHES=$((CRASHES + 1)); fi
      if [ "$LIMIT" -gt 0 ] && [ "$CRASHES" -ge "$LIMIT" ] && [ "$OFFERED" = 0 ]; then
        OFFERED=1
        setsid -f "$ROOT/scripts/hf-safe" offer "El shell (Quickshell) se ha cerrado $CRASHES veces al arrancar." >/dev/null 2>&1
      fi
      start; UP_SINCE=$SECONDS
    done
    ;;
  *)
    [ -n "$(mine)" ] || start
    setsid -f "$0" watch >/dev/null 2>&1
    # Actualizaciones de hyprfrijol (hfUpdateCheck: semanal por defecto); solo en una sesión real
    [ -z "${HF_NESTED:-}" ] && [ -x "$ROOT/scripts/hf-update" ] && setsid -f "$ROOT/scripts/hf-update" auto >/dev/null 2>&1
    ;;
esac
