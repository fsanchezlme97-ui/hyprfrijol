]

def main(argv):
    cmd = argv[0] if argv else ""
    rest = [a for a in argv[1:] if not a.startswith("--")]
    flags = [a for a in argv[1:] if a.startswith("--")]
    def opt(name, d=""):
        for i, a in enumerate(argv):
            if a == name and i + 1 < len(argv):
                return argv[i + 1]
        return d
    if cmd == "parse":
        it = parse(" ".join(rest))
        print(json.dumps({**it, "plan": plan_of(it)}, ensure_ascii=False)); return
    if cmd == "run":
        it = parse(" ".join(rest))
        if "--dry-run" in flags:
            print(json.dumps({**it, "plan": plan_of(it), "ok": True, "dry": True}, ensure_ascii=False)); return
        r = execute(it, no_ai="--no-ai" in flags)
        print(json.dumps({**it, **r}, ensure_ascii=False))
        sys.exit(0 if r.get("ok") else 1)
    if cmd == "youtube":
        svc = opt("--service", "youtube")
        q = " ".join(a for a in rest if a != svc)
        r = play(q, svc if svc in SVC_NAMES else "youtube", dry="--print" in flags)
        if "--print" in flags and svc != "spotify":      # en seco, resuelve igualmente el id (sin abrir nada)
            vid, how = yt_id(q)
            host = "https://music.youtube.com" if svc == "music" else "https://www.youtube.com"
            if vid:
                r.update(id=vid, how=how, url=f"{host}/watch?v={vid}", msg="Reproduciendo en " + SVC_NAMES[svc])
                r["cmd"] = open_url(r["url"], dry=True)
        print(json.dumps(r, ensure_ascii=False)); return
    if cmd == "browser":
        op = rest[0] if rest else ""
        print(json.dumps(browser(op, " ".join(rest[1:]), dry="--print" in flags), ensure_ascii=False)); return
    if cmd == "wake":               # ¿es una orden dentro del dictado? (lo mismo que usa hf-dictate)
        ok, r = wake_split(" ".join(rest))
        print(json.dumps({"wake": ok, "rest": r}, ensure_ascii=False)); return
    if cmd == "intents":
        print(json.dumps(INTENT_DOC, ensure_ascii=False)); return
    if cmd == "test":
        for ph in TESTS:
            it = parse(ph)
            p = plan_of(it)
            print(f"{ph}\n    → {it['intent']}: {it['label']}\n    → {json.dumps(p, ensure_ascii=False)}")
        return
    print(__doc__)
    sys.exit(0 if cmd in ("-h", "--help") else 1)

