#!/usr/bin/env bash
# hf-greeter-sync — copia tu aspecto actual (paleta, estilo, tipografía y fondo) al login de hyprfrijol (greetd).
#
# El login lo ejecuta greetd como el usuario «greeter», que no puede leer tu $HOME; por eso hay que copiarle
# el tema ya resuelto. Lee ~/.local/state/hyprfrijol/theme.json (lo genera hf-apply) y el fondo actual
# (~/.local/state/hyprfrijol/current-wallpaper; de un vídeo saca un fotograma con ffmpeg) y lo deja todo en
# /etc/greetd/quickshell junto con el greeter de esta copia del repo (greeter/quickshell/*.qml, palettes.json).
# Pide permisos una sola vez (pkexec en una sesión gráfica; si no, sudo).
#
#   hf-greeter-sync             sincroniza (los cambios se ven en el próximo inicio de sesión)
#   hf-greeter-sync --dry-run   prepara los archivos en una carpeta temporal y muestra lo que haría
#   hf-greeter-sync --print     solo imprime el greeter.json que generaría
#
# Variables: HF_GREETER_DEST (por defecto /etc/greetd/quickshell) · HF_PRIV (pkexec|sudo|none, fuerza el método)
set -euo pipefail

for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
ROOT="${HF_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
STATE="$HOME/.local/state/hyprfrijol"
DEST="${HF_GREETER_DEST:-/etc/greetd/quickshell}"
SRC="$ROOT/greeter/quickshell"
MAXW=2560

MODE=apply
for a in "$@"; do
  case "$a" in
    --dry-run) MODE=dry ;;
    --print)   MODE=print ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opción desconocida: $a (usa --help)" >&2; exit 1 ;;
  esac
done

say()  { [ "$MODE" = print ] || printf '\033[1;36m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
command -v jq >/dev/null || { warn "Falta jq"; exit 1; }

# ---------- Tema ----------
THEME="$STATE/theme.json"
if [ ! -s "$THEME" ] && [ -x "$ROOT/scripts/hf-apply" ]; then
  "$ROOT/scripts/hf-apply" --no-reload >/dev/null 2>&1 || true
fi
if [ -s "$THEME" ] && jq -e . "$THEME" >/dev/null 2>&1; then
  THEME_JSON="$(jq -c . "$THEME")"
else
  warn "No encuentro $THEME: el login usará su paleta por defecto."
  THEME_JSON=null
fi

# ---------- Fondo ----------
# Origen: el enlace current-wallpaper (o wallpaper-path). Una carpeta de Wallpaper Engine → su preview.
wall_src() {
  local w=""
  [ -e "$STATE/current-wallpaper" ] && w="$(readlink -f "$STATE/current-wallpaper")"
  [ -z "$w" ] && [ -s "$STATE/wallpaper-path" ] && w="$(head -n1 "$STATE/wallpaper-path")"
  if [ -n "$w" ] && [ -d "$w" ]; then
    local p; for p in "$w"/preview.{jpg,jpeg,png,webp,gif}; do [ -f "$p" ] && { w="$p"; break; }; done
    [ -d "$w" ] && w=""
  fi
  [ -n "$w" ] && [ -f "$w" ] && [ -r "$w" ] && printf '%s' "$w"
  return 0
}
is_video() { case "${1,,}" in *.mp4|*.webm|*.mkv|*.mov|*.avi|*.m4v|*.ogv) return 0 ;; esac; return 1; }

WALL="$(wall_src)"
WALL_OK=0
if [ -n "$WALL" ]; then
  if is_video "$WALL"; then command -v ffmpeg >/dev/null && WALL_OK=1
  else WALL_OK=1; fi
fi

# Construye greeter.json: conserva lo que ya hubiera (gameCommand, layouts, scene…) y pone el tema y el fondo
build_json() { # $1 = ruta del fondo en el destino ("" = conservar la que hubiera)
  local base='{}'
  [ -r "$DEST/greeter.json" ] && jq -e 'type == "object"' "$DEST/greeter.json" >/dev/null 2>&1 && base="$(jq -c . "$DEST/greeter.json")"
  jq -n --argjson base "$base" --argjson theme "$THEME_JSON" --arg wall "$1" --arg user "${USER:-$(id -un)}" \
        --arg when "$(date -Iseconds)" '
    $base
    + (if $theme != null then { theme: $theme } else {} end)
    + (if $wall != "" then { wallpaper: $wall } else {} end)
    + { defaultUser: ($base.defaultUser // $user), synced: $when }'
}

if [ "$MODE" = print ]; then
  build_json "$([ "$WALL_OK" = 1 ] && echo "$DEST/wallpaper.jpg")"
  exit 0
fi

if [ "$MODE" = dry ]; then
  STAGE="$(mktemp -d "${TMPDIR:-/tmp}/hf-greeter-sync.XXXXXX")"
else
  STAGE="$(mktemp -d)"; trap 'rm -rf "$STAGE"' EXIT
fi
chmod 755 "$STAGE"

# Fondo → JPEG de como mucho 2560 px de ancho (más ligero de cargar en el login)
WALL_DEST=""
if [ "$WALL_OK" = 1 ]; then
  out="$STAGE/wallpaper.jpg"
  if is_video "$WALL"; then
    ffmpeg -loglevel error -y -ss 1 -i "$WALL" -frames:v 1 -vf "scale='min($MAXW,iw)':-2" -q:v 3 "$out" </dev/null 2>/dev/null \
      || ffmpeg -loglevel error -y -i "$WALL" -frames:v 1 -vf "scale='min($MAXW,iw)':-2" -q:v 3 "$out" </dev/null 2>/dev/null || true
  elif command -v magick >/dev/null; then
    magick "${WALL}[0]" -auto-orient -resize "${MAXW}x>" -strip -quality 90 "$out" 2>/dev/null || true
  elif command -v ffmpeg >/dev/null; then
    ffmpeg -loglevel error -y -i "$WALL" -frames:v 1 -vf "scale='min($MAXW,iw)':-2" -q:v 2 "$out" </dev/null 2>/dev/null || true
  else
    case "${WALL,,}" in *.jpg|*.jpeg) cp "$WALL" "$out" ;; esac
  fi
  if [ -s "$out" ]; then
    chmod 644 "$out"; WALL_DEST="$DEST/wallpaper.jpg"
    say "Fondo: $WALL"
  else
    rm -f "$out"; warn "No pude convertir el fondo ($WALL); se conserva el que tuviera el login."
  fi
else
  say "Sin fondo que copiar (o es un vídeo y falta ffmpeg): se conserva el que tuviera el login."
fi

build_json "$WALL_DEST" > "$STAGE/greeter.json"
for f in "$SRC"/*.qml "$SRC/palettes.json"; do [ -f "$f" ] && install -m644 "$f" "$STAGE/"; done
chmod 644 "$STAGE"/*
[ "$THEME_JSON" != null ] && say "Tema: $(jq -r '"\(.paletteName // .paletteKey // "?") · \(.S.estilo // "aurora") · \(if .light then "claro" else "oscuro" end)"' <<<"$THEME_JSON")"

# Un solo paso con permisos: copia todo lo preparado al destino
cat > "$STAGE/.install.sh" <<EOF
#!/bin/sh
set -e
install -d -m755 '$DEST'
for f in '$STAGE'/*; do install -m644 "\$f" '$DEST/'; done
EOF
chmod 755 "$STAGE/.install.sh"

PRIV="${HF_PRIV:-}"
if [ -z "$PRIV" ]; then
  if [ "$(id -u)" = 0 ] || { [ -d "$DEST" ] && [ -w "$DEST" ]; } || { [ ! -e "$DEST" ] && [ -w "$(dirname "$DEST")" ]; }; then PRIV=none
  elif command -v pkexec >/dev/null && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then PRIV=pkexec
  elif command -v sudo >/dev/null; then PRIV=sudo
  else warn "Necesito permisos de administrador (ni pkexec ni sudo disponibles)"; exit 1; fi
fi
case "$PRIV" in
  none)   CMD=(/bin/sh "$STAGE/.install.sh") ;;
  pkexec) CMD=(pkexec /bin/sh "$STAGE/.install.sh") ;;
  sudo)   CMD=(sudo /bin/sh "$STAGE/.install.sh") ;;
  *) warn "HF_PRIV no válido: $PRIV"; exit 1 ;;
esac

if [ "$MODE" = dry ]; then
  say "[dry-run] Archivos preparados en $STAGE:"
  (cd "$STAGE" && ls -l --time-style=+ -- * | sed 's/^/    /')
  say "[dry-run] Ejecutaría: ${CMD[*]}"
  sed 's/^/    /' "$STAGE/.install.sh"
  exit 0
fi

"${CMD[@]}" || { warn "No se copió nada (permiso denegado o error)."; exit 1; }
say "Login sincronizado en $DEST. Lo verás la próxima vez que se muestre (al cerrar sesión o reiniciar)."
