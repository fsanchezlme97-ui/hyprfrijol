#!/usr/bin/env python3
"""hf-dictate — dictado local (voz a texto) y comandos de voz de hyprfrijol. Graba el micrófono y escribe las palabras
en la ventana con foco mientras hablas (con wtype: lo provisional se corrige con retrocesos al cerrar cada frase; con
ydotool, pegar o portapapeles, cada frase entera en cuanto haces una pausa). El dictado NUNCA usa IA (ni la
limpieza de antes, dictationAI, retirada): el asistente solo recibe las órdenes de voz que hf-voice no entiende.

Motor (dictationEngine; «auto» = Nemotron si está instalado; si no Parakeet; si no whisper.cpp con su modelo; si no Vosk):
  nemotron    NVIDIA Nemotron 3.5 ASR Streaming (NeMo-Speech.cpp, CPU): reconoce mientras hablas, idioma fijo (es-US,
              en-US) o detectado, con puntuación; cierra la frase él solo en las pausas y la escribe entera.
  parakeet    NVIDIA Parakeet TDT v3 (onnx-asr, CPU): español, inglés y 23 idiomas más sin elegir, con puntuación,
              ~0,3 s por frase; texto provisional cada 0,4 s.
  vosk        tiempo real: Vosk reconoce mientras llega el audio (palabra a palabra) y cierra la frase él solo en las
              pausas; cada frase se escribe al momento. Sin puntuación propia: mayúscula y punto por frase.
  whisper.cpp más preciso, por frases: whisper-server residente (se descarga tras dictationKeepLoaded s sin uso; usa
              la GPU si ggml tiene Vulkan/CUDA/ROCm), frases cortadas por la VAD y texto provisional cada ~0,6 s.
  hibrido     palabras de Vosk mientras hablas y whisper corrige la frase entera antes de escribirla.
  faster-whisper (Python, por frases).

  hf-dictate record [--command] [--mode ptt|toggle|continuo] [--hold] [--tts] [--file clip.wav [--simulate-live]]
        graba hasta «stop» (por stdin, SIGUSR1 o `hf-dictate stop`); --command: una orden de voz (hf-voice);
        --hold: no escribe hasta «release» por stdin (modo mantener: las teclas del atajo siguen pulsadas);
        --file: lee el audio de un archivo en lugar del micrófono (pruebas; --simulate-live lo da a tiempo real).
        --tts: empieza con Helpert hablando (conversación): no se cierra por silencio y solo una voz clara y
        sostenida cuenta; entonces emite {"ev":"barge"} (el shell lo calla) y sigue como un turno normal.
        Con HF_DICTATE_AEC=1 graba del micrófono sin eco (hf-dictate aec on) si está cargado.
        stdin admite líneas: stop · cancel · release · hold (teclas del atajo pulsadas: no escribir) · tts on · tts off. Imprime eventos en líneas JSON (los lee modules/dictado):
        {"ev":"rec","kind":"dictado|comando",…} {"ev":"ready"} {"ev":"level","v":0..1,"t":s} {"ev":"speech","on":bool}
        {"ev":"partial","text":…} {"ev":"phrase","text":…,"lat":s,"how":…} {"ev":"cmd","text":…,"label":…}
        {"ev":"cmdresult","ok":…,"msg":…} {"ev":"transcribing"} {"ev":"text","text":…}
        {"ev":"done","how":"escrito|pegado|copiado|comando|ninguna"} {"ev":"error","msg":…,"code":…} {"ev":"cancelled"}
  hf-dictate toggle [--command]  sin el shell: empieza o, si ya graba, para (avisos con notify-send)
  hf-dictate stop | cancel       para la grabación en curso (y transcribe) / la descarta
  hf-dictate aec on|off|status   cancelador de eco de PipeWire (webrtc) para la conversación: micrófono «hf-aec-source»;
                                 lo que suena por «hf-aec-sink» (la voz de Helpert, hf-ai speak) no se oye en él
  hf-dictate status              {engine, bin, server, model, modelOk, models, vosk…, recorder, typer, gpu…}
  hf-dictate warm | unload       carga el modelo en whisper-server / lo descarga ya
  hf-dictate transcribe <wav>    imprime el texto (pruebas)
  hf-dictate output "<texto>"    lo escribe / pega / copia según dictationOutput
  hf-dictate download <modelo>   tiny|base|small|medium|turbo (whisper, Hugging Face) o vosk-model-small-es-0.42 …
                                 (alphacephei.com) → {"ev":"progress","pct":…}; --tty: barra de progreso en la terminal
  hf-dictate install-nemotron [--tty]  motor Nemotron 3.5 (el recomendado): runtime NeMo-Speech.cpp y modelo, verificados
  hf-dictate install-parakeet [--tty]  motor Parakeet v3 (el más rápido y preciso en CPU): venv con onnx-asr y modelo
  hf-dictate install-vosk        (solo si tu distro no trae python-vosk) venv con pip en …/whisper/vosk-venv; lo pides tú
  hf-dictate manage              menú de la terminal para descargar y borrar modelos (Ajustes › Dictado lo abre)
  hf-dictate delete <modelo>
  hf-dictate last                último texto dictado

Ajustes (settings.json): dictationModel tiny|base|small|medium|turbo (base) · dictationLang es+en|es|auto|en|… (es+en: español e inglés) ·
  dictationMode ptt|toggle|continuo · dictationEngine auto|nemotron|parakeet|whisper.cpp|vosk|hibrido|faster-whisper ·
  dictationOutput escribir|pegar|portapapeles · dictationPunct (puntuación y mayúsculas) · dictationLive (texto
  provisional) · dictationPauseMs (silencio que cierra una frase, 700) · dictationSilenceSec (continuo: para tras
  N s callado, 5) · dictationKeepLoaded (s con el modelo cargado, 600) · dictationWake + dictationWakeWord (decir
  «Distro, …» para dar una orden) · dictationVoskModel ·
  dictationPrompt (vocabulario, separado por comas: whisper lo usa al reconocer y todos los motores al corregir) ·
  dictationAiFix nunca|asistente|siempre (corregir nombres con la IA: al hablar con el asistente, o también al dictar) ·
  dictationAiFixSec (tiempo máximo de esa corrección, 3) · dictationMaxSec (120 en ptt/toggle; 600 en continuo)
Modelos: ~/.local/share/hyprfrijol/whisper/ggml-<modelo>.bin · …/whisper/vosk/<modelo>/
Pruebas: HF_DICTATE_OUTPUT=ninguna no escribe nada · HF_VOICE_DRY=1 no ejecuta las órdenes (hf-voice --dry-run) ·
  HF_WHISPER_SERVER / HF_WHISPER_CLI eligen los binarios · HF_DICTATE_DATA cambia la carpeta de modelos.
"""
import array, collections, io, json, math, os, pathlib, queue, shutil, signal, socket, subprocess, sys, tempfile
import threading, time, urllib.request, uuid, wave, zipfile, re
for _k, _v in list(os.environ.items()):   # variables HL_* (hypr-liquid): siguen valiendo
    if _k.startswith("HL_"): os.environ.setdefault("HF_" + _k[3:], _v)

HOME = pathlib.Path.home()
ROOT = pathlib.Path(os.environ.get("HF_ROOT") or pathlib.Path(__file__).resolve().parent.parent)
SETTINGS = HOME / ".config/hyprfrijol/settings.json"
DATA = pathlib.Path(os.environ.get("HF_DICTATE_DATA") or HOME / ".local/share/hyprfrijol/whisper")
STATE = HOME / ".local/state/hyprfrijol"
RUNTIME = pathlib.Path(os.environ.get("HF_DICTATE_RUNTIME") or os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
PIDFILE = RUNTIME / "hf-dictate.pid"
def SRVFILE(model):
    return RUNTIME / f"hf-dictate-server-{model}.json"
def server_states():
    """[(modelo, estado)] de los whisper-server residentes vivos."""
    out = []
    for f in RUNTIME.glob("hf-dictate-server-*.json"):
        st = load(f, {}) or {}
        if st.get("pid") and alive(st["pid"]):
            out.append((st.get("model"), st))
        else:
            f.unlink(missing_ok=True)
    return out
USEDFILE = RUNTIME / "hf-dictate-used"
RATE = 16000
FRAME = 480                       # 30 ms
FRAME_S = FRAME / RATE

MODELS = {   # nombre → (MB aprox., descripción, archivo)
    "tiny": (75, "Muy rápido · menos preciso", "ggml-tiny.bin"),
    "base": (142, "Rápido · bueno para frases cortas", "ggml-base.bin"),
    "small": (466, "Equilibrado · recomendado en español", "ggml-small.bin"),
    "medium": (1500, "Muy preciso · lento sin GPU", "ggml-medium.bin"),
    "turbo": (547, "large-v3-turbo · el más preciso · necesita GPU", "ggml-large-v3-turbo-q5_0.bin"),
}
VOSK_MODELS = {   # alphacephei.com/vosk/models
    "vosk-model-small-es-0.42": (39, "Vosk pequeño en español · parciales al momento"),
    "vosk-model-es-0.42": (1400, "Vosk grande en español · más preciso"),
}
URL = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/{}"
VOSK_URL = "https://alphacephei.com/vosk/models/{}.zip"
CLI_NAMES = ("whisper-cli", "whisper-cpp", "whisper.cpp")
SERVER_NAMES = ("whisper-server", "whisper-cpp-server")

def load(p, d=None):
    try:
        return json.loads(pathlib.Path(p).read_text())
    except Exception:
        return d

def settings():
    s = dict(load(ROOT / "config/defaults/settings.json", {}) or {})
    s.update(load(SETTINGS, {}) or {})
    return s

ORPHAN = {"v": False}
_emit_lock = threading.Lock()

def emit(ev, **kw):
    kw["ev"] = ev
    with _emit_lock:
        try:
            print(json.dumps(kw, ensure_ascii=False), flush=True)
        except (BrokenPipeError, OSError):
            ORPHAN["v"] = True       # quien leía (el shell) ya no está: se descarta la grabación

def notify(title, body="", urgent=False):
    if os.environ.get("HF_DICTATE_QUIET") or not shutil.which("notify-send"):
        return
    subprocess.run(["notify-send", "-a", "Dictado", "-i", "audio-input-microphone"] + (["-u", "critical"] if urgent else []) + [title, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False

def threads():
    return str(max(2, min(8, (os.cpu_count() or 4) // 2)))

# ---------------------------------------------------------------- motores disponibles
def _which(env, names):
    e = os.environ.get(env)
    if e and os.access(e, os.X_OK):
        return e
    for n in names:
        p = shutil.which(n)
        if p:
            return p
    return ""

def whisper_bin():
    return _which("HF_WHISPER_CLI", CLI_NAMES)

def server_bin():
    return _which("HF_WHISPER_SERVER", SERVER_NAMES)

def fw_python():
    """python con faster_whisper (venv propio o el del sistema), o ""."""
    for py in (DATA / "venv/bin/python", pathlib.Path(sys.executable)):
        if py.exists():
            r = subprocess.run([str(py), "-c", "import faster_whisper"], capture_output=True)
            if r.returncode == 0:
                return str(py)
    return ""

def vosk_here():
    try:
        import importlib.util
        return importlib.util.find_spec("vosk") is not None
    except Exception:
        return False

def vosk_venv_python():
    """python del venv de Vosk (hf-dictate install-vosk), si existe y tiene vosk."""
    py = DATA / "vosk-venv/bin/python"
    if py.exists() and subprocess.run([str(py), "-c", "import vosk"], capture_output=True).returncode == 0:
        return str(py)
    return ""

def vosk_ok():
    return vosk_here() or bool(vosk_venv_python())

def install_vosk():
    """Instalación iniciada por el usuario (en la terminal): venv propio con pip install vosk."""
    venv = DATA / "vosk-venv"
    print(f"Se creará un entorno de Python en {venv} y se instalará «vosk» desde PyPI (pip).")
    DATA.mkdir(parents=True, exist_ok=True)
    if subprocess.run([sys.executable, "-m", "venv", str(venv)]).returncode != 0:
        print("No se pudo crear el venv (¿falta python3-venv?)"); return 1
    if subprocess.run([str(venv / "bin/pip"), "install", "--upgrade", "vosk"]).returncode != 0:
        print("pip no pudo instalar vosk"); return 1
    print("Vosk instalado. Falta un modelo en español: hf-dictate download vosk-model-small-es-0.42")
    return 0

# ---- Parakeet (NVIDIA parakeet-tdt-0.6b-v3, int8, con onnx-asr): 25 idiomas europeos (español e inglés juntos, sin
# elegir), puntúa solo y en CPU tarda ~0,3 s por frase (whisper small ~2 s). Va en un entorno de Python propio
# (…/whisper/parakeet-venv) y el modelo en …/whisper/parakeet (~670 MB); lo instala `hf-dictate install-parakeet`.
PARAKEET_MODEL = "nemo-parakeet-tdt-0.6b-v3"
PARAKEET_DIR = DATA / "parakeet"
PARAKEET_VENV = DATA / "parakeet-venv"

def parakeet_python():
    py = PARAKEET_VENV / "bin/python"
    return str(py) if py.exists() else ""

def parakeet_ready():
    return bool(parakeet_python()) and (PARAKEET_DIR / "ok").exists()

PARAKEET_FETCH = ("import os,sys,onnx_asr\nm=onnx_asr.load_model(sys.argv[1],quantization='int8')\n"
                  "print(m.recognize(__import__('numpy').zeros(16000,dtype='float32')))\n")

def install_parakeet(tty=False):
    """Instalación pedida por el usuario: venv con onnx-asr (uv si está; si no, venv + pip) y descarga del modelo."""
    say = (lambda m: print(m, flush=True)) if tty else (lambda m: emit("progress", msg=m))
    DATA.mkdir(parents=True, exist_ok=True); PARAKEET_DIR.mkdir(parents=True, exist_ok=True)
    say(f"Creando el entorno de Python en {PARAKEET_VENV} (onnx-asr y onnxruntime desde PyPI)…")
    uv = shutil.which("uv")
    if uv:
        ok = subprocess.run([uv, "venv", "-q", "--allow-existing", "--python", "3.12", str(PARAKEET_VENV)]).returncode == 0 and \
             subprocess.run([uv, "pip", "install", "-q", "--python", str(PARAKEET_VENV / "bin/python"), "onnx-asr[cpu,hub]"]).returncode == 0
    else:
        ok = subprocess.run([sys.executable, "-m", "venv", str(PARAKEET_VENV)]).returncode == 0 and \
             subprocess.run([str(PARAKEET_VENV / "bin/pip"), "install", "-q", "onnx-asr[cpu,hub]"]).returncode == 0
    if not ok:
        say("No se pudo crear el entorno (¿falta python-virtualenv o uv?)"); return 1
    say("Descargando el modelo Parakeet v3 (~670 MB)…")
    env = dict(os.environ, HF_HOME=str(PARAKEET_DIR / "hf"))
    r = subprocess.run([parakeet_python(), "-I", "-c", PARAKEET_FETCH, PARAKEET_MODEL], env=env)
    if r.returncode != 0:
        say("No se pudo descargar el modelo"); return 1
    (PARAKEET_DIR / "ok").write_text(PARAKEET_MODEL)
    say("Parakeet listo: el dictado lo usa en «Automático».")
    return 0

# ---- Nemotron 3.5 ASR Streaming (NVIDIA, 0,6B, q8_0) con NeMo-Speech.cpp: reconoce mientras hablas (lo provisional solo
# crece), cierra la frase él solo en las pausas y el idioma se fija (es-US) o lo detecta; Parakeet, sin idioma fijo, se
# pasaba al inglés o al portugués en frases largas o con un micrófono flojo («Confirm the reunion…»). ~25 % del tiempo
# real en CPU. Runtime precompilado (Apache-2.0) y modelo (OpenMDW) fijados por versión y suma: …/whisper/nemotron.
NEMO_VER = "0.3.0"
NEMO_SHA = {"x86_64": "255f12b722ab15b2a38a51cf125d56e3fa97058b528f7e895b39d6a473deb06e",
            "aarch64": "56858eaf50d19b05902c043f65d0057352bdc107ae380c41053bfbddfc204bf1"}
NEMO_URL = "https://github.com/NVIDIA/NeMo-Speech.cpp/releases/download/v{v}/nemo-speech-{v}-linux-{a}-cpu.tar.gz"
NEMOTRON_URL = ("https://huggingface.co/nvidia/nemotron-3.5-asr-streaming-0.6b/resolve/"
                "ea30d66debe3740a08b573244286791d423d6b3e/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf")
NEMOTRON_SHA = "3fc991d3badad7277c11030a7519832cddaf2057aafed6d4b25147e953a070b1"
NEMOTRON_DIR = DATA / "nemotron"
NEMOTRON_GGUF = NEMOTRON_DIR / "nemotron-3.5-asr-streaming-0.6b.q8_0.gguf"

def nemotron_lib():
    return NEMOTRON_DIR / f"nemo-speech-{NEMO_VER}-linux-{os.uname().machine}-cpu/lib/libnemo_speech_asr_c.so"

def nemotron_ready():
    return (NEMOTRON_DIR / "ok").exists() and nemotron_lib().exists() and NEMOTRON_GGUF.exists()

def _sha256(p):
    import hashlib
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()

def install_nemotron(tty=False):
    """Instalación pedida por el usuario: runtime de NeMo-Speech.cpp (~10 MB) y modelo (~740 MB), ambos verificados."""
    import tarfile
    say = (lambda m: print(m, flush=True)) if tty else (lambda m: emit("progress", msg=m))
    arch = os.uname().machine
    if arch not in NEMO_SHA:
        say(f"Nemotron no tiene runtime para {arch}"); return 1
    try:
        NEMOTRON_DIR.mkdir(parents=True, exist_ok=True)
        (NEMOTRON_DIR / "ok").unlink(missing_ok=True)
        say(f"Descargando NeMo-Speech.cpp {NEMO_VER} (NVIDIA, ~10 MB)…")
        tgz = NEMOTRON_DIR / "runtime.tar.gz"
        _fetch(NEMO_URL.format(v=NEMO_VER, a=arch), tgz, "nemo-speech", tty, 10)
        if _sha256(tgz) != NEMO_SHA[arch]:
            tgz.unlink(missing_ok=True); raise RuntimeError("el runtime descargado no coincide con su suma")
        with tarfile.open(tgz) as t:
            try:
                t.extractall(NEMOTRON_DIR, filter="data")   # «data»: nada fuera de la carpeta ni enlaces raros
            except TypeError:                               # Python < 3.11.4 (Debian 12): la misma regla a mano
                for m in t.getmembers():
                    p = pathlib.PurePosixPath(m.name)
                    if p.is_absolute() or ".." in p.parts or m.isdev() or \
                            (m.issym() or m.islnk()) and (m.linkname.startswith("/") or ".." in m.linkname):
                        raise RuntimeError(f"ruta no válida en el runtime: {m.name}")
                t.extractall(NEMOTRON_DIR)
        tgz.unlink(missing_ok=True)
        if not (NEMOTRON_GGUF.exists() and _sha256(NEMOTRON_GGUF) == NEMOTRON_SHA):
            say("Descargando el modelo Nemotron 3.5 ASR (~740 MB)…")
            _fetch(NEMOTRON_URL, NEMOTRON_GGUF, "nemotron", tty, 742)
            if _sha256(NEMOTRON_GGUF) != NEMOTRON_SHA:
                NEMOTRON_GGUF.unlink(missing_ok=True); raise RuntimeError("el modelo descargado no coincide con su suma")
        eng = NemotronEngine({}); eng.start(); eng.close()
    except Exception as e:
        say(f"No se pudo instalar Nemotron: {e}"); return 1
    (NEMOTRON_DIR / "ok").write_text(NEMO_VER)
    say("Nemotron listo: el dictado lo usa en «Automático».")
    return 0

def model_path(name):
    return DATA / MODELS.get(name, (0, "", f"ggml-{name}.bin"))[2]

def vosk_path(name):
    return DATA / "vosk" / name

def model_installed(name):
    p = model_path(name)
    return p.exists() and p.stat().st_size > MODELS.get(name, (1,))[0] * 1e6 * 0.8

def vosk_installed(name):
    return (vosk_path(name) / "am").is_dir() or (vosk_path(name) / "conf").is_dir()

def gpu_backends():
    """Backends de GPU de ggml instalados (whisper.cpp los carga solo)."""
    out = []
    for d in ("/usr/lib/ggml", "/usr/lib64/ggml", "/usr/local/lib/ggml", "/usr/lib/x86_64-linux-gnu/ggml", "/usr/lib", "/usr/lib64"):
        for n, lab in (("vulkan", "Vulkan"), ("cuda", "CUDA"), ("hip", "ROCm"), ("sycl", "SYCL")):
            if (pathlib.Path(d) / f"libggml-{n}.so").exists() and lab not in out:
                out.append(lab)
    return out

def _gpu_sig():
    sig = []
    for d in ("/usr/lib/ggml", "/usr/lib64/ggml", "/usr/local/lib/ggml", "/usr/lib", "/usr/lib64"):
        for n in ("libggml-vulkan.so", "libggml-cuda.so", "libggml-hip.so", "libggml.so"):
            f = pathlib.Path(d) / n
            if f.exists():
                sig.append(f"{f}:{int(f.stat().st_mtime)}")
    return "|".join(sig)

def _encode_ms(model, gpu):
    """Tiempo de codificar 2 s de audio con whisper-cli (ms) o None."""
    if not whisper_bin():
        return None
    with tempfile.NamedTemporaryFile(prefix="hf-gpu-", suffix=".wav", delete=False) as f:
        f.write(wav_bytes(bytes(array.array("h", [int(800 * math.sin(i / 7.0)) for i in range(RATE * 2)])))); wav = f.name
    try:
        r = subprocess.run([whisper_bin(), "-m", str(model_path(model)), "-f", wav, "-l", "es", "-nt", "-t", threads(),
                            "-ac", "512"] + ([] if gpu else ["-ng"]), capture_output=True, text=True, timeout=120)
        m = re.search(r"encode time =\s*([\d.]+) ms", r.stderr)
        return float(m.group(1)) if m else None
    except Exception:
        return None
    finally:
        os.unlink(wav)

def use_gpu(model, s=None, measure=True):
    """¿whisper usa la GPU? dictationGpu: auto (por defecto) | si | no. En «auto» se mide una vez por modelo y por versión
    de ggml lo que tarda la GPU frente a la CPU y se usa la más rápida (con algunas GPU y versiones de ggml-vulkan la
    GPU va varias veces más lenta que la CPU). Se guarda en …/whisper/gpu-check.json."""
    s = s or settings()
    want = str(s.get("dictationGpu") or "auto")
    if not gpu_backends() or want == "no":
        return False
    if want == "si":
        return True
    f = DATA / "gpu-check.json"
    data = load(f, {}) or {}
    key = model + "@" + _gpu_sig()
    if key in data:
        return bool(data[key].get("gpu"))
    if not measure or not model_installed(model):
        return True
    g, c = _encode_ms(model, True), _encode_ms(model, False)
    if g is None and c is None:
        return True                     # no se pudo medir: como siempre (whisper elige la GPU)
    ok = g is not None and (c is None or g < c * 0.85)
    data[key] = {"gpu": ok, "gpuMs": g, "cpuMs": c, "t": int(time.time())}
    try:
        DATA.mkdir(parents=True, exist_ok=True); f.write_text(json.dumps(data, indent=1))
    except Exception:
        pass
    return ok

ORDER = ["tiny", "base", "small", "turbo", "medium"]

def live_model(s):
    """Modelo de lo provisional: dictationLiveModel, o «tiny» si el principal es grande (small o más) y está
    descargado y no hay GPU: así lo provisional no retrasa la frase final (va en otro whisper-server)."""
    m = s.get("dictationModel") or "base"
    want = s.get("dictationLiveModel") or "auto"
    if want != "auto":
        return want if model_installed(want) else m
    if ORDER.index(m) >= ORDER.index("small") if m in ORDER else False:
        if not use_gpu(m, s, measure=False):
            for c in ("base", "tiny"):
                if model_installed(c):
                    return c
    return m

def engine(s):
    """motor efectivo: nemotron | parakeet | whisper.cpp | vosk | hibrido | faster-whisper | ""."""
    want = s.get("dictationEngine") or "auto"
    wm = s.get("dictationModel") or "base"
    vm = s.get("dictationVoskModel") or "vosk-model-small-es-0.42"
    has_w = bool(whisper_bin() or server_bin())
    has_v = vosk_ok() and vosk_installed(vm)
    if want in ("nemotron", "auto") and nemotron_ready():
        return "nemotron"         # en streaming y con el idioma fijo: no se pasa al inglés ni reescribe lo escrito
    if want in ("parakeet", "auto") and parakeet_ready():
        return "parakeet"         # el más rápido por frases en CPU (español e inglés sin elegir)
    if want == "hibrido" and has_w and has_v:
        return "hibrido"
    if want == "vosk" and has_v:
        return "vosk"
    # automático: whisper si su modelo está (mucho más preciso, entiende inglés y puntúa; con el contexto de audio a
    # la medida tarda ~1 s por frase en CPU); Vosk solo si no hay modelo de whisper
    if want in ("auto", "whisper.cpp", "hibrido") and has_w and (model_installed(wm) or want != "auto" or not has_v):
        return "whisper.cpp"
    if want in ("auto", "vosk", "hibrido") and has_v:
        return "vosk"
    if want in ("auto", "faster-whisper") and fw_python():
        return "faster-whisper"
    if has_w:
        return "whisper.cpp"
    return ""

def recorder():
    if shutil.which("pw-record"):
        return "pw-record"
    if shutil.which("arecord"):
        return "arecord"
    return ""

def typer():
    if shutil.which("wtype"):
        return "wtype"
    if shutil.which("ydotool"):
        return "ydotool"
    return ""

def family():
    try:
        osr = pathlib.Path("/etc/os-release").read_text().lower()
        return "arch" if "arch" in osr else "debian" if ("debian" in osr or "ubuntu" in osr) else "fedora" if "fedora" in osr else "suse" if "suse" in osr else "arch"
    except Exception:
        return "arch"

def status():
    s = settings()
    m = s.get("dictationModel") or "base"
    vm = s.get("dictationVoskModel") or "vosk-model-small-es-0.42"
    models = []
    for n, (mb, d, f) in MODELS.items():
        p = model_path(n)
        models.append({"name": n, "mb": mb, "desc": d, "file": f, "installed": model_installed(n), "bytes": p.stat().st_size if p.exists() else 0})
    vmodels = [{"name": n, "mb": mb, "desc": d, "installed": vosk_installed(n)} for n, (mb, d) in VOSK_MODELS.items()]
    eng = engine(s)
    model_ok = (model_installed(m) if eng in ("whisper.cpp", "hibrido") else True) and (vosk_installed(vm) if eng in ("vosk", "hibrido") else True) and bool(eng)
    srv = server_states()
    loaded = bool(srv)
    fam = family()
    return {"engine": eng, "bin": whisper_bin(), "server": server_bin(), "fasterWhisper": bool(fw_python()), "vosk": vosk_ok(),
            "model": m, "modelOk": model_ok, "models": models, "voskModel": vm, "voskModels": vmodels, "dir": str(DATA),
            "recorder": recorder(), "typer": typer(), "clipboard": bool(shutil.which("wl-copy")),
            "ready": bool(eng and model_ok and recorder()), "recording": running_pid() > 0, "family": fam,
            "parakeet": parakeet_ready(), "parakeetEnv": bool(parakeet_python()), "nemotron": nemotron_ready(),
            "gpu": gpu_backends(), "gpuUsed": use_gpu(m, s, measure=False), "loaded": loaded, "loadedModels": [m for m, _ in srv], "liveModel": live_model(s),
            "ytdlp": bool(shutil.which("yt-dlp")),
            # paquetes que ofrece instalar Ajustes › Dictado (Arch: todo en los repos oficiales)
            "pkgs": {"engine": "whisper-cpp" if fam == "arch" else "", "gpu": "ggml-vulkan" if fam == "arch" else "",
                     "vosk": "python-vosk" if fam == "arch" else "", "typer": "wtype", "recorder": "pipewire",
                     "ytdlp": "yt-dlp"}}

# ---------------------------------------------------------------- whisper-server residente
def free_port():
    with socket.socket() as so:
        so.bind(("127.0.0.1", 0))
        return so.getsockname()[1]

def http(port, path, data=None, headers=None, timeout=60):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=data, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()

def ping(port):
    try:
        return b"ok" in http(port, "/health", timeout=1.5)
    except Exception:
        return False

def touch_used():
    try:
        USEDFILE.touch()
    except Exception:
        pass

def server_daemon(model, lang, idle):
    """Proceso residente: lanza whisper-server con el modelo y lo cierra tras «idle» s sin uso."""
    port = free_port()
    log = open(RUNTIME / f"hf-dictate-server-{model}.log", "w")
    child = subprocess.Popen([server_bin(), "-m", str(model_path(model)), "-l", lang, "-t", threads(), "--host", "127.0.0.1",
                              "--port", str(port), "-nt", "-sns"] + ([] if use_gpu(model) else ["-ng"]), stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    def bye(*_):
        try:
            child.terminate(); child.wait(3)
        except Exception:
            child.kill()
        st = load(SRVFILE(model), {}) or {}
        if st.get("pid") == os.getpid():
            SRVFILE(model).unlink(missing_ok=True)
        sys.exit(0)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    t0 = time.time()
    while not ping(port):
        if child.poll() is not None or time.time() - t0 > 90:
            bye()
        time.sleep(0.05)
    touch_used()
    SRVFILE(model).write_text(json.dumps({"pid": os.getpid(), "child": child.pid, "port": port, "model": model, "lang": lang,
                                   "loadSec": round(time.time() - t0, 2), "started": time.time()}))
    while True:
        time.sleep(2)
        if child.poll() is not None:
            bye()
        try:
            used = USEDFILE.stat().st_mtime
        except Exception:
            used = t0
        if time.time() - used > idle and not running_pid():
            bye()

def server_stop(model=None, keep=()):
    """Cierra el whisper-server de «model» (o todos, salvo los de «keep»)."""
    for m, st in server_states():
        if (model and m != model) or m in keep:
            continue
        os.kill(st["pid"], signal.SIGTERM)
        for _ in range(40):
            if not alive(st["pid"]):
                break
            time.sleep(0.05)
        SRVFILE(m).unlink(missing_ok=True)

def server_ensure(model, lang, idle):
    """Puerto de un whisper-server con este modelo (lo arranca si hace falta)."""
    st = load(SRVFILE(model), {}) or {}
    if st and alive(st.get("pid", 0)) and st.get("lang") == lang and ping(st.get("port", 0)):
        touch_used()
        return st["port"]
    if st:
        server_stop(model)
    if not server_bin():
        return 0
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "_server", model, lang, str(idle)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True)
    t0 = time.time()
    while time.time() - t0 < 90:
        st = load(SRVFILE(model), {}) or {}
        if st.get("model") == model and alive(st.get("pid", 0)) and ping(st.get("port", 0)):
            return st["port"]
        time.sleep(0.05)
    return 0

def wav_bytes(pcm):
    b = io.BytesIO()
    with wave.open(b, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE); w.writeframes(bytes(pcm))
    return b.getvalue()

def audio_ctx(pcm):
    """Contexto de audio del codificador según lo que dura la frase (whisper procesa siempre 30 s si no: 1500).
    50 posiciones por segundo + margen; frases de unos segundos van 3–4 veces más rápido en CPU sin perder precisión."""
    sec = len(pcm) / 2 / RATE
    if sec >= 24:
        return 0
    return max(512, min(1500, int(math.ceil((sec * 50 * 1.5 + 128) / 64) * 64)))

def langs_of(lang):
    """dictationLang → (idioma con el que se empieza, idiomas permitidos o None). «es+en»: español e inglés."""
    lang = (lang or "es").strip().lower()
    if "+" in lang:
        ls = [x for x in lang.split("+") if x]
        return (ls[0] if ls else "es"), tuple(ls or ["es"])
    return lang, None

def server_infer(port, pcm, lang, prompt="", detail=False, beam=5):
    """Texto de la frase (o {text, lang, prob} con detail). Búsqueda en haz (5; lo provisional, voraz: beam=-1) y
    contexto de audio a la medida."""
    bd = uuid.uuid4().hex
    fields = {"response_format": "verbose_json" if detail else "json", "temperature": "0.0", "language": lang,
              "beam_size": str(beam), "audio_ctx": str(audio_ctx(pcm))}
    if prompt:
        fields["prompt"] = prompt
    body = b"".join(f"--{bd}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode() for k, v in fields.items())
    body += (f"--{bd}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.wav\"\r\nContent-Type: audio/wav\r\n\r\n").encode() \
        + wav_bytes(pcm) + f"\r\n--{bd}--\r\n".encode()
    touch_used()
    r = json.loads(http(port, "/inference", body, {"Content-Type": f"multipart/form-data; boundary={bd}"}, timeout=120))
    touch_used()
    if r.get("error"):
        raise RuntimeError("whisper-server: " + str(r["error"])[:160])
    if detail:
        dl = str(r.get("detected_language") or "").lower()
        return {"text": r.get("text", ""), "lang": WLANG.get(dl, dl[:2]), "prob": float(r.get("detected_language_probability") or 0)}
    return r.get("text", "")

WLANG = {"spanish": "es", "english": "en", "catalan": "ca", "galician": "gl", "basque": "eu", "portuguese": "pt",
         "french": "fr", "italian": "it", "german": "de"}

# ---------------------------------------------------------------- motores (una sesión)
class WhisperEngine:
    """whisper.cpp: whisper-server residente; si falta, whisper-cli por frase (carga el modelo cada vez)."""
    name = "whisper.cpp"
    def __init__(self, s, model=None):
        self.model = model or s.get("dictationModel") or "base"
        # «es+en»: cada frase en el idioma de la anterior; si whisper oye el otro, se repite en ese (solo en el cambio)
        self.lang, self.allowed = langs_of(s.get("dictationLang") or "es+en")
        self.idle = max(30, int(s.get("dictationKeepLoaded") or 600))
        self.port = 0
        if not model_installed(self.model) and not model_path(self.model).exists():
            raise RuntimeError(f"Falta el modelo «{self.model}»: descárgalo en Ajustes › Dictado")
    def start(self):
        if server_bin():
            self.port = server_ensure(self.model, self.lang, self.idle)
    def infer(self, pcm, prompt, final):
        beam = 5 if final else -1
        if not self.allowed:
            return server_infer(self.port, pcm, self.lang, prompt, beam=beam)
        r = server_infer(self.port, pcm, self.lang, prompt, detail=True, beam=beam)
        if r["lang"] in self.allowed and r["lang"] != self.lang and r["prob"] >= (0.5 if final else 0.6):
            # cambió de idioma. Lo provisional ya lo detecta mientras hablas, así la frase final suele salir a la
            # primera en el idioma bueno; si no, se repite en el que oye. Las siguientes siguen en ese.
            self.lang = r["lang"]
            self.switched = True
            if final:
                return server_infer(self.port, pcm, self.lang, prompt, beam=beam)
        return r["text"]
    def transcribe(self, pcm, prompt="", final=True):
        if self.port:
            try:
                return self.infer(pcm, prompt, final)
            except Exception:
                self.port = server_ensure(self.model, self.lang, self.idle)
                if self.port:
                    return self.infer(pcm, prompt, final)
        with tempfile.NamedTemporaryFile(prefix="hf-dictate-", suffix=".wav", delete=False) as f:
            f.write(wav_bytes(pcm)); wav = f.name
        try:
            cmd = [whisper_bin(), "-m", str(model_path(self.model)), "-f", wav, "-l", "auto" if self.allowed else self.lang,
                   "-nt", "-np", "-t", threads(), "-ac", str(audio_ctx(pcm))] + ([] if use_gpu(self.model, measure=False) else ["-ng"])
            if prompt:
                cmd += ["--prompt", prompt]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
            if r.returncode != 0:
                raise RuntimeError("whisper.cpp falló: " + (r.stderr.strip().splitlines() or ["?"])[-1][:160])
            return r.stdout
        finally:
            os.unlink(wav)
    def close(self):
        pass

class FasterWhisperEngine:
    """faster-whisper en un proceso Python residente durante la sesión."""
    name = "faster-whisper"
    CODE = ("import sys,json,io,wave\nfrom faster_whisper import WhisperModel\n"
            "m=WhisperModel(sys.argv[1],device='auto',compute_type='int8',download_root=sys.argv[3])\nprint('{}',flush=True)\n"
            "for l in sys.stdin:\n j=json.loads(l)\n seg,_=m.transcribe(j['wav'],language=None if sys.argv[2]=='auto' else sys.argv[2],"
            "initial_prompt=j.get('prompt') or None)\n print(json.dumps({'text':' '.join(x.text.strip() for x in seg)}),flush=True)\n")
    def __init__(self, s):
        self.model = s.get("dictationModel") or "base"
        l, allowed = langs_of(s.get("dictationLang") or "es+en")
        self.lang = "auto" if allowed else l
        self.p = None
        self.lock = threading.Lock()
    def start(self):
        self.p = subprocess.Popen([fw_python(), "-c", self.CODE, self.model, self.lang, str(DATA / "faster-whisper")],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        self.p.stdout.readline()
    def transcribe(self, pcm, prompt="", final=True):
        with tempfile.NamedTemporaryFile(prefix="hf-dictate-", suffix=".wav", delete=False) as f:
            f.write(wav_bytes(pcm)); wav = f.name
        try:
            with self.lock:
                self.p.stdin.write(json.dumps({"wav": wav, "prompt": prompt}) + "\n"); self.p.stdin.flush()
                return json.loads(self.p.stdout.readline() or "{}").get("text", "")
        finally:
            os.unlink(wav)
    def close(self):
        if self.p:
            self.p.kill()

class ParakeetEngine:
    """Parakeet v3 (onnx-asr) en un proceso Python residente durante la sesión: ~0,3 s por frase en CPU."""
    name = "parakeet"
    CODE = ("import sys,json,wave,numpy as np,onnx_asr\n"
            "m=onnx_asr.load_model(sys.argv[1],quantization='int8')\nprint('{}',flush=True)\n"
            "for l in sys.stdin:\n j=json.loads(l)\n w=wave.open(j['wav'])\n"
            " a=np.frombuffer(w.readframes(w.getnframes()),dtype=np.int16).astype(np.float32)/32768\n"
            " print(json.dumps({'text':m.recognize(a)}),flush=True)\n")
    def __init__(self, s):
        self.model = "parakeet-v3"
        self.p = None
        self.lock = threading.Lock()
    def start(self):
        env = dict(os.environ, HF_HOME=str(PARAKEET_DIR / "hf"), HF_HUB_OFFLINE="1", OMP_NUM_THREADS=threads())
        self.p = subprocess.Popen([parakeet_python(), "-I", "-c", self.CODE, PARAKEET_MODEL], env=env,
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        if not self.p.stdout.readline():
            raise RuntimeError("Parakeet no arrancó: reinstálalo con «hf-dictate install-parakeet»")
    def transcribe(self, pcm, prompt="", final=True):
        with tempfile.NamedTemporaryFile(prefix="hf-dictate-", suffix=".wav", delete=False) as f:
            f.write(wav_bytes(pcm)); wav = f.name
        try:
            with self.lock:
                self.p.stdin.write(json.dumps({"wav": wav}) + "\n"); self.p.stdin.flush()
                return json.loads(self.p.stdout.readline() or "{}").get("text", "")
        finally:
            os.unlink(wav)
    def close(self):
        if self.p:
            self.p.kill()

NEMO_LANGS = {"es": "es-US", "en": "en-US", "fr": "fr-FR", "it": "it-IT", "pt": "pt-BR", "de": "de-DE", "nl": "nl-NL",
              "tr": "tr-TR", "ru": "ru-RU", "uk": "uk-UA", "ar": "ar-AR", "hi": "hi-IN", "ja": "ja-JP", "ko": "ko-KR", "vi": "vi-VN"}

class NemotronEngine:
    """Nemotron 3.5 en streaming (API en C de NeMo-Speech.cpp con ctypes). Como Vosk puro: stream() recibe el audio
    según llega, da lo provisional y la frase cuando el modelo detecta el final (tras dictationPauseMs, mínimo 800 ms)."""
    name = "nemotron"
    def __init__(self, s):
        self.model = "nemotron-3.5"
        lang = s.get("dictationLang") or "es+en"
        self.lang = NEMO_LANGS.get(lang, "auto")         # es+en, auto y los que no tiene (ca, gl, eu): lo detecta él
        self.eou = max(800, int(s.get("dictationPauseMs") or 800))
        self.L = self.rec = self.st = None
    def start(self):
        import ctypes as C
        sz = C.c_size_t
        class Backend(C.Structure): _fields_ = [("size", sz), ("gpu", C.c_int32)]
        class Model(C.Structure): _fields_ = [("size", sz), ("path", C.c_char_p), ("name", C.c_char_p)]
        class Endp(C.Structure): _fields_ = [("size", sz), ("enable", C.c_bool), ("vad_based", C.c_bool), ("eou_ms", C.c_int32)]
        class Cfg(C.Structure):
            _fields_ = [("size", sz)] + [(n, C.c_void_p) for n in
                        "backend model streaming decoder vad endpointing postproc diar batching salm".split()]
        class Opts(C.Structure):     # nemo_speech_asr_recognition_options (asr.h, ABI v1)
            _fields_ = [("size", sz), ("request_id", C.c_char_p), ("language_code", C.c_char_p), ("interim", C.c_bool),
                        ("words", C.c_bool), ("punct", C.c_bool), ("verbatim", C.c_bool), ("profanity", C.c_bool),
                        ("eou_ms", C.c_int32), ("ctx", C.c_void_p), ("ctx_n", sz), ("max_alt", C.c_int32),
                        ("diar", C.c_bool), ("max_spk", C.c_int32)]
        L = C.CDLL(str(nemotron_lib()))
        L.nemo_speech_asr_recognition_options_default.restype = Opts
        L.nemo_speech_asr_last_error.restype = C.c_char_p
        L.nemo_speech_asr_result_transcript.restype = C.c_char_p
        L.nemo_speech_asr_result_transcript.argtypes = [C.c_void_p, sz]
        L.nemo_speech_asr_result_is_final.restype = C.c_bool
        L.nemo_speech_asr_result_is_final.argtypes = [C.c_void_p]
        for f in ("result_destroy", "stream_close", "destroy", "stream_finish"):
            getattr(L, "nemo_speech_asr_" + f).argtypes = [C.c_void_p]
        L.nemo_speech_asr_stream_push_f32.argtypes = [C.c_void_p, C.c_void_p, sz, C.c_int32]
        L.nemo_speech_asr_stream_next.argtypes = [C.c_void_p, C.c_void_p]
        L.nemo_speech_asr_streaming_recognize.argtypes = [C.c_void_p, C.c_void_p, C.c_void_p]
        self.C, self.L = C, L
        self._keep = [Backend(C.sizeof(Backend), -1), Model(C.sizeof(Model), str(NEMOTRON_GGUF).encode(), None),
                      Endp(C.sizeof(Endp), True, False, self.eou)]
        cfg = Cfg(C.sizeof(Cfg), C.addressof(self._keep[0]), C.addressof(self._keep[1]), None, None, None,
                  C.addressof(self._keep[2]))
        self.rec = C.c_void_p()
        if L.nemo_speech_asr_create(C.byref(cfg), C.byref(self.rec)) != 0:
            raise RuntimeError("Nemotron no arrancó: " + (L.nemo_speech_asr_last_error() or b"").decode(errors="replace"))
        self.opts = L.nemo_speech_asr_recognition_options_default()
        self.lang_b = self.lang.encode()
        self.opts.language_code = self.lang_b; self.opts.interim = True; self.opts.punct = True
        self.st = self._open()
    def _open(self):
        st = self.C.c_void_p()
        if self.L.nemo_speech_asr_streaming_recognize(self.rec, self.C.byref(self.opts), self.C.byref(st)) != 0:
            raise RuntimeError("Nemotron: " + (self.L.nemo_speech_asr_last_error() or b"").decode(errors="replace"))
        return st
    def _push(self, st, pcm):
        a = array.array("h", bytes(pcm))
        self.L.nemo_speech_asr_stream_push_f32(st, (self.C.c_float * len(a))(*[x / 32768 for x in a]), len(a), RATE)
    def _drain(self, st):
        """→ (frases terminadas, último provisional o None)."""
        done, part = [], None
        while True:
            r = self.C.c_void_p()
            if self.L.nemo_speech_asr_stream_next(st, self.C.byref(r)) != 0 or not r.value:
                return done, part
            t = (self.L.nemo_speech_asr_result_transcript(r, 0) or b"").decode(errors="replace").strip()
            if self.L.nemo_speech_asr_result_is_final(r):
                done.append(t); part = ""
            else:
                part = t
            self.L.nemo_speech_asr_result_destroy(r)
    def stream(self, frame):
        self._push(self.st, frame)
        done, part = self._drain(self.st)
        if done:
            return " ".join(t for t in done if t), part or ""
        return None, part or ""
    def flush(self):
        """Fin del audio: lo que quedaba a medias."""
        self.L.nemo_speech_asr_stream_finish(self.st)
        done, _ = self._drain(self.st)
        self.L.nemo_speech_asr_stream_close(self.st)
        self.st = self._open()
        return " ".join(t for t in done if t)
    final = flush
    def transcribe(self, pcm, prompt="", final=True):
        st = self._open()
        try:
            self._push(st, pcm)
            self.L.nemo_speech_asr_stream_finish(st)
            return nemo_join(self._drain(st)[0])
        finally:
            self.L.nemo_speech_asr_stream_close(st)
    def close(self):
        if self.st:
            self.L.nemo_speech_asr_stream_close(self.st); self.st = None
        if self.rec:
            self.L.nemo_speech_asr_destroy(self.rec); self.rec = None

def nemo_join(parts):
    out = ""
    for t in parts:
        if t.strip():
            out += join_piece(out, nemo_text(out, t))
    return out

def nemo_text(prev, text):
    """Nemotron no pone punto al cerrar una frase: si la siguiente empieza en mayúscula y lo de antes no acaba en signo,
    es otra frase y va con su punto delante (join_piece la tomaría por continuación y la pondría en minúscula)."""
    text, p = text.strip(), prev.rstrip(" ")
    if p and not p.endswith((".", "!", "?", "…", ":", ",", ";", "\n")) and text[:1].isupper() and text[1:2].islower():
        return ". " + text
    return text

class VoskEngine:
    """Vosk (Kaldi): reconoce mientras llega el audio, así que lo provisional sale al momento."""
    name = "vosk"
    def __init__(self, s):
        self.path = vosk_path(s.get("dictationVoskModel") or "vosk-model-small-es-0.42")
        self.rec = None
        self.pause_end = max(0.25, int(s.get("dictationPauseMs") or 600) / 1000)
    def start(self):
        import vosk
        vosk.SetLogLevel(-1)
        self.vmodel = vosk.Model(str(self.path))         # (no «model»: ese nombre es el del modelo whisper en los eventos)
        self.model = self.path.name
        self.rec = vosk.KaldiRecognizer(self.vmodel, RATE)
        if hasattr(self.rec, "SetEndpointerDelays"):     # vosk ≥ 0.3.45: frase cerrada tras ~0,5 s de pausa
            try:
                self.rec.SetEndpointerDelays(5.0, self.pause_end, 20.0)
            except Exception:
                pass
    def feed(self, frame):
        """→ texto provisional de la frase en curso."""
        if self.rec.AcceptWaveform(bytes(frame)):
            self.done = (getattr(self, "done", "") + " " + json.loads(self.rec.Result()).get("text", "")).strip()
        return (getattr(self, "done", "") + " " + json.loads(self.rec.PartialResult()).get("partial", "")).strip()
    def stream(self, frame):
        """Modo Vosk puro: (frase terminada o None, texto provisional). Vosk decide el final de frase (endpointing)."""
        if self.rec.AcceptWaveform(bytes(frame)):
            return json.loads(self.rec.Result()).get("text", "").strip(), ""
        return None, json.loads(self.rec.PartialResult()).get("partial", "").strip()
    def flush(self):
        t = json.loads(self.rec.FinalResult()).get("text", "").strip()
        self.rec.Reset()
        return t
    def final(self):
        t = (getattr(self, "done", "") + " " + json.loads(self.rec.FinalResult()).get("text", "")).strip()
        self.done = ""
        self.rec.Reset()
        return vosk_punct(t)
    def transcribe(self, pcm, prompt="", final=True):
        import vosk
        r = vosk.KaldiRecognizer(self.vmodel, RATE)
        r.AcceptWaveform(bytes(pcm))
        return vosk_punct(json.loads(r.FinalResult()).get("text", ""))
    def close(self):
        pass

def vosk_punct(t):
    """Vosk no puntúa: mayúscula al principio y punto al final."""
    t = t.strip()
    return (t[:1].upper() + t[1:] + ".") if t else ""

# ---------------------------------------------------------------- texto
NOISE = ("[BLANK_AUDIO]", "[MÚSICA]", "[Música]", "[Music]", "(música)", "[SILENCIO]", "[silencio]", "[ Silencio ]", "[risas]", "(risas)")
HALLU = re.compile(r"^(?:gracias(?: por (?:ver|vernos|su atencion|mirar)(?: el video)?)?|subtitulos? (?:realizados? |hechos? )?por.*|"
                   r".*amara\.?\s?org.*|suscribete.*|musica|silencio|aplausos|thank you\.?|you|\.+|¡?adios!?|chao)$", re.I)

def clean_out(t):
    lines = []
    for ln in (t or "").splitlines():
        ln = ln.strip()
        if ln.startswith("[") and "-->" in ln:      # marcas de tiempo, por si acaso
            ln = ln.split("]", 1)[-1].strip()
        for n in NOISE:
            ln = ln.replace(n, "")
        ln = re.sub(r"\[[^\]]{0,30}\]|\([A-ZÁÉÍÓÚ ]{3,30}\)", "", ln).strip()
        if ln:
            lines.append(ln)
    return spanish_marks(re.sub(r"\s+", " ", " ".join(lines)).strip())

ES_WORDS = set("el la los las de del que y en a se por un una es no con para su al lo como más pero me te le mi tu qué cómo "
               "dónde cuándo cuál quién cuánto puedes hay está están eso esto muy ya".split())
EN_WORDS = set("the you to is are what how do does can it of and i we they this that my your will would".split())

def spanish_marks(t):
    """«¿» y «¡» de apertura: los motores (Parakeet, Whisper) solo ponen el de cierre. Solo en frases en español
    (con es+en, «How are you?» se queda como está)."""
    def fix(sent):
        end = sent.rstrip()[-1:]
        op = {"?": "¿", "!": "¡"}.get(end)
        if not op or op in sent:
            return sent
        w = re.findall(r"[a-záéíóúñü]+", sent.lower())
        if sum(x in ES_WORDS for x in w) < max(1, sum(x in EN_WORDS for x in w)):
            return sent
        m = re.match(r"(\W*)(.*)", sent, re.S)
        return m.group(1) + op + m.group(2)
    return "".join(fix(x) for x in re.split(r"(?<=[.!?…])(\s+)", t)) if t else t

def fold(s):
    import unicodedata
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if not unicodedata.combining(c))

def hallucination(text, speech_s):
    f = re.sub(r"[¡!¿?.,…\s]+", " ", fold(text)).strip()
    if not f:
        return True
    if speech_s < 2.5 and HALLU.match(f):
        return True
    return bool(re.search(r"amara\.?\s?org|subtitulos realizados por", f))

SPOKEN = {"nueva linea": "\n", "salto de linea": "\n", "punto y aparte": ".\n", "nuevo parrafo": "\n\n",
          "punto": ".", "coma": ",", "dos puntos": ":", "punto y coma": ";", "abre interrogacion": "¿",
          "cierra interrogacion": "?", "signo de interrogacion": "?", "puntos suspensivos": "…"}

# ---------------------------------------------------------------- corregir nombres
# Parakeet y Vosk no admiten vocabulario y whisper solo lo toma como pista: lo que suena como una palabra del vocabulario
# (dictationPrompt) se cambia por ella al final de cada frase. Clave fonética para español e inglés: «mi du dev» y
# «midudev», «fu faiters» y «Foo Fighters» dan lo mismo.
PHON = (("igh", "ai"), ("ph", "f"), ("th", "t"), ("sh", "ch"), ("ck", "k"), ("oo", "u"), ("ee", "i"), ("ea", "i"),
        ("qu", "k"), ("ll", "y"), ("w", "u"), ("v", "b"), ("z", "s"), ("x", "ks"), ("y", "i"), ("h", ""))

def phon(s):
    s = re.sub(r"[^a-z0-9]", "", fold(s))
    for a, b in PHON:
        s = s.replace(a, b)
    s = re.sub(r"c(?=[ei])", "s", s).replace("c", "k")
    s = re.sub(r"g(?=[ei])", "j", s)
    return re.sub(r"(.)\1+", r"\1", s)

def vocab_terms(vocab):
    out = []
    for t in re.split(r"[,;\n]+", vocab or ""):
        t = t.strip()
        k = phon(t)
        if len(k) >= 4 and len(t) <= 40:
            out.append((t, k, len(t.split())))
    return out

def vocab_fix(text, vocab):
    """Cambia los trozos de «text» que suenan como una palabra del vocabulario por ella."""
    import difflib
    terms = vocab_terms(vocab)
    if not terms or not text.strip():
        return text
    toks = re.findall(r"\S+", text)
    out, i = [], 0
    while i < len(toks):
        best = None
        for t, k, nw in terms:
            for n in range(max(1, nw - 1), nw + 3):
                if i + n > len(toks):
                    break
                span = toks[i:i + n]
                core = " ".join(span)
                kg = phon(core)
                if not kg or kg[0] != k[0] or abs(len(kg) - len(k)) > max(2, len(k) // 4):
                    continue
                r = 1.0 if kg == k else difflib.SequenceMatcher(None, kg, k).ratio()
                if r >= (0.8 if len(k) >= 6 else 0.92) and (best is None or r > best[0]):
                    best = (r, n, t)
        if best:
            r, n, t = best
            last = toks[i + n - 1]
            tail = re.search(r"[.,;:!?…»)\]]+$", last)
            head = re.match(r"^[¿¡«(\[]+", toks[i])
            out.append((head.group(0) if head else "") + t + (tail.group(0) if tail else ""))
            i += n
        else:
            out.append(toks[i]); i += 1
    return " ".join(out)

def ai_fix_wanted(s, kind):
    if os.environ.get("HF_DICTATE_AIFIX") == "0":   # conversación: el asistente ya entiende un nombre mal oído y la
        return False                                # corrección le añadía hasta dictationAiFixSec a cada turno
    mode = s.get("dictationAiFix") or "asistente"
    if mode == "siempre":
        return True
    return mode == "asistente" and os.environ.get("HF_DICTATE_FOR") == "ia"

def ai_fix(text, s, before=""):
    """Corrige los nombres mal oídos con la IA (hf-ai dictfix). Si tarda más de dictationAiFixSec o falla, el texto
    queda como estaba: el dictado no se para nunca por esto."""
    try:
        r = subprocess.run([str(ROOT / "scripts/hf-ai"), "dictfix", json.dumps({"vocab": s.get("dictationPrompt") or "", "before": before})],
                           input=text, capture_output=True, text=True, timeout=max(1.0, float(s.get("dictationAiFixSec") or 3)))
        out = r.stdout.strip()
        return out if r.returncode == 0 and out else text
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return text

def spoken_cmd(text):
    f = re.sub(r"[¡!¿?.,…]+", "", fold(text)).strip()
    return SPOKEN.get(f)

def join_piece(prev, text, punct=True):
    """El trozo que se escribe tras «prev»: espacio, y mayúscula solo al empezar frase."""
    text = text.strip()
    if not punct:
        text = re.sub(r"[.,;:¡!¿?…]+", "", text).strip()
        text = text[:1].lower() + text[1:] if text[1:2].islower() else text
    if not prev:
        return text[:1].upper() + text[1:] if punct else text
    p = prev.rstrip(" ")
    if p.endswith("\n"):
        return text[:1].upper() + text[1:] if punct else text
    ends = p.endswith((".", "!", "?", "…", ":"))
    if punct and not ends and text[:1].isupper() and text[1:2].islower():
        text = text[:1].lower() + text[1:]          # sigue la frase: whisper la empieza siempre en mayúscula
    if punct and ends and text[:1].islower():
        text = text[:1].upper() + text[1:]
    if text[:1] in ",.;:?!…":
        return text
    return " " + text

# ---------------------------------------------------------------- salida
def copy(text):
    if not shutil.which("wl-copy"):
        return False
    return subprocess.run(["wl-copy", "--", text], stderr=subprocess.DEVNULL).returncode == 0

def output(text, s=None, first=True):
    s = s or settings()
    mode = os.environ.get("HF_DICTATE_OUTPUT") or s.get("dictationOutput") or "escribir"
    if mode == "ninguna":       # quien llama (p. ej. el chat de la IA o una prueba) se queda el texto de los eventos
        return "ninguna"
    if first:
        time.sleep(0.15)        # que se suelten las teclas del atajo
    t = typer()
    if mode == "escribir" and t == "wtype":
        done = retype("", text)
        if done == text:
            return "escrito"
        if done:                # se quedaron pulsadas Super/Alt/Ctrl: lo que falta, al portapapeles
            return "copiado" if copy(text[len(done):]) else "nada"
    if mode == "escribir" and t == "ydotool" and "\n" not in text and keys_free(4):
        if subprocess.run(["ydotool", "type", "--key-delay", "4", "--", text], capture_output=True).returncode == 0:
            return "escrito"
    if mode in ("escribir", "pegar") and copy(text):
        if not keys_free(4):
            return "copiado"
        if t == "wtype" and subprocess.run(["wtype", "-M", "ctrl", "-k", "v", "-m", "ctrl"], stderr=subprocess.DEVNULL).returncode == 0:
            return "pegado"
        if t == "ydotool" and subprocess.run(["ydotool", "key", "29:1", "47:1", "47:0", "29:0"], capture_output=True).returncode == 0:
            return "pegado"
        return "copiado"
    if copy(text):
        return "copiado"
    return "nada"

def tail_end(shown, words):
    """Índice de «words» justo detrás de lo que ya está tecleado («shown», palabras), o None si su final no aparece."""
    import difflib
    norm = lambda w: re.sub(r"[^\w]+", "", w.lower())
    blocks = [b for b in difflib.SequenceMatcher(None, [norm(w) for w in shown], [norm(w) for w in words],
                                                 autojunk=False).get_matching_blocks() if b.size]
    if blocks and blocks[-1].a + blocks[-1].size == len(shown):
        return blocks[-1].b + blocks[-1].size
    return None

# Teclas modificadoras físicas (evdev): Ctrl, Mayús, Alt, AltGr y Super, izquierda y derecha
MODS = (29, 42, 54, 56, 97, 100, 125, 126)
EVIOCGKEY = (2 << 30) | (96 << 16) | (ord("E") << 8) | 0x18

def mods_held():
    """¿Hay una tecla modificadora pulsada en algún teclado físico? (None si no se pueden leer: sin el grupo input)."""
    import fcntl, glob
    seen = None
    for p in {os.path.realpath(p) for p in glob.glob("/dev/input/by-path/*-event-kbd") + glob.glob("/dev/input/by-id/*-event-kbd")}:
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            try:
                buf = bytearray(96); fcntl.ioctl(fd, EVIOCGKEY, buf)
            finally:
                os.close(fd)
        except OSError:
            continue
        seen = False
        if any(buf[k // 8] >> (k % 8) & 1 for k in MODS):
            return True
    return seen

def keys_free(timeout):
    """Espera (hasta «timeout» s) a que no haya modificadoras pulsadas. Hyprland suma las de todos los teclados: lo que
    tecleara wtype con Super/Alt pulsados serían atajos (Super + Alt + S manda la ventana al espacio oculto; las teclas
    «code:21/86» del zoom coinciden con códigos del mapa de wtype y la pantalla se agrandaba hasta 3×)."""
    end = time.time() + timeout
    while mods_held():
        if time.time() >= end:
            return False
        time.sleep(0.03)
    return True

# Pegar en vez de teclear: wtype inventa un código de tecla para cada carácter y, en los editores de texto enriquecido
# (ProseMirror/tiptap, Lexical: T3 Code, WhatsApp web, Notion…), según el código que le toque se pierden espacios,
# signos y tildes («pasasidictoalgo»). Se pega con el portapapeles marcado como sensible (el historial, cliphist, lo
# ignora) y al acabar el dictado se devuelve lo que había copiado. En las terminales Ctrl+V no pega: ahí, wtype.
TERMS = ("kitty", "foot", "alacritty", "wezterm", "ghostty", "konsole", "terminal", "xterm", "console", "kgx", "ptyxis",
         "tilix", "terminator", "st-256color", "urxvt")
CLIP = {"saved": None}

def pasting():
    if os.environ.get("HF_DICTATE_TYPE") == "wtype" or not (shutil.which("wl-copy") and shutil.which("wl-paste")):
        return False
    try:
        cls = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True,
                                        timeout=2).stdout or "{}").get("class", "").lower()
    except Exception:
        return False
    return bool(cls) and not any(t in cls for t in TERMS)

def clip_save():
    """Lo que había en el portapapeles antes del primer pegado (un tipo: texto si lo hay)."""
    if CLIP["saved"] is not None:
        return
    try:
        types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True, timeout=2).stdout.split()
        t = next((x for x in ("text/plain;charset=utf-8", "UTF8_STRING", "text/plain") if x in types), types[0] if types else "")
        data = subprocess.run(["wl-paste", "-n", "-t", t], capture_output=True, timeout=3).stdout if t else b""
    except Exception:
        t, data = "", b""
    CLIP["saved"] = (t, data)

def clip_restore():
    """shortcut: si copias algo tú mientras dictas, al acabar vuelve lo de antes; habría que vigilar el portapapeles."""
    if CLIP["saved"] is None:
        return
    t, data = CLIP["saved"]; CLIP["saved"] = None
    time.sleep(0.3)                     # que la ventana acabe de leer el último pegado
    try:
        if data:
            subprocess.run(["wl-copy", "-t", t], input=data, timeout=3)
        else:
            subprocess.run(["wl-copy", "--clear"], timeout=3)
    except Exception:
        pass

def paste_text(text):
    clip_save()
    if subprocess.run(["wl-copy", "--sensitive", "--", text], stderr=subprocess.DEVNULL).returncode != 0:
        return False
    ok = subprocess.run(["wtype", "-M", "ctrl", "-k", "v", "-m", "ctrl"], stderr=subprocess.DEVNULL).returncode == 0
    time.sleep(0.12)                    # que lo lea antes de que el siguiente pegado lo cambie
    return ok

def retype(old, new, wait=4):
    """Cambia en la ventana «old» (lo último tecleado) por «new»: borra lo que difiere y escribe el resto (wtype), a
    trozos y solo sin modificadoras pulsadas. → lo que queda escrito en la ventana (== new si fue bien)."""
    k = 0
    while k < min(len(old), len(new)) and old[k] == new[k]:
        k += 1
    wt = lambda a: subprocess.run(["wtype", "-d", "4"] + a, stderr=subprocess.DEVNULL).returncode == 0
    now = old
    while len(now) > k:
        n = min(10, len(now) - k)
        if not keys_free(wait) or not wt(["-k", "BackSpace"] * n):
            return now
        now = now[:-n]
    if now != new and pasting():
        return new if keys_free(wait) and paste_text(new[len(now):]) else now
    while now != new:
        piece = new[len(now):len(now) + 10]
        if not keys_free(wait) or not wt(["--", piece]):
            return now
        now += piece
    return now

def voice_command(text, s):
    """Pasa la orden a hf-voice (en seco con HF_VOICE_DRY=1) → dict."""
    args = [str(ROOT / "scripts/hf-voice"), "run", text] + (["--dry-run"] if os.environ.get("HF_VOICE_DRY") else [])
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=90)
        return json.loads(r.stdout or "{}") or {"ok": False, "msg": "hf-voice no respondió"}
    except Exception as e:
        return {"ok": False, "msg": f"hf-voice falló: {e}"}

# ---------------------------------------------------------------- audio
def running_pid():
    try:
        pid = int(PIDFILE.read_text().strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        return 0

AEC_SRC, AEC_SINK = "hf-aec-source", "hf-aec-sink"

def pa_names(kind):
    """Nombres de los sinks / sources / modules de PipeWire (pactl list short)."""
    try:
        out = subprocess.run(["pactl", "list", "short", kind], capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return []
    return [l.split("\t") for l in out.splitlines() if l.strip()]

def aec_on():
    return any(len(f) > 1 and f[1] == AEC_SRC for f in pa_names("sources"))

def aec(cmd):
    """Cancelador de eco para hablar con Helpert sin auriculares: su voz suena por AEC_SINK y el micrófono AEC_SRC la
    resta. Solo existe mientras dura la conversación (Dictado.qml lo carga y lo quita); no cambia los dispositivos
    por defecto."""
    if not shutil.which("pactl"):
        return {"ok": False, "error": "Falta pactl (pipewire-pulse)"}
    mods = [f[0] for f in pa_names("modules") if len(f) > 2 and f"source_name={AEC_SRC}" in f[2]]
    if cmd == "on" and not mods:
        r = subprocess.run(["pactl", "load-module", "module-echo-cancel", "aec_method=webrtc",
                            f"source_name={AEC_SRC}", f"sink_name={AEC_SINK}"], capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            return {"ok": False, "error": (r.stderr or "No se pudo cargar module-echo-cancel").strip()}
    elif cmd == "off":
        for m in mods:
            subprocess.run(["pactl", "unload-module", m], capture_output=True, timeout=5)
    return {"ok": True, "on": aec_on()}

def rec_cmd():
    r = recorder()
    if r == "pw-record":
        tgt = ["--target", AEC_SRC] if os.environ.get("HF_DICTATE_AEC") == "1" and aec_on() else []
        return ["pw-record", "--raw", "--rate", str(RATE), "--channels", "1", "--format", "s16", *tgt,
                "--media-role", "Communication", "-P", "{ node.name = hf-dictate application.name = Dictado }", "-"]
    if r == "arecord":
        return ["arecord", "-q", "-f", "S16_LE", "-r", str(RATE), "-c", "1", "-t", "raw", "-"]
    return None

def file_pcm(path):
    """PCM 16 kHz mono s16 de un archivo (wav directo; lo demás con ffmpeg)."""
    try:
        with wave.open(str(path)) as w:
            if w.getframerate() == RATE and w.getnchannels() == 1 and w.getsampwidth() == 2:
                return w.readframes(w.getnframes())
    except Exception:
        pass
    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", str(path), "-f", "s16le", "-ac", "1", "-ar", str(RATE), "-"],
                       capture_output=True, timeout=120)
    if r.returncode != 0:
        raise RuntimeError("No pude leer el audio: " + r.stderr.decode(errors="replace").strip()[-160:])
    return r.stdout

def frame_db(b):
    a = array.array("h"); a.frombytes(b[: len(b) // 2 * 2])
    if not a:
        return -90.0
    rms = math.sqrt(sum(x * x for x in a) / len(a)) / 32768
    return 20 * math.log10(max(rms, 1e-6))

# ---------------------------------------------------------------- sesión
class Session:
    def __init__(self, s, kind="dictado", mode=None, hold=False, src=None, live_pace=False, tts=False):
        self.s = s
        # Helpert hablando (conversación): solo cuenta una voz clara y sostenida, que lo interrumpe (ev «barge»)
        self.tts = threading.Event()
        if tts:
            self.tts.set()
        self.aec = src is None and os.environ.get("HF_DICTATE_AEC") == "1" and aec_on()
        self.kind = kind
        self.mode = mode or s.get("dictationMode") or "ptt"
        self.hold = hold
        self.src = src
        self.live_pace = live_pace
        self.punct = s.get("dictationPunct", True) is not False
        self.live = s.get("dictationLive", True) is not False
        self.wake = s.get("dictationWake", True) is not False
        self.pause = max(250, int(s.get("dictationPauseMs") or 700)) / 1000
        self.silence = max(1.5, float(s.get("dictationSilenceSec") or 5))
        # Conversación por voz (Dictado.qml): el turno termina tras un silencio corto, y se espera más a que empieces
        if os.environ.get("HF_DICTATE_SILENCE"):
            self.silence = min(5.0, max(0.6, float(os.environ["HF_DICTATE_SILENCE"])))
        self.wait0 = float(os.environ.get("HF_DICTATE_WAIT") or 0)
        self.maxsec = float(s.get("dictationMaxSec") or 120)
        if self.mode == "continuo":
            self.maxsec = max(self.maxsec, 600.0)
        if kind == "comando":
            self.maxsec = 15.0
        if os.environ.get("HF_DICTATE_MAX"):   # conversación: un turno no dura minutos (con ruido de fondo no llegaba el silencio)
            self.maxsec = min(self.maxsec, max(10.0, float(os.environ["HF_DICTATE_MAX"])))
        self.vocab = (s.get("dictationPrompt") or "").strip()
        self.stop = threading.Event()
        self.cancel = threading.Event()
        self.released = threading.Event()
        if not hold:
            self.released.set()
        self.jobs = queue.Queue()
        self.partial_job = None
        self.cv = threading.Condition()
        self.busy = False
        self.partial_busy = False
        self.live_eng = None
        # texto provisional cada 0,6 s con GPU; sin GPU cada 1,2 s, para que no le quite CPU a la frase final
        self.partial_every = 0.6 if use_gpu(self.s.get("dictationModel") or "base", self.s, measure=False) else 1.2
        self.typed = ""            # lo ya entregado (escrito / copiado)
        self.pending = []          # trozos que esperan a «release»
        self.hows = []
        self.phrases = 0
        self.phrases_heard = 0
        self.cmd_done = False
        self.errors = []
        self.eng = None
        self.vosk = None
        self.ready = threading.Event()
        self.first_out = True
        # Texto en tiempo real: lo provisional se teclea en la ventana y se corrige al llegar la frase final.
        # Solo con wtype (hace falta BackSpace fiable) y saliendo por «escribir»; el texto de pegar/portapapeles va entero.
        out = os.environ.get("HF_DICTATE_OUTPUT") or s.get("dictationOutput") or "escribir"
        self.live_type = kind == "dictado" and self.live and out == "escribir" and typer() == "wtype"
        self.shown = ""            # lo provisional ya tecleado de la frase en curso
        self.closed = 0            # última frase cerrada (sus provisionales tardíos ya no se teclean)
        self.prev_words = (0, [])  # (frase, palabras) del provisional anterior: solo se teclea lo que repiten los dos
        self.tlock = threading.Lock()
        ww = fold(s.get("dictationWakeWord") or "Distro").strip()
        self.wake_re = re.compile(r"^\W*" + re.escape(ww) + r"\b") if self.wake and ww else None

    # -- motor
    def make_engines(self):
        e = engine(self.s)
        if not e:
            raise RuntimeError("Falta whisper.cpp: instálalo en Ajustes › Dictado")
        if e in ("vosk", "hibrido"):
            self.vosk = VoskEngine(self.s)
        elif e == "nemotron":                            # va por el camino de Vosk puro: reconoce según llega el audio
            self.vosk = NemotronEngine(self.s)
            # El runtime no deja fijar sus hilos y con todos los núcleos los tiene esperando en vacío (con 12: ~2 núcleos
            # ocupados al dictar); con 4 sigue en tiempo real (~0,5 s por s de audio) con la mitad de CPU. Antes de crear
            # ningún hilo: todos heredan la afinidad
            try:
                os.sched_setaffinity(0, sorted(os.sched_getaffinity(0))[:4])
            except (AttributeError, OSError):
                pass
        if e in ("vosk", "nemotron"):
            self.eng = self.vosk
        elif e == "faster-whisper":
            self.eng = FasterWhisperEngine(self.s)
        elif e == "parakeet":
            self.eng = ParakeetEngine(self.s)
            self.partial_every = 0.4                    # es tan rápido que lo provisional puede ir más a menudo
        else:
            self.eng = WhisperEngine(self.s)
            lm = live_model(self.s)
            if lm != self.eng.model and self.live:
                self.live_eng = WhisperEngine(self.s, lm)       # lo provisional en otro servidor, más ligero
            server_stop(keep=(self.eng.model, lm))
        self.live_eng = self.live_eng or self.eng
        return e

    def load_engines(self):
        try:
            t0 = time.time()
            if self.vosk:
                self.vosk.start()
            if self.eng is not self.vosk:
                self.eng.start()
            if self.live_eng is not self.eng:
                self.live_eng.start()
            emit("ready", secs=round(time.time() - t0, 2), model=getattr(self.eng, "model", ""), liveModel=getattr(self.live_eng, "model", ""))
        except Exception as e:
            self.errors.append(str(e))
            self.stop.set()
        finally:
            self.ready.set()

    def prompt(self):
        # solo el vocabulario del usuario y, al dictar, el final de lo ya escrito (da contexto entre frases).
        # Nada de frases de ejemplo: whisper tiende a copiarlas cuando el audio es dudoso.
        tail = self.typed[-200:].strip() if self.kind == "dictado" and not os.environ.get("HF_DICTATE_NOCTX") else ""
        return (self.vocab + " " + tail).strip()

    # -- trabajadores: uno escribe las frases terminadas; otro, lo provisional (si el motor está libre)
    def worker(self):
        self.ready.wait()
        while True:
            job = self.jobs.get()
            if job == "END":
                return
            self.busy = True
            try:
                self.do_final(*job)
            except Exception as e:
                self.errors.append(str(e)); emit("error", msg=str(e)[:200], code="engine", fatal=False)
            self.busy = False

    def partial_worker(self):
        self.ready.wait()
        while not self.capture_done.is_set():
            with self.cv:
                pj, self.partial_job = self.partial_job, None
            if pj is None or self.errors:
                time.sleep(0.03); continue
            self.partial_busy = True
            try:
                self.do_partial(*pj)
            finally:
                self.partial_busy = False

    def partial_free(self):
        """¿se puede pedir lo provisional? Si comparte servidor con lo final, solo si no hay frases esperando."""
        if self.partial_busy:
            return False
        return self.live_eng is not self.eng or (not self.busy and self.jobs.empty())

    def do_partial(self, pid, pcm):
        if isinstance(pcm, str):                         # Nemotron: el provisional ya viene reconocido
            return self.show(pid, pcm)
        if self.live_eng is self.vosk or not self.live or self.errors:
            return
        try:
            same = hasattr(self.live_eng, "allowed") and hasattr(self.eng, "allowed")
            if same:
                self.live_eng.lang = self.eng.lang       # lo provisional, en el idioma que se está hablando
            t = clean_out(self.live_eng.transcribe(pcm, self.prompt(), final=False))
            if same:
                self.eng.lang = self.live_eng.lang       # y si oyó el otro idioma, la frase final ya va en ese
        except Exception:
            return
        if pid == self.phrase_id and t and not hallucination(t, len(pcm) / 2 / RATE):
            emit("partial", text=t)
            self.show(pid, t)

    def show(self, pid, text):
        """Teclea lo provisional de la frase «pid» (corrigiendo lo anterior)."""
        if not self.live_type or not self.released.is_set() or self.pending or self.cancel.is_set() \
                or self.busy or not self.jobs.empty() or self.eng is self.vosk and self.eng.name != "nemotron":
            return                                       # con frases por escribir, esperar: si no, se mezclan
        # Estable: las palabras en que coinciden este provisional y el anterior. Cada provisional vuelve a transcribir la
        # frase entera y en las largas cambia palabras de en medio: teclearlo tal cual borraba y reescribía trozos enteros.
        words = text.split()
        prev = self.prev_words[1] if self.prev_words[0] == pid else []
        self.prev_words = (pid, words)
        n = 0
        while n < min(len(prev), len(words)) and prev[n] == words[n]:
            n += 1
        with self.tlock:
            if pid <= self.closed or not self.released.is_set():
                return
            # «Distro, …»: es una orden, no se teclea
            if self.wake_re and self.wake_re.match(fold(text)):
                target = ""
            elif not self.shown:
                if n == 0:
                    return
                first = " ".join(words[:n])
                if self.punct and self.eng.name == "nemotron":
                    first = nemo_text(self.typed, first)
                target = join_piece(self.typed, first, self.punct)
            else:
                # Solo se añade al final: si una palabra ya tecleada cambia («amigos» → «amigas») se corrige una vez, al
                # cerrar la frase; corregirla aquí reescribía cada vez todo lo que venía detrás. Lo nuevo empieza donde
                # acaba lo tecleado dentro de este provisional (por contenido: el motor mete o quita palabras de antes)
                start = tail_end(self.shown.split(), words[:n])
                if start is None or start >= n:
                    return
                target = self.shown + " " + " ".join(words[start:n])
            if self.first_out and target:
                time.sleep(0.15); self.first_out = False
            self.shown = retype(self.shown, target, wait=0)   # con modificadoras pulsadas, ya lo hará otro provisional

    def settle(self, piece=""):
        """Cambia lo provisional tecleado por «piece» (o lo borra). → True si fue bien."""
        if self.shown or piece:
            self.released.wait(timeout=4)                # nunca con las teclas del atajo pulsadas (Super + Alt + letra)
        with self.tlock:
            ok = retype(self.shown, piece, wait=10) == piece
            self.shown = ""
            return ok

    def do_final(self, pid, pcm, speech_s, end_wall, text=None):
        if self.cancel.is_set():
            return
        if text is not None:                           # Vosk puro (o Nemotron): la frase ya viene reconocida
            if self.eng.name != "nemotron":           # Nemotron ya puntúa
                text = vosk_punct(text) if self.punct else text
            return self.handle_text(text, speech_s, end_wall)
        if os.environ.get("HF_DICTATE_DUMP"):          # depurar: guarda el audio de cada frase
            pathlib.Path(os.environ["HF_DICTATE_DUMP"], f"frase-{pid:03d}.wav").write_bytes(wav_bytes(pcm))
        if self.vosk and self.eng is self.vosk:
            text = self.vosk_final.pop(pid, "")
        else:
            text = clean_out(self.eng.transcribe(pcm, self.prompt()))
        if hallucination(text, speech_s):
            self.settle()
            emit("phrase", text="", skipped=True, lat=round(time.time() - end_wall, 2))
            return
        return self.handle_text(text, speech_s, end_wall)

    def fix(self, text):
        """Nombres mal oídos: primero el vocabulario (al momento, sin red); luego, si se pidió, la IA."""
        raw = text
        text = vocab_fix(text, self.vocab)
        if ai_fix_wanted(self.s, self.kind) and len(text) >= 3:
            text = ai_fix(text, self.s, self.typed[-300:] if self.kind == "dictado" else "")
        if text != raw:
            emit("fixed", raw=raw, text=text)
        return text

    def handle_text(self, text, speech_s, end_wall):
        if self.cancel.is_set() or not text.strip():
            self.settle(); return
        is_cmd = self.kind == "comando"
        if not is_cmd and self.wake:
            is_cmd, rest = wake_split(text, self.s)
            if is_cmd:
                text = rest
        if spoken_cmd(text) is None:
            text = self.fix(text)
        lat = round(time.time() - end_wall, 2)
        if is_cmd:
            self.settle()
            self.run_command(text, lat)
            return
        sp = spoken_cmd(text)
        prev = self.typed + "".join(self.pending)
        if sp is None and self.punct and self.eng.name == "nemotron":
            text = nemo_text(prev, text)
        piece = (sp if sp is not None else join_piece(prev, text, self.punct))
        if sp is not None and sp.startswith((".", ",", ":", ";", "?", "…")):
            piece = sp
        self.phrases += 1
        if not self.released.is_set():
            self.pending.append(piece)
            emit("phrase", text=piece, lat=lat, how="espera")
            return
        how = self.deliver(piece)
        emit("phrase", text=piece, lat=lat, how=how)

    def deliver(self, piece):
        mode = os.environ.get("HF_DICTATE_OUTPUT") or self.s.get("dictationOutput") or "escribir"
        shown = self.shown
        self.typed += piece
        if mode == "portapapeles":
            how = "copiado" if copy(self.typed.strip()) else "nada"
        elif shown:
            how = "escrito" if self.settle(piece) else "nada"   # lo provisional ya está: solo se corrige
        else:
            how = output(piece, self.s, first=self.first_out)
        self.first_out = False
        self.hows.append(how)
        return how

    def flush(self):
        if self.pending:
            piece = "".join(self.pending); self.pending = []
            self.deliver(piece)

    def run_command(self, text, lat):
        text = text.strip().strip(".").strip()
        if not text:
            emit("cmdresult", ok=False, msg="Di la orden después de «" + (self.s.get("dictationWakeWord") or "Distro") + "»", text="")
            return
        self.cmd_done = True
        emit("cmd", text=text, lat=lat)
        self.released.wait(timeout=5)       # que se suelten las teclas antes de mandar atajos
        r = voice_command(text, self.s)
        emit("cmdresult", ok=bool(r.get("ok")), msg=r.get("msg") or ("Hecho" if r.get("ok") else "No pude hacerlo"),
             label=r.get("label") or text, intent=r.get("intent"), fallback=r.get("fallback"), text=text,
             **({"plan": r.get("plan")} if r.get("dry") else {}))
        if self.kind == "comando":
            self.stop.set()

    # -- control por stdin
    def stdin_loop(self):
        try:
            for line in sys.stdin:
                c = line.strip()
                if c == "stop":
                    self.stop.set()
                elif c == "cancel":
                    self.cancel.set(); self.stop.set()
                elif c == "release":
                    self.released.set()
                elif c == "hold":            # el shell: vuelven a estar pulsadas las teclas del atajo
                    self.released.clear()
                elif c == "tts on":
                    self.tts.set()
                elif c == "tts off":
                    self.tts.clear()
        except Exception:
            pass

    # -- bucle principal
    def run(self):
        try:
            eng_name = self.make_engines()
        except Exception as e:
            emit("error", msg=str(e), code="model" if "modelo" in str(e) else "engine"); return 1
        if self.src is None and not rec_cmd():
            emit("error", msg="No hay con qué grabar (pw-record o arecord)", code="recorder"); return 1
        if self.src is None and running_pid():
            emit("error", msg="Ya hay un dictado en curso"); return 1
        PIDFILE.write_text(str(os.getpid()))
        def on_stop(*_): self.stop.set()
        def on_cancel(*_): self.cancel.set(); self.stop.set()
        for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGUSR1):
            signal.signal(sg, on_stop)
        signal.signal(signal.SIGUSR2, on_cancel)
        self.capture_done = threading.Event()
        self.phrase_id = 0
        self.vosk_final = {}
        threading.Thread(target=self.load_engines, daemon=True).start()
        if not sys.stdin.isatty():
            threading.Thread(target=self.stdin_loop, daemon=True).start()
        wk = threading.Thread(target=self.worker, daemon=True); wk.start()
        threading.Thread(target=self.partial_worker, daemon=True).start()
        emit("rec", engine=eng_name, model=(self.s.get("dictationVoskModel") or "vosk-model-small-es-0.42") if eng_name == "vosk" else self.s.get("dictationModel") or "base", kind=self.kind, mode=self.mode,
             live=self.live, hold=self.hold, file=bool(self.src))
        try:
            self.capture()
        finally:
            PIDFILE.unlink(missing_ok=True)
        # termina lo que quede por transcribir
        if not self.cancel.is_set() and (self.busy or not self.jobs.empty()):
            emit("transcribing")
        self.jobs.put("END")
        while wk.is_alive():
            if self.cancel.is_set() or ORPHAN["v"]:
                break
            wk.join(0.1)
        if self.eng:
            self.eng.close()
        if self.cancel.is_set() or not self.pending:
            self.settle()                # lo provisional de una frase que no llegó a cerrarse (con frases en espera,
                                         # flush lo corrige con la frase)
        if self.cancel.is_set() or ORPHAN["v"]:
            emit("cancelled"); return 0
        if self.errors and not self.typed and not self.pending:
            emit("error", msg=self.errors[0][:200], code="engine"); return 1
        if self.kind == "comando" or self.cmd_done and not self.typed and not self.pending:
            if not self.cmd_done:
                emit("error", msg="No te oí: prueba otra vez", code="silence" if self.peak < 0.12 else "empty"); return 1
            emit("done", how="comando"); return 0
        self.released.wait(timeout=4)    # lo que falta, con las teclas del atajo ya sueltas
        self.released.set()
        self.flush()
        if self.punct and self.eng and self.eng.name == "nemotron" and self.typed.strip() \
                and not self.typed.rstrip().endswith((".", "!", "?", "…", ":", ";", ",", "\n")):
            self.deliver(".")            # Nemotron no cierra con punto la última frase
        full = self.typed.strip()
        if not full:
            if self.peak < 0.12 and not self.src:
                emit("error", msg="No se oyó nada: revisa el micrófono en Ajustes › Sonido", code="silence"); return 1
            emit("error", msg="No entendí nada", code="empty"); return 1
        try:
            STATE.mkdir(parents=True, exist_ok=True)
            (STATE / "dictation-last.txt").write_text(full + "\n")
        except Exception:
            pass
        emit("text", text=full)
        hows = [h for h in self.hows if h]
        how = "nada" if hows and all(h == "nada" for h in hows) else next((h for h in reversed(hows) if h != "nada"), "nada")
        if how == "nada":
            emit("error", msg="No pude escribir ni copiar el texto (falta wtype o wl-clipboard)", code="typer", text=full); return 1
        emit("done", how=how)
        return 0

    def capture(self):
        proc = None
        if self.src is None:
            try:
                proc = subprocess.Popen(rec_cmd(), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            except Exception as e:
                self.errors.append(f"No se pudo grabar: {e}"); return
            os.set_blocking(proc.stdout.fileno(), False)
            data = None
        else:
            data = self.src + b"\0\0" * int(RATE * max(1.5, self.pause + 0.8))   # cola de silencio: cierra la última frase
        pos = 0
        buf = bytearray()
        t0 = tmax0 = time.time()
        ppid = os.getppid()
        barge = 0
        eref, tts_n, was_tts = -90.0, 0, False                      # nivel del eco de Helpert (picos: sube ≤10 dB/s, cae ~1,7 dB/s) y tramos oídos
        tpre = collections.deque(maxlen=50)        # 1,5 s del micro mientras habla Helpert
        # interrumpir a Helpert: dB por encima del suelo y tramos de 30 ms seguidos. Con el cancelador de eco su voz
        # apenas llega; sin él (altavoces) hace falta hablar claramente más alto que lo que el micro oye de ellos
        barge_db, barge_n = (4.0, 10) if self.aec else (10.0, 12)
        live_end = self.src is None or self.live_pace     # se corta por silencio (y en pruebas a tiempo real)
        floor = -60.0
        on_count = 0
        pre = collections.deque(maxlen=10)        # 300 ms antes de que empiece a hablar
        phrase = None                             # bytearray de la frase en curso
        speech_frames = silence_frames = 0
        last_voice_t = time.time()
        last_partial = 0.0
        nframe = 0
        self.peak = 0.0
        vspeech, vframes, last_pt, backlog = False, 0, "", []      # modo Vosk puro
        while not self.stop.is_set():
            if ORPHAN["v"] or (self.src is None and os.getppid() != ppid):
                self.cancel.set(); self.stop.set(); break
            if time.time() - tmax0 > self.maxsec:
                break
            # --- siguiente trozo de 30 ms
            if data is not None:
                if pos >= len(data):
                    break
                fr = data[pos:pos + FRAME * 2]; pos += FRAME * 2
                if self.live_pace:
                    ahead = t0 + nframe * FRAME_S - time.time()
                    if ahead > 0:
                        time.sleep(ahead)
            else:
                if proc.poll() is not None:
                    break
                try:
                    b = proc.stdout.read(FRAME * 2 * 4)
                except Exception:
                    b = None
                if b:
                    buf.extend(b)
                if len(buf) < FRAME * 2:
                    time.sleep(0.01); continue
                fr = bytes(buf[:FRAME * 2]); del buf[:FRAME * 2]
            nframe += 1
            db = frame_db(fr)
            v = max(0.0, min(1.0, (db + 55) / 45))     # −55 dBFS → 0 · −10 dBFS → 1
            self.peak = max(self.peak, v)
            if self.tts.is_set():
                # Helpert habla: el turno no corre (ni el silencio ni el máximo) y su voz no abre frases
                if not was_tts:                 # empieza a hablar: se vuelve a aprender su eco
                    eref, tts_n, barge, was_tts = -90.0, 0, 0, True
                last_voice_t = tmax0 = time.time()
                if phrase is not None:          # lo que decías cuando empezó a hablar
                    self.finalize(phrase, speech_frames * FRAME_S, silence_frames * FRAME_S)
                    phrase = None; on_count = 0
                    emit("speech", on=False)
                floor = floor * 0.97 + db * 0.03 if db < floor + 8 else floor
                floor = min(max(floor if db >= floor else db * 0.4 + floor * 0.6, -80.0), -32.0)
                tpre.append(fr)
                tts_n += 1
                # tu voz tiene que pasar al eco (sus picos) y al ruido; los primeros 0,8 s solo se aprende el eco
                loud = tts_n > 26 and db > max(floor + 11, -50.0, eref) + barge_db
                if not loud and not barge:      # sube al momento mientras aprende; luego despacio (10 dB/s), que el
                    eref = (db if tts_n <= 26 else min(db, eref + 0.3)) if db > eref else eref - 0.05   # arranque de tu voz no lo tape
                barge = barge + 1 if loud else max(0, barge - 1)     # entre sílabas baja poco
                if barge >= barge_n:
                    self.tts.clear(); barge = 0
                    emit("barge")
                    # lo que llevas dicho hasta que se notó: va delante de la frase
                    if self.eng is not None and self.eng is self.vosk:
                        backlog.extend(tpre)
                    else:
                        pre = collections.deque(tpre, maxlen=50)
                    tpre.clear()
                continue
            was_tts = False
            if nframe % 2 == 0:
                emit("level", v=round(v, 3), t=round(nframe * FRAME_S, 1))
            # --- VAD por energía con suelo de ruido adaptable
            thr_on = max(floor + 11, -50.0)
            thr_off = thr_on - 4
            if self.eng is not None and self.eng is self.vosk:
                # Vosk puro: todo el audio va al reconocedor, que da las palabras al momento y cierra las frases
                voiced = db > (thr_off if vspeech else thr_on)
                if not vspeech:
                    floor = floor * 0.97 + db * 0.03 if db < floor + 8 else floor
                    floor = min(max(floor if db >= floor else db * 0.4 + floor * 0.6, -80.0), -32.0)
                if voiced:
                    last_voice_t = time.time()
                    if not vspeech:
                        vspeech = True; emit("speech", on=True)
                    vframes += 1
                elif vspeech and time.time() - last_voice_t > 0.4:
                    vspeech = False; emit("speech", on=False)
                backlog.append(fr)
                if not self.ready.is_set() or self.errors:
                    if self.errors:
                        break
                    continue
                for b in backlog:
                    done, pt = self.vosk.stream(b)
                    if done is not None:
                        pid = self.phrase_id + 1
                        self.closed = pid; self.phrase_id = pid      # sus provisionales tardíos ya no se teclean
                        with self.cv:
                            self.partial_job = None
                        if done or self.shown:                      # (vacía con algo tecleado: settle lo borra)
                            self.jobs.put((pid, b"", vframes * FRAME_S, last_voice_t, done))
                        if done:
                            self.phrases_heard += 1
                        vframes = 0; last_pt = ""
                        if self.kind == "comando" and done:
                            self.stop.set()
                    elif pt and pt != last_pt and self.live:
                        last_pt = pt
                        emit("partial", text=pt)
                        if self.vosk.name == "nemotron":            # se teclea en otro hilo: no frena el audio
                            with self.cv:
                                self.partial_job = (self.phrase_id + 1, pt)
                backlog.clear()
                if (self.mode == "continuo" or self.kind == "comando") and live_end:
                    limit = self.silence if (self.phrases_heard or self.cmd_done) else (self.wait0 or max(self.silence, 8.0 if self.kind == "dictado" else 6.0))
                    if time.time() - last_voice_t > limit and self.jobs.empty() and not self.busy and not last_pt:
                        break
                continue
            if phrase is None:
                floor = floor * 0.97 + db * 0.03 if db < floor + 8 else floor
                floor = min(max(floor if db >= floor else db * 0.4 + floor * 0.6, -80.0), -32.0)
                pre.append(fr)
                on_count = on_count + 1 if db > thr_on else 0
                if on_count >= 3:
                    phrase = bytearray(b"".join(pre)); pre.clear()
                    speech_frames, silence_frames = on_count, 0
                    self.phrase_id += 1
                    last_partial = time.time()
                    emit("speech", on=True)
                    if self.vosk:
                        self.vosk_text = self.vosk.feed(phrase) if self.ready.is_set() and not self.errors else ""
                elif self.mode == "continuo" or self.kind == "comando":
                    limit = self.silence if (self.phrases or self.cmd_done) else (self.wait0 or max(self.silence, 8.0 if self.kind == "dictado" else 6.0))
                    if live_end and time.time() - last_voice_t > limit and self.jobs.empty() and not self.busy:
                        break
                continue
            phrase.extend(fr)
            if self.vosk and self.ready.is_set() and not self.errors:
                pt = self.vosk.feed(fr)
                if pt and pt != getattr(self, "vosk_text", "") and self.live:
                    self.vosk_text = pt
                    emit("partial", text=pt)
                    self.show(self.phrase_id, pt)
            if db > thr_off:
                speech_frames += 1; silence_frames = 0
                last_voice_t = time.time()
            else:
                silence_frames += 1
            plen = len(phrase) / 2 / RATE
            end = silence_frames * FRAME_S >= self.pause
            force = plen >= 20.0
            if end or force:
                cut = len(phrase) - max(0, silence_frames - 7) * FRAME * 2 if end else len(phrase)
                self.finalize(phrase[:cut], speech_frames * FRAME_S, silence_frames * FRAME_S)
                phrase = None; on_count = 0
                emit("speech", on=False)
                if self.kind == "comando":
                    break                            # una orden = una frase
                continue
            # lo provisional: cada 0,6 s de voz nueva si el motor está libre
            # (no si ya empieza una pausa: la frase va a cerrarse y el provisional solo retrasaría el texto final)
            if self.live and not self.vosk and time.time() - last_partial > self.partial_every and plen > 0.5 \
                    and silence_frames * FRAME_S < 0.15:
                with self.cv:
                    if self.partial_free():
                        self.partial_job = (self.phrase_id, bytes(phrase))
                        last_partial = time.time()
        if phrase is not None and not self.cancel.is_set() and speech_frames >= 8:
            self.finalize(phrase, speech_frames * FRAME_S, silence_frames * FRAME_S)
        if self.eng is not None and self.eng is self.vosk:
            self.ready.wait(timeout=60)         # desde un archivo el audio se acaba antes de que cargue el motor
        # una orden = una frase: con la orden ya oída, lo que siguiera a medias no se manda como otra
        if self.eng is not None and self.eng is self.vosk and self.ready.is_set() and not self.errors and not self.cancel.is_set() \
                and not (self.kind == "comando" and self.phrases_heard):
            for b in backlog:
                done, _ = self.vosk.stream(b)
                if done:
                    self.jobs.put((0, b"", vframes * FRAME_S, last_voice_t, done))
            rest = self.vosk.flush()                    # lo último que quedaba a medias
            if rest:
                self.jobs.put((0, b"", vframes * FRAME_S, last_voice_t, rest))
        self.capture_done.set()
        if proc:
            try:
                proc.send_signal(signal.SIGINT); proc.wait(timeout=2)
            except Exception:
                proc.kill()

    def finalize(self, pcm, speech_s, trail_s=0.0):
        pid = self.phrase_id
        self.closed = pid
        if speech_s < 0.24:
            self.settle(); return
        with self.cv:
            self.partial_job = None
        if self.vosk and self.eng is self.vosk:
            self.vosk_final[pid] = self.vosk.final() if self.ready.is_set() and not self.errors else ""
        elif self.vosk:
            self.vosk.final()
        self.jobs.put((pid, bytes(pcm), speech_s, time.time() - trail_s))     # trail_s: silencio tras la última palabra

def wake_split(text, s):
    """(es orden, resto) con la palabra de activación de hf-voice."""
    try:
        import importlib.machinery, importlib.util
        ld = importlib.machinery.SourceFileLoader("hf_voice", str(ROOT / "scripts/hf-voice"))
        spec = importlib.util.spec_from_loader("hf_voice", ld)
        mod = importlib.util.module_from_spec(spec); ld.exec_module(mod)
        return mod.wake_split(text, s.get("dictationWakeWord"), s)
    except Exception:
        return False, text

# ---------------------------------------------------------------- transcribir un archivo
def transcribe_file(wav, s=None):
    s = s or settings()
    e = engine(s)
    eng = VoskEngine(s) if e == "vosk" else NemotronEngine(s) if e == "nemotron" else FasterWhisperEngine(s) if e == "faster-whisper" else ParakeetEngine(s) if e == "parakeet" else WhisperEngine(s)
    eng.start()
    try:
        return clean_out(eng.transcribe(file_pcm(wav), (s.get("dictationPrompt") or "").strip()))
    finally:
        eng.close()

# ---------------------------------------------------------------- modelos
def _fetch(url, dst, name, tty=False, mb=0):
    tmp = dst.with_suffix(dst.suffix + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": "hyprfrijol"})
    with urllib.request.urlopen(req, timeout=30) as r, open(tmp, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0) or mb * 1_000_000
        got, last, t0 = 0, -1, time.time()
        while True:
            b = r.read(1 << 18)
            if not b:
                break
            f.write(b); got += len(b)
            pct = min(100, int(got * 100 / max(1, total)))
            if pct != last:
                last = pct
                if tty:
                    bar = "█" * (pct // 4) + "░" * (25 - pct // 4)
                    sp = got / 1e6 / max(0.1, time.time() - t0)
                    sys.stdout.write(f"\r  {bar} {pct:3d} %  {got / 1e6:6.0f} / {total / 1e6:.0f} MB  {sp:4.1f} MB/s "); sys.stdout.flush()
                else:
                    emit("progress", model=name, pct=pct, mb=round(got / 1e6), total=round(total / 1e6))
    if tty:
        print()
    if got < 1_000_000:
        tmp.unlink(missing_ok=True)
        raise RuntimeError("descarga incompleta")
    tmp.replace(dst)

def download(name, tty=False):
    try:
        DATA.mkdir(parents=True, exist_ok=True)
        if name in MODELS:
            dst = model_path(name)
            _fetch(os.environ.get("HF_WHISPER_URL") or URL.format(MODELS[name][2]), dst, name, tty, MODELS[name][0])
            emit("done", model=name, path=str(dst)) if not tty else print(f"  Listo: {dst}")
            return 0
        if name in VOSK_MODELS:
            vd = DATA / "vosk"; vd.mkdir(parents=True, exist_ok=True)
            z = vd / f"{name}.zip"
            _fetch(VOSK_URL.format(name), z, name, tty, VOSK_MODELS[name][0])
            with zipfile.ZipFile(z) as zf:          # solo rutas dentro de la carpeta del modelo
                for m in zf.infolist():
                    p = pathlib.PurePosixPath(m.filename)
                    if p.is_absolute() or ".." in p.parts or not p.parts or p.parts[0] != name:
                        continue
                    zf.extract(m, vd)
            z.unlink(missing_ok=True)
            if not vosk_installed(name):
                raise RuntimeError("el zip no traía el modelo")
            emit("done", model=name, path=str(vosk_path(name))) if not tty else print(f"  Listo: {vosk_path(name)}")
            return 0
        raise RuntimeError(f"Modelo desconocido: {name}")
    except Exception as e:
        if tty:
            print(f"  No se pudo descargar: {e}")
        else:
            emit("error", model=name, msg=f"No se pudo descargar: {e}")
        return 1

def delete(name):
    if name in MODELS:
        model_path(name).unlink(missing_ok=True)
        server_stop(name)
    elif name in VOSK_MODELS and vosk_path(name).is_dir():
        shutil.rmtree(vosk_path(name))

def manage():
    """Menú de la terminal: descargar y borrar modelos (fuentes oficiales)."""
    while True:
        st = status()
        rows = [("whisper", m) for m in st["models"]] + [("vosk", m) for m in st["voskModels"]]
        print("\n\033[1mModelos de dictado de HyprFrijol\033[0m  ·  " + str(DATA))
        print("  whisper.cpp: huggingface.co/ggerganov/whisper.cpp   ·   Vosk: alphacephei.com/vosk/models\n")
        for i, (k, m) in enumerate(rows, 1):
            mark = "\033[32m✔ descargado\033[0m" if m["installed"] else "  —"
            cur = " (en uso)" if m["name"] in (st["model"], st["voskModel"]) else ""
            print(f"  {i:2d}. {k:7s} {m['name']:26s} {m['mb']:5d} MB  {mark}{cur}\n       {m['desc']}")
        if not st["vosk"]:
            print("\n  Vosk necesita su módulo de Python (Arch: paquete python-vosk; otras: pipx/venv, ver hf-deps explain vosk).")
        try:
            a = input("\nNúmero para descargar (o «b N» para borrar, Intro para salir): ").strip()
        except EOFError:
            return 0
        if not a:
            return 0
        rm = a.lower().startswith("b")
        try:
            k, m = rows[int(a.split()[-1]) - 1]
        except Exception:
            print("  No entiendo esa opción"); continue
        if rm:
            delete(m["name"]); print(f"  Borrado {m['name']}")
        elif m["installed"]:
            print("  Ya está descargado")
        else:
            print(f"\n  Descargando {m['name']}…")
            download(m["name"], tty=True)

# ---------------------------------------------------------------- órdenes
def main(argv):
    cmd = argv[0] if argv else ""
    flags = argv[1:]
    def opt(name):
        return flags[flags.index(name) + 1] if name in flags and flags.index(name) + 1 < len(flags) else None
    if cmd == "_server":
        server_daemon(argv[1], argv[2], int(argv[3])); return
    if cmd == "record":
        s = settings()
        # Vosk instalado con pip en su venv: hf-dictate sigue en ese python (allí está el módulo)
        if engine(s) in ("vosk", "hibrido") and not vosk_here() and vosk_venv_python() and not os.environ.get("HF_DICTATE_REEXEC"):
            os.environ["HF_DICTATE_REEXEC"] = "1"
            py = vosk_venv_python()
            os.execv(py, [py, os.path.abspath(__file__)] + argv)
        src = None
        if opt("--file"):
            try:
                src = file_pcm(opt("--file"))
            except Exception as e:
                emit("error", msg=str(e)); sys.exit(1)
        ses = Session(s, kind="comando" if "--command" in flags else "dictado", mode=opt("--mode"),
                      hold="--hold" in flags, src=src, live_pace="--simulate-live" in flags, tts="--tts" in flags)
        try:
            rc = ses.run()
        finally:
            clip_restore()
        sys.exit(rc)
    if cmd == "aec":
        print(json.dumps(aec((argv[1:2] or ["status"])[0]), ensure_ascii=False)); return
    if cmd in ("stop", "cancel"):
        pid = running_pid()
        if pid:
            os.kill(pid, signal.SIGUSR1 if cmd == "stop" else signal.SIGUSR2)
        sys.exit(0 if pid else 1)
    if cmd == "toggle":
        pid = running_pid()
        if pid:
            os.kill(pid, signal.SIGUSR1); return
        # sin el shell: los eventos van a notificaciones
        p = subprocess.Popen([sys.argv[0], "record", "--mode", "toggle"] + (["--command"] if "--command" in flags else []),
                             stdout=subprocess.PIPE, stdin=subprocess.DEVNULL, text=True, start_new_session=True)
        notify("Escuchando…", "Vuelve a pulsar el atajo para terminar")
        for line in p.stdout:
            try:
                j = json.loads(line)
            except Exception:
                continue
            if j["ev"] == "error":
                notify("Dictado", j.get("msg", ""), urgent=True)
            elif j["ev"] == "cmdresult":
                notify(j.get("label") or "Orden", j.get("msg", ""), urgent=not j.get("ok"))
            elif j["ev"] == "done" and j.get("how") == "copiado":
                notify("Texto copiado", "Pégalo con Ctrl+V")
        return
    if cmd == "status":
        print(json.dumps(status(), ensure_ascii=False)); return
    if cmd == "warm":
        s = settings()
        m, lm = s.get("dictationModel") or "base", live_model(s)
        server_stop(keep=(m, lm))
        out = {}
        for mm in dict.fromkeys((m, lm)):
            port = server_ensure(mm, langs_of(s.get("dictationLang") or "es+en")[0], max(30, int(s.get("dictationKeepLoaded") or 600)))
            out[mm] = {"ok": bool(port), **(load(SRVFILE(mm), {}) or {})}
        print(json.dumps(out)); return
    if cmd == "unload":
        server_stop(); print(json.dumps({"ok": True})); return
    if cmd == "transcribe":
        print(transcribe_file(argv[1])); return
    if cmd == "finish":           # pruebas: como si se hubiera dictado este texto
        text = " ".join(argv[1:]).strip()
        how = output(text) if text else "nada"
        print(json.dumps({"text": text, "how": how}, ensure_ascii=False)); return
    if cmd == "output":
        print(output(" ".join(argv[1:]))); return
    if cmd == "download":
        names = [a for a in flags if not a.startswith("--")] or ["base"]
        sys.exit(max(download(n, tty="--tty" in flags) for n in names))
    if cmd == "install-vosk":
        sys.exit(install_vosk())
    if cmd == "install-parakeet":
        sys.exit(install_parakeet(tty="--tty" in flags))
    if cmd == "install-nemotron":
        sys.exit(install_nemotron(tty="--tty" in flags))
    if cmd == "manage":
        sys.exit(manage())
    if cmd == "delete":
        delete(argv[1] if len(argv) > 1 else ""); return
    if cmd == "last":
        try:
            print((STATE / "dictation-last.txt").read_text().strip())
        except Exception:
            pass
        return
    print(__doc__)
    sys.exit(0 if cmd in ("-h", "--help") else 1)

if __name__ == "__main__":
    main(sys.argv[1:])
