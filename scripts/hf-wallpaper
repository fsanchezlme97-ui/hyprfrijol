#!/usr/bin/env bash
# hf-wallpaper — cambia el fondo (fundido en Quickshell) y regenera los colores con matugen
#   hf-wallpaper <archivo>        usa ese archivo (imagen o vídeo) en todas las pantallas
#   hf-wallpaper -o DP-1 <arch>   solo en esa pantalla (no cambia los colores); -o DP-1 reset la quita
#   hf-wallpaper next|prev        siguiente / anterior de la carpeta de fondos
#   hf-wallpaper random           uno al azar
#   hf-wallpaper hora             el de la hora del día (06 amanecer · 10 bruma · 17:30 lago · 20 noche)
#   hf-wallpaper restore          vuelve a poner el último (al iniciar sesión)
#   hf-wallpaper list             lista los fondos disponibles (tuyos + los de hyprfrijol)
#   hf-wallpaper thumbs           genera las miniaturas (~/.cache/hyprfrijol/thumbs) y las lista "fondo<TAB>miniatura"
#   hf-wallpaper gallery          para el selector: la lista al momento y luego las miniaturas que falten (en paralelo),
#                                 con resolución, colores dominantes y origen (incluido · mio · wallhaven)
#   hf-wallpaper vthumbs          lo mismo, solo de los fondos animados (vídeos y GIF): primer cuadro con
#                                 ffmpegthumbnailer o ffmpeg
#   hf-wallpaper add <archivo…>   copia imágenes/vídeos a tu carpeta de fondos (imprime la ruta de cada copia)
#   hf-wallpaper pick-animated    elige un vídeo/GIF (zenity), lo copia a la carpeta y lo pone de fondo
#   hf-wallpaper deps             qué hay instalado para los fondos animados: "mpvpaper 1", "ffmpeg 0"…
#   hf-wallpaper wallhaven …      lo mismo que scripts/hf-wallhaven (buscar, caché, añadir a mis fondos); con
#                                 wallpaperSource = "wallhaven", next/random traen uno nuevo de wallhaven.cc
# Fondos animados: .mp4 .webm .mkv .mov .gif en bucle con mpvpaper (sin sonido, a wallpaperFps). El color sale del
#   primer cuadro. Shell (Wallpaper.qml) los pausa según wallpaperPauseOn (batería, pantalla completa…) con
#   SIGSTOP al pid guardado en ~/.local/state/hyprfrijol/motion.pid (solo el de esta sesión).
# Carpeta: $HF_WALL_DIR, o ~/Imágenes/Fondos, o ~/Imágenes/Wallpapers; si está vacía, los de assets/wallpapers.
# Esquema de color: $HF_SCHEME (p. ej. scheme-monochrome, scheme-neutral). Por defecto scheme-tonal-spot.
# Ajustes › Fondos: wallpaperMotion (false → los vídeos/escenas se quedan quietos en su primer cuadro),
#   wallpaperMotionKind ("video" → mpvpaper · "escena" → carpetas de Wallpaper Engine con linux-wallpaperengine),
#   wallpaperFps (límite de cuadros), wallpaperTransition ("ninguna" → sin fundido).
set -euo pipefail

for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
ROOT="${HF_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
STATE="$HOME/.local/state/hyprfrijol"
THUMBS="$HOME/.cache/hyprfrijol/thumbs"
SCALED="$HOME/.cache/hyprfrijol/wallpapers-scaled"
ASSETS="$ROOT/assets/wallpapers"
mkdir -p "$STATE"

PICS="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
if [ -n "${HF_WALL_DIR:-}" ]; then DIR="$HF_WALL_DIR"
elif [ -d "$PICS/Fondos" ]; then DIR="$PICS/Fondos"
elif [ -d "$PICS/Wallpapers" ]; then DIR="$PICS/Wallpapers"
else DIR="$PICS/Fondos"; fi

findw() { [ -d "$1" ] || return 0   # sin la carpeta (instalación nueva), find fallaría y con pipefail cortaría el script
  find "$1" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \
  -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.gif' \) 2>/dev/null | sort; }
# Fondo animado (vídeo o GIF)
is_motion() { case "${1,,}" in *.mp4|*.webm|*.mkv|*.mov|*.gif) return 0 ;; esac; return 1; }

# Vídeo a la medida de la pantalla: un fondo 4K en una pantalla de 1200 px decodifica 4 veces los píxeles que se ven
# (CPU, GPU y ~200 MB de memoria en mpvpaper). La primera vez se convierte en segundo plano (prioridad mínima) a la
# altura de la pantalla más alta y a los fps elegidos; mientras tanto se usa el original y, al acabar, se cambia solo
# (de vídeo a vídeo, sin hueco). Caché: ~/.cache/hyprfrijol/wallpapers-scaled (se limpia sola a los 30 días sin uso).
# play_file <vídeo> <fps> → ruta a reproducir (la copia si ya existe, si no el original)
play_file() {
  local f="$1" fps="$2" mh vh vf out key
  [ "$(setting wallpaperScale true)" = false ] && { printf '%s' "$f"; return; }
  command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || { printf '%s' "$f"; return; }
  case "${f,,}" in *.gif) printf '%s' "$f"; return ;; esac
  mh="$(hyprctl monitors -j 2>/dev/null | jq '[.[] | if (.transform % 2) == 1 then .width else .height end] | max // 0')"
  [ "${mh:-0}" -gt 0 ] || { printf '%s' "$f"; return; }
  IFS=, read -r vh vf < <(ffprobe -v error -select_streams v:0 -show_entries stream=height,r_frame_rate -of csv=p=0 "$f" 2>/dev/null)
  vf="${vf:-30/1}"; vf=$(( ${vf%/*} / ${vf#*/} ))
  # Ya está bien (no más de un 15 % mayor que la pantalla y sin fps de sobra): el original
  if [ "${vh:-0}" -le $((mh * 115 / 100)) ] && [ "${vf:-0}" -le "$fps" ]; then printf '%s' "$f"; return; fi
  [ "${vh:-0}" -gt "$mh" ] || mh="$vh"
  [ "$vf" -lt "$fps" ] && fps="$vf"
  key="$(printf '%s|%s' "$f" "$(stat -c %Y "$f" 2>/dev/null)" | md5sum | cut -c1-16)"
  out="$SCALED/$key-${mh}p$fps.mp4"
  if [ -s "$out" ]; then touch "$out"; printf '%s' "$out"; return; fi
  mkdir -p "$SCALED"
  find "$SCALED" -name '*.mp4' -atime +30 -delete 2>/dev/null || true
  # Una conversión por archivo; al acabar, si sigue siendo el fondo, se vuelve a poner (ya con la copia)
  ( exec 9>"$out.lock"; flock -n 9 || exit 0
    nice -n 19 ionice -c 3 ffmpeg -nostdin -y -loglevel error -i "$f" -an \
      -vf "scale=-2:$mh:flags=lanczos,fps=$fps" -c:v libx264 -preset medium -crf 19 -pix_fmt yuv420p \
      -movflags +faststart "$out.tmp.mp4" && mv "$out.tmp.mp4" "$out" || rm -f "$out.tmp.mp4"
    rm -f "$out.lock"
    [ -s "$out" ] && [ "$(cat "$STATE/wallpaper-path" 2>/dev/null)" = "$f" ] && HF_QUIET=1 "$0" restore >/dev/null 2>&1
  ) </dev/null >/dev/null 2>&1 8>&- &
  disown 2>/dev/null || true
  printf '%s' "$f"
}
# Primer cuadro de un vídeo/GIF a un PNG/JPG
first_frame() {   # first_frame <vídeo> <salida> [alto]
  if [ -n "${3:-}" ] && command -v ffmpegthumbnailer >/dev/null && [[ "${1,,}" != *.gif ]]; then
    ffmpegthumbnailer -i "$1" -o "$2" -s 854 -q 8 -t 10% 2>/dev/null && [ -s "$2" ] && return 0
  fi
  ffmpeg -y -loglevel error -i "$1" -frames:v 1 ${3:+-vf "scale=-2:$3"} "$2" 2>/dev/null && return 0
  command -v magick >/dev/null && magick "$1[0]" ${3:+-thumbnail "x$3"} "$2" 2>/dev/null
}
# El shell pausa el reproductor con SIGSTOP (wallpaperPauseOn): un proceso detenido no atiende SIGTERM hasta que se
# reanuda, así que cada kill va seguido de SIGCONT (si no, quedaba un mpvpaper parado para siempre).
# Para el reproductor del fondo animado de ESTA sesión (no los de otras sesiones gráficas ni de otros usuarios)
stop_motion() {   # stop_motion [pid que se conserva …]  (el reproductor nuevo, al cambiar de vídeo a vídeo)
  local p w keep=" $* "
  # Primero el vigilante (si no, relanzaría el reproductor que se va a cerrar)
  # Solo si el pid sigue siendo nuestro (tras reiniciar, el número guardado puede ser ya otro programa) y de esta
  # sesión de Hyprland (una sesión de prueba con el mismo HOME no debe cerrar el fondo de la de verdad)
  ours() { # ours <pid> <patrón de la línea de órdenes>
    tr '\0' ' ' 2>/dev/null < "/proc/$1/cmdline" | grep -qE "$2" || return 1
    [ "$(tr '\0' '\n' 2>/dev/null < "/proc/$1/environ" | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p')" = "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]
  }
  for p in ${OLD_WATCH-$(cat "$STATE/motion.watch" 2>/dev/null)}; do
    [[ "$keep" == *" $p "* ]] || { ours "$p" 'hf-wallpaper _motion' && kill "$p" 2>/dev/null || true; }
  done
  for p in ${OLD_PID-$(cat "$STATE/motion.pid" 2>/dev/null)}; do
    [[ "$keep" == *" $p "* ]] || { ours "$p" '^(mpvpaper|linux-wallpaperengine)|/(mpvpaper|linux-wallpaperengine) ' && { kill "$p"; kill -CONT "$p"; } 2>/dev/null || true; }
  done
  [ -n "${keep// /}" ] || rm -f "$STATE/motion.watch" "$STATE/motion.pid"
  # Los lanzados por versiones anteriores (sin pid guardado): solo los de nuestra pantalla Wayland
  for p in $(pgrep -u "$(id -u)" -x mpvpaper 2>/dev/null; pgrep -u "$(id -u)" -f '^linux-wallpaperengine ' 2>/dev/null); do
    # Misma instancia de Hyprland (la firma es única; WAYLAND_DISPLAY se repite en sesiones anidadas/de prueba)
    w="$(tr '\0' '\n' 2>/dev/null < "/proc/$p/environ" | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p')"
    [[ "$keep" == *" $p "* ]] && continue
    [ -n "$w" ] && [ "$w" = "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && { kill "$p"; kill -CONT "$p"; } 2>/dev/null || true
  done
}
# Los tuyos; si no hay ninguno, los de hyprfrijol. "list all" = los dos.
list() {
  local u; u="$(findw "$DIR")"
  if [ -n "$u" ]; then printf '%s\n' "$u"; [ "${1:-}" = all ] && findw "$ASSETS"; else findw "$ASSETS"; fi
  return 0
}
current() { cat "$STATE/wallpaper-path" 2>/dev/null || true; }
# Ajuste de settings.json (el del usuario manda sobre config/defaults); setting <clave> <por defecto>
setting() {
  local v f files=()
  for f in "$ROOT/config/defaults/settings.json" "$HOME/.config/hyprfrijol/settings.json"; do [ -s "$f" ] && files+=("$f"); done
  v="$(jq -nr --arg k "$1" '[inputs] | (.[0] // {}) + (.[1] // {}) | if has($k) and .[$k] != null then .[$k] | tostring else empty end' \
        "${files[@]}" 2>/dev/null)"
  printf '%s' "${v:-$2}"
}
# Escena de Wallpaper Engine: carpeta con project.json
is_scene() { [ -d "$1" ] && [ -f "$1/project.json" ]; }
scene_preview() {
  local p; p="$(jq -r '.preview // empty' "$1/project.json" 2>/dev/null)"
  [ -n "$p" ] && [ -f "$1/$p" ] && { printf '%s' "$1/$p"; return; }
  find "$1" -maxdepth 1 -type f -iname 'preview.*' | head -n1
}
step() {   # $1 = +1 / -1
  mapfile -t L < <(list); [ "${#L[@]}" -eq 0 ] && { echo "No hay fondos en $DIR" >&2; exit 1; }
  local cur i=-1 k; cur="$(current)"
  for k in "${!L[@]}"; do [ "${L[$k]}" = "$cur" ] && i=$k; done
  if [ "$i" -lt 0 ]; then i=0; else i=$(( (i + $1 + ${#L[@]}) % ${#L[@]} )); fi
  printf '%s' "${L[$i]}"
}
# Origen «Wallhaven» (Ajustes › Fondos, wallpaperSource): next/random piden uno nuevo a scripts/hf-wallhaven (caché con
# límite); sin red o sin resultados se sigue con la carpeta de siempre.
wh_next() {
  [ "$(setting wallpaperSource carpeta)" = wallhaven ] || return 1
  local f; f="$("$ROOT/scripts/hf-wallhaven" next 2>/dev/null)" || return 1
  [ -f "$f" ] || return 1
  printf '%s' "$f"
}
# Fondo según la hora (como en el diseño: 06:00 atardecer, 10:00 bruma, 17:30 lago, 20:00 noche)
by_hour() {
  local m=$(( 10#$(date +%H) * 60 + 10#$(date +%M) )) k
  if   [ $m -ge 1200 ] || [ $m -lt 360 ]; then k=noche
  elif [ $m -ge 1050 ]; then k=lago
  elif [ $m -ge 600 ];  then k=bruma
  else k=amanecer; fi
  # Si tienes un fondo propio que se llame igual (noche.jpg…), se usa ese
  local f; f="$(findw "$DIR" | grep -i "/$k\.[a-z0-9]*$" | head -n1 || true)"
  printf '%s' "${f:-$(findw "$ASSETS" | grep "/$k\." | head -n1)}"
}
thumb_path() { printf '%s/%s.jpg' "$THUMBS" "$(printf '%s' "$1" | md5sum | cut -c1-16)"; }
thumb_fresh() { [ -s "$2" ] && ! [ "$1" -nt "$2" ]; }   # thumb_fresh <fondo> <miniatura>
thumb_of() {   # ruta de la miniatura (se genera si falta o está desactualizada)
  local f="$1" t; t="$(thumb_path "$f")"
  if ! thumb_fresh "$f" "$t"; then
    if is_motion "$f"; then first_frame "$f" "$t" 480 || true
    # jpeg:size: libjpeg decodifica ya reducido (un 4K a la mitad), mucho más rápido que leerlo entero
    else magick -define jpeg:size=1708x960 "${f}[0]" -auto-orient -thumbnail 'x480^' -quality 85 "$t" 2>/dev/null || true; fi
  fi
  printf '%s' "$t"
}
# Datos de la galería (junto a la miniatura, <miniatura>.info): "ANCHOxALTO #rrggbb #rrggbb…" (resolución del
# original y los colores dominantes de la miniatura). Se rehace si la miniatura es más nueva.
info_of() {   # info_of <fondo> <miniatura>
  local f="$1" t="$2" i="$2.info" res cols
  if [ ! -s "$i" ] || [ "$t" -nt "$i" ]; then
    [ -s "$t" ] || return 0
    if is_motion "$f"; then
      res="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$f" 2>/dev/null | head -n1)"
    else res="$(magick identify -ping -format '%wx%h' "${f}[0]" 2>/dev/null)"; fi
    cols="$(magick "$t" -scale '64x36!' -colors 6 -depth 8 -format '%c' histogram:info:- 2>/dev/null \
            | sort -rn | grep -o '#[0-9A-Fa-f]\{6\}' | head -n4 | tr '\n' ' ')"
    printf '%s %s\n' "${res:-?}" "$cols" > "$i.tmp" && mv "$i.tmp" "$i"
  fi
  tr -d '\n' < "$i"
}
# Origen de un fondo para la galería: incluido (assets) · wallhaven (su caché) · mio (tu carpeta)
origin_of() { case "$1" in "$ASSETS"/*) echo incluido ;; "$HOME/.cache/hyprfrijol/wallhaven"/*) echo wallhaven ;; *) echo mio ;; esac; }
gallery_line() {   # fondo<TAB>miniatura<TAB>ANCHOxALTO<TAB>colores<TAB>origen
  local f="$1" t inf; t="$(thumb_path "$f")"; inf=""
  thumb_fresh "$f" "$t" && inf="$(info_of "$f" "$t")"
  printf '%s\t%s\t%s\t%s\t%s\n' "$f" "$t" "${inf%% *}" "$( [ -n "$inf" ] && printf '%s' "${inf#* }" )" "$(origin_of "$f")"
}
# Lista de la galería: tus fondos + los incluidos (+ la caché de Wallhaven si es el origen elegido)
gallery_list() {
  list all
  [ "$(setting wallpaperSource carpeta)" = wallhaven ] && [ -d "$HOME/.cache/hyprfrijol/wallhaven" ] \
    && find "$HOME/.cache/hyprfrijol/wallhaven" -maxdepth 1 -type f -name 'wallhaven-*' ! -name '*.part' 2>/dev/null | sort
  return 0
}
write_json() {   # actualiza wallpaper.json con un filtro de jq (atómico)
  local cur='{}'; [ -s "$STATE/wallpaper.json" ] && cur="$(cat "$STATE/wallpaper.json")"
  jq "$@" <<<"$cur" > "$STATE/wallpaper.json.tmp" && mv "$STATE/wallpaper.json.tmp" "$STATE/wallpaper.json"
}
FADE=1200; [ -f "$STATE/reduce-motion" ] && FADE=0
[ "$(setting wallpaperTransition fundido)" = ninguna ] && FADE=0

OUTPUT=""
if [ "${1:-}" = -o ]; then OUTPUT="${2:?falta la pantalla}"; shift 2; fi

case "${1:-next}" in
  next)    FILE="$(wh_next || step 1)" ;;
  prev)    FILE="$(step -1)" ;;
  random)  FILE="$(wh_next || true)"
           [ -n "$FILE" ] || FILE="$(list | grep -vxF "$(current)" | shuf -n1 || true)"; [ -n "$FILE" ] || FILE="$(list | head -n1)" ;;
  wallhaven) shift; exec "$ROOT/scripts/hf-wallhaven" "$@" ;;
  hora)    FILE="$(by_hour)"; [ -z "$OUTPUT" ] && [ "$FILE" = "$(current)" ] && exit 0 ;;
  restore) FILE="$(current)"; [ -f "$FILE" ] || is_scene "$FILE" || FILE="$(list | head -n1)" ;;
  list)    list all; exit 0 ;;
  thumbs)  mkdir -p "$THUMBS"
           # las que faltan, en paralelo; luego la lista
           while IFS= read -r f; do thumb_fresh "$f" "$(thumb_path "$f")" || printf '%s\0' "$f"; done < <(list all) \
             | xargs -0 -r -P "$(nproc 2>/dev/null || echo 4)" -n1 "$0" _thumb >/dev/null
           while IFS= read -r f; do printf '%s\t%s\n' "$f" "$(thumb_path "$f")"; done < <(list all); exit 0 ;;
  # Para el selector de fondos: primero la lista entera al momento (sin esperar a las miniaturas que falten; sus
  # columnas de datos van vacías), una línea "." y después, según se generan en paralelo, otra vez la línea de cada
  # fondo que faltaba, ya con su miniatura. Formato: fondo<TAB>miniatura<TAB>ANCHOxALTO<TAB>colores<TAB>origen
  gallery) mkdir -p "$THUMBS"; mapfile -t L < <(gallery_list); MISS=()
           for f in "${L[@]}"; do gallery_line "$f"; thumb_fresh "$f" "$(thumb_path "$f")" || MISS+=("$f"); done
           echo .
           [ "${#MISS[@]}" -gt 0 ] && printf '%s\0' "${MISS[@]}" | xargs -0 -r -P "$(nproc 2>/dev/null || echo 4)" -n1 "$0" _gline
           exit 0 ;;
  _gline)  thumb_of "$2" >/dev/null; gallery_line "$2"; exit 0 ;;
  # Vigilante del fondo en vídeo: mpvpaper se cierra si desaparece una pantalla (al entrar, una salida que se enciende
  # un instante y se apaga; el monitor que se desconecta al ahorrar energía…). Con vídeo el shell no pinta la imagen,
  # así que sin reproductor el escritorio se quedaría negro: se relanza y, si no hay manera, se vuelve a la imagen fija.
  _motion) F="$2"; FPS="$3"; SOCK="${4:-}"; PLAY="${5:-$2}"; fails=0; first=1
           while :; do
             [ "$first" = 1 ] || sleep 2
             first=0
             [ "$(current)" = "$F" ] || exit 0                     # ya hay otro fondo
             # La sesión se cerró (mpvpaper se va con ella): nada que relanzar, y sin esto a los 5 intentos marcaba el
             # fondo como «sin vídeo»
             timeout 3 hyprctl version >/dev/null 2>&1 || exit 0
             setsid mpvpaper -o "no-audio loop panscan=1.0 hwdec=auto-safe vf=fps=$FPS${SOCK:+ input-ipc-server=$SOCK}" '*' "$PLAY" >/dev/null 2>&1 &
             MP=$!; echo "$MP" > "$STATE/motion.pid"; started=$SECONDS
             wait "$MP" 2>/dev/null || true
             [ "$(cat "$STATE/motion.pid" 2>/dev/null)" = "$MP" ] || exit 0   # lo cerró hf-wallpaper (otro fondo, sin movimiento)
             [ $((SECONDS - started)) -ge 30 ] && fails=0
             fails=$((fails + 1))
             if [ "$fails" -ge 5 ]; then
               rm -f "$STATE/motion.pid" "$STATE/motion.watch"
               write_json '.video = false | .changed = now'
               echo "mpvpaper se cerró $fails veces seguidas: queda la imagen fija" >&2
               exit 1
             fi
           done ;;
  _thumb)  thumb_of "$2" >/dev/null; exit 0 ;;
  vthumbs) mkdir -p "$THUMBS"; while IFS= read -r f; do is_motion "$f" && printf '%s\t%s\n' "$f" "$(thumb_of "$f")"; done < <(list all); exit 0 ;;
  thumb)   mkdir -p "$THUMBS"; thumb_of "$(readlink -f "$2")"; echo; exit 0 ;;
  add)     shift; mkdir -p "$DIR"; for f in "$@"; do cp -n -- "$f" "$DIR/"; printf '%s\n' "$DIR/$(basename -- "$f")"; done; exit 0 ;;
  deps)    for b in mpvpaper ffmpeg ffmpegthumbnailer linux-wallpaperengine; do printf '%s %s\n' "$b" "$(command -v "$b" >/dev/null && echo 1 || echo 0)"; done; exit 0 ;;
  pick-animated)
    F=""
    if command -v zenity >/dev/null; then
      F="$(zenity --file-selection --title='Añadir fondo animado' --file-filter='Vídeos y GIF | *.mp4 *.webm *.mkv *.mov *.gif *.MP4 *.WEBM *.MKV *.MOV *.GIF' 2>/dev/null)" || exit 1
    else echo "Instala zenity para elegir el archivo (o copia el vídeo a $DIR)" >&2; exit 1; fi
    [ -f "$F" ] && is_motion "$F" || { echo "Elige un vídeo (.mp4, .webm, .mkv, .mov) o un GIF" >&2; exit 1; }
    mkdir -p "$DIR"; cp -n -- "$F" "$DIR/"
    exec "$0" "$DIR/$(basename -- "$F")" ;;
  reset)   [ -n "$OUTPUT" ] && write_json --arg o "$OUTPUT" '.monitors = ((.monitors // {}) | del(.[$o]))'; exit 0 ;;
  -h|--help) sed -n '2,27p' "$0"; exit 0 ;;
  *)       FILE="$(readlink -f "$1")" ;;
esac
[ -n "$FILE" ] && { [ -f "$FILE" ] || is_scene "$FILE"; } || { echo "No hay fondo que poner (${FILE:-vacío}). Pon imágenes en $DIR" >&2; exit 1; }

# Solo una pantalla: no toca los colores ni el fondo global
if [ -n "$OUTPUT" ]; then
  IMG="$FILE"
  is_motion "$FILE" && { IMG="$STATE/video-frame-$OUTPUT.png"; first_frame "$FILE" "$IMG"; }
  is_scene "$FILE" && IMG="$(scene_preview "$FILE")"
  write_json --arg o "$OUTPUT" --arg i "$IMG" --argjson f "$FADE" '.monitors = ((.monitors // {}) + {($o): $i}) | .fadeMs = $f | .changed = now'
  exit 0
fi

# "Reducir movimiento" (accesibilidad) desactiva el fundido y los fondos de vídeo
# y también el ajuste «Fondos en movimiento» (wallpaperMotion = false)
NO_MOTION=0; [ -f "$STATE/reduce-motion" ] && NO_MOTION=1
[ "$(setting wallpaperMotion true)" = false ] && NO_MOTION=1
FPS="$(setting wallpaperFps 30)"; case "$FPS" in ''|*[!0-9]*) FPS=30 ;; esac

# Sin hueco negro al cambiar: el reproductor anterior sigue hasta que el nuevo ya pinta, y mientras tanto el shell
# enseña la imagen (o el primer fotograma) del nuevo. Con vídeo la capa del shell es transparente, así que cerrar
# mpvpaper antes de tener el siguiente dejaba el escritorio en negro (y a veces el clic siguiente no lo arreglaba).
# Un cambio de fondo cada vez: dos seguidos (doble clic, Aplicar + atajo…) se pisaban motion.pid y podían dejar un
# reproductor huérfano o el escritorio en la imagen fija. Lo que se lanza en segundo plano cierra el fd 8 (8>&-).
exec 8>"${XDG_RUNTIME_DIR:-/tmp}/hf-wallpaper-$(id -u).lock"; flock -w 12 8 || true
OLD_WATCH="$(cat "$STATE/motion.watch" 2>/dev/null || true)"; OLD_PID="$(cat "$STATE/motion.pid" 2>/dev/null || true)"
IMG="$FILE"; VIDEO=false; MOTION=""
if is_scene "$FILE"; then
  IMG="$(scene_preview "$FILE")"
  [ -n "$IMG" ] || { echo "La escena $FILE no tiene imagen de vista previa" >&2; exit 1; }
  case "${IMG,,}" in *.gif|*.mp4|*.webm) rm -f "$STATE/video-frame.src"; ffmpeg -y -loglevel error -i "$IMG" -frames:v 1 "$STATE/video-frame.png" && IMG="$STATE/video-frame.png" ;; esac
  [ "$NO_MOTION" = 0 ] && [ "$(setting wallpaperMotionKind video)" = escena ] && command -v linux-wallpaperengine >/dev/null && MOTION=escena
elif is_motion "$FILE"; then
  IMG="$STATE/video-frame.png"
  # Mismo vídeo que la última vez (al iniciar sesión, casi siempre): el fotograma ya está. Sacarlo de un 4K cuesta
  # ~1 s de CPU y escribe un PNG de varios MB en cada arranque.
  FSTAMP="$(stat -Lc '%n %s %Y' -- "$FILE" 2>/dev/null)"
  if [ -s "$IMG" ] && [ -n "$FSTAMP" ] && [ "$(cat "$STATE/video-frame.src" 2>/dev/null)" = "$FSTAMP" ]; then :
  else first_frame "$FILE" "$IMG" && printf '%s' "$FSTAMP" > "$STATE/video-frame.src"; fi
  if [ "$NO_MOTION" = 0 ] && command -v mpvpaper >/dev/null; then MOTION=video
  elif [ "$NO_MOTION" = 0 ]; then
    echo "Para que se mueva instala mpvpaper (Ajustes › Fondos de pantalla); de momento queda quieto." >&2
  fi
fi

printf '%s\n' "$FILE" > "$STATE/wallpaper-path"
ln -sf "$IMG" "$STATE/current-wallpaper"      # lo usan hyprlock y el login
# Quickshell vigila este archivo y hace el fundido ("monitors" = fondos por pantalla, se conservan). Primero la
# imagen fija (o el primer fotograma), con el shell opaco.
# De vídeo a vídeo el shell no se mete: el reproductor nuevo se abre encima del viejo (Hyprland apila por orden de
# aparición y sin su primer cuadro no tapa nada), y el viejo se cierra cuando el nuevo ya pinta. Pasar por la imagen
# fija dejaba ver a medio fundido el vídeo anterior o negro.
V2V=0
if [ "$MOTION" = video ] && [ "$(jq -r '.video // false' "$STATE/wallpaper.json" 2>/dev/null)" = true ] \
   && [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then V2V=1; fi
if [ "$V2V" = 1 ]; then
  write_json --arg image "$IMG" --argjson fade "$FADE" '.image = $image | .video = true | .fadeMs = $fade | .changed = now'
else
  write_json --arg image "$IMG" --argjson fade "$FADE" '.image = $image | .video = false | .fadeMs = $fade | .changed = now'
fi

if [ -z "$MOTION" ]; then
  stop_motion
else
  NEW=""
  if [ "$MOTION" = escena ]; then
    ARGS=(--silent --fps "$FPS")
    while read -r MON; do ARGS+=(--screen-root "$MON"); done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name')
    setsid linux-wallpaperengine "${ARGS[@]}" --bg "$FILE" >/dev/null 2>&1 8>&- &
    NEW=$!; echo "$NEW" > "$STATE/motion.pid"; KEEP="$NEW"
  else
    # sin sonido, en bucle, recortado a la pantalla; hwdec si hay; el shell lo pausa (SIGSTOP) según wallpaperPauseOn.
    # Lo lanza el vigilante (_motion), que guarda el pid de mpvpaper en motion.pid y lo relanza si se cae.
    SOCK="${XDG_RUNTIME_DIR:-/tmp}/hf-mpv-${HYPRLAND_INSTANCE_SIGNATURE:-x}.sock"; rm -f "$SOCK"
    PLAY="$(play_file "$FILE" "$FPS")"
    setsid "$0" _motion "$FILE" "$FPS" "$SOCK" "$PLAY" >/dev/null 2>&1 8>&- &
    W=$!; echo "$W" > "$STATE/motion.watch"; KEEP="$W"
  fi
  # Esperar (hasta 8 s) a que el reproductor nuevo PINTE de verdad: tener su capa no basta (antes de su primer
  # cuadro no enseña nada y, al volverse transparente el shell, asomaba el vídeo anterior o negro). Con mpv se le
  # pregunta por su socket cuántos cuadros lleva; la escena (linux-wallpaperengine) solo se espera por su capa.
  for _ in $(seq 80); do
    NEW="$(cat "$STATE/motion.pid" 2>/dev/null || true)"
    if [ -n "$NEW" ] && [ "$NEW" != "$OLD_PID" ] \
       && hyprctl layers -j 2>/dev/null | jq -e --argjson p "$NEW" '[.[] | .levels[][] | select(.pid == $p)] | length > 0' >/dev/null 2>&1; then
      if [ "$MOTION" = video ] && [ -S "${SOCK:-}" ]; then
        frames="$(python3 -I -c 'import json,socket,sys
s=socket.socket(socket.AF_UNIX); s.settimeout(0.4); s.connect(sys.argv[1])
s.sendall(b"{\"command\":[\"get_property\",\"estimated-frame-number\"]}\n")
print(int(json.loads(s.recv(4096).split(b"\n")[0]).get("data") or 0))' "$SOCK" 2>/dev/null || echo 0)"
        [ "${frames:-0}" -ge 3 ] && { sleep 0.1; break; }
      else
        sleep 0.35; break
      fi
    fi
    sleep 0.1
  done
  # Fuera el anterior MIENTRAS el shell aún tapa con la imagen fija, y solo después se descubre el nuevo: así nunca
  # se ve un hueco ni el vídeo viejo un instante
  NEW="$(cat "$STATE/motion.pid" 2>/dev/null || true)"
  stop_motion $KEEP $NEW
  write_json '.video = true | .changed = now'
  VIDEO=true
fi

# Colores
if command -v matugen >/dev/null; then
  sed -e "s#@ROOT@#$ROOT#g" -e "s#@STATE@#$STATE#g" "$ROOT/config/matugen/config.toml" > "$STATE/matugen.toml"
  # Misma imagen, esquema y plantilla que la última vez (restore al iniciar sesión): la paleta ya está hecha
  MSTAMP="$(stat -Lc '%n %s %Y' -- "$IMG" "$ROOT/config/matugen/config.toml" "$ROOT/config/matugen/templates/colors.json" 2>/dev/null | tr '\n' ' ')${HF_SCHEME:-scheme-tonal-spot}"
  if [ -s "$STATE/colors.json" ] && [ "$(cat "$STATE/matugen.src" 2>/dev/null)" = "$MSTAMP" ]; then :
  elif matugen image "$IMG" -c "$STATE/matugen.toml" -m dark -t "${HF_SCHEME:-scheme-tonal-spot}" --source-color-index 0 >"$STATE/matugen.log" 2>&1; then
    printf '%s' "$MSTAMP" > "$STATE/matugen.src"
  else
    echo "matugen falló, mira $STATE/matugen.log" >&2
  fi
fi
"$ROOT/scripts/hf-apply" 8>&- || true   # tema → Quickshell, Hyprland, hyprlock, kitty, GTK

# El login muestra el mismo fondo (y tu foto y tu tema): copia en segundo plano, sin pedir contraseña
[ -x "$ROOT/scripts/hf-greeter-sync" ] && { setsid "$ROOT/scripts/hf-greeter-sync" --auto >/dev/null 2>&1 8>&- & } || true

case "${1:-}" in restore|hora) ;; *) [ -n "${HF_QUIET:-}" ] || { command -v notify-send >/dev/null && notify-send -a "Fondos" -i "$IMG" "Fondo cambiado" "$(basename "$FILE")" || true; } ;; esac
