def motion_preset(s):
    """(preset, multiplicador de velocidad). «ninguno» si las animaciones están apagadas o se reduce el movimiento."""
    p = s.get("animPreset", "fluido")
    if p not in MOTION:
        p = "fluido" if p != "ninguno" else "ninguno"
    if s.get("animado", True) is False or s.get("reduceMotion"):
        p = "ninguno"
    try:
        k = max(0.4, min(2.5, float(s.get("animSpeed", 1.0))))
    except Exception:
        k = 1.0
    return p, k

def motion_shell(s, estilo):
    p, k = motion_preset(s)
    if p == "ninguno":
        return {"preset": p, "speed": k, "dur": 0, "durIn": 0, "durOut": 0}
    m = dict(MOTION[p]["shell"])
    for key in ("dur", "durIn", "durOut"):
        m[key] = round(m[key] / k)
    if m.get("easeIn") is None:   # «equilibrado»: Aurora con rebote, el resto «emphasized»
        m["easeIn"] = [0.34, 1.36, 0.64, 1, 1, 1] if estilo == "aurora" else m["ease"]
    m.update(preset=p, speed=k)
    return m

def motion_lua(s):
    p, k = motion_preset(s)
    if p == "ninguno":
        return []
    d = MOTION[p]
    out = ["-- movimiento: " + p + (" ×%g" % k if k != 1 else "")]
    for name, (x1, y1, x2, y2) in d["curves"].items():
        out.append('hl.curve("%s", { type = "bezier", points = { {%g, %g}, {%g, %g} } })' % (name, x1, y1, x2, y2))
    for a in d["anims"]:
        leaf, speed, curve, style = a[:4]
        on = a[4] if len(a) > 4 else True
        sp = max(0.5, round(speed / k, 2))
        st = (', style = "%s"' % style) if style else ""
        out.append('hl.animation({ leaf = "%s", enabled = %s, speed = %g, bezier = "%s"%s })'
                   % (leaf, "true" if on else "false", sp, curve, st))
    return out

def style_tokens(c, s):
    """Tokens de estilo (los del diseño, objeto S):
      flat    «Material»: superficies tonales sólidas teñidas por el color de acento (Material 3 / Android),
              sin bordes, elevación por tono, controles rectos con esquinas pequeñas
      aurora  vidrio esmerilado teñido con un resplandor de color (primario → terciario) y borde luminoso
      mica    Windows 11: material casi opaco sobre el fondo muy desenfocado, tarjetas translúcidas en capas,
              bordes de 1 px y sombras suaves; controles casi rectos
      suave   superficies mates de poco contraste con tintes pastel, sin bordes, muy redondeadas, controles en
              píldora, sombra amplia y difusa y el estado activo en el contenedor primario
      tonal   (solo con «Reducir transparencia» o «Alto contraste») superficies tonales con borde fino
    card/cardBorder: tarjetas de la app de Ajustes · shBlur/shY/shBigBlur/shBigY/shSpread: sombra de los paneles.
    winSolid: fondo de las ventanas grandes (Ajustes, Centro de aplicaciones): en Aurora más opaco que «win»
    para que lo de detrás (widgets, ventanas) no se transparente; en los demás estilos es sólido.
    Radios: barRad/panelRad/winRad/ctlRad en px; roundK multiplica los radios fijos de los módulos (Theme.r)."""
    LT = bool(c.get("light"))
    estilo = s.get("estilo", "aurora")
    if estilo not in STYLES:
        estilo = "aurora"            # «liquid» y «tonal» ya no se ofrecen: pasan a Aurora
    high = bool(s.get("highContrast"))
    if estilo in ("aurora", "mica") and (s.get("reduceTransparency") or high):
        estilo = "tonal"
    W, K = "#FFFFFF", "#000000"
    none = argb(W, 0)
    if estilo == "aurora":
        # Vidrio con aurora: resplandores de color (primario arriba-izquierda, terciario abajo-derecha y un velo
        # del contenedor primario en medio, Glass.qml), borde especular teñido y brillo interior
        S = dict(
            estilo="aurora", blur=True, pill=False,
            # barra y paneles con el mismo vidrio (antes la barra era más transparente y se veía de otro color)
            bg=argb(mix(c["s1"], c["p"], .14), .68 if LT else .58), bgPanel=argb(mix(c["s1"], c["p"], .14), .68 if LT else .58),
            bgPopup=argb(mix(c["s1"], c["p"], .16), .78 if LT else .68), bg2=argb(mix(c["s3"], c["p"], .20), .62 if LT else .55),
            border=argb(c["p"], .28 if LT else .20), borderWidth=1,
            highlight=argb(W, .55 if LT else .16), glow=argb(c["p"], .16),
            rimTop=argb(c["p"], .70 if LT else .60), rimBottom=argb(c["ter"], .40 if LT else .32),
            sheen=argb(W, .22 if LT else .07), tint=argb(c["p"], .34 if LT else .30), tint2=argb(c["ter"], .30 if LT else .26),
            tint3=argb(mix(c["p"], c["ter"], .5), .14 if LT else .12),
            shadow=argb(K, .10 if LT else .26), shadowBig=argb(mix(K, c["p"], .25), .20 if LT else .42),
            win=argb(mix(c["s1"], c["p"], .08), .82 if LT else .76), winBorder=argb(c["p"], .45),
            winSolid=argb(mix(c["s1"], c["p"], .08), .95 if LT else .90),
            barRad=7, panelRad=10, winRad=8, ctlRad=6, roundK=1.0)
    elif estilo == "tonal":
        S = dict(
            estilo="tonal", blur=False, pill=False,
            bg=argb(c["s3"], 1), bgPanel=argb(c["s3"], 1), bgPopup=argb(c["s3"], 1), bg2=argb(c["s4"], 1),
            border=argb(c["ov"], 1), borderWidth=1, highlight=none, glow=none,
            rimTop=none, rimBottom=none, sheen=none, tint=none, tint2=none,
            shadow=argb(K, .2), shadowBig=argb(K, .35),
            win=argb(c["s1"], 1), winSolid=argb(c["s1"], 1), winBorder=argb(c["ov"], 1), barRad=6, panelRad=9, winRad=6, ctlRad=6, roundK=1.0)
    elif estilo == "mica":
        # Mica (Windows 11): material translúcido que toma el color del fondo de pantalla muy desenfocado (Hyprland
        # desenfoca detrás; aquí una capa neutra apenas teñida del acento), capas «sutiles» blancas al 4–6 % con
        # trazo de 1 px más claro arriba que abajo (elevación), sombras suaves, esquinas de 8 px y controles de 4 px.
        # La selección lleva la pastilla del acento a la izquierda (Theme.selPill).
        base = mix(c["s1"], c["p"], .025)
        S = dict(
            estilo="mica", blur=True, pill=False,
            # barra, paneles y menús del mismo material (solo cambia la opacidad de los menús)
            bg=argb(base, .82 if LT else .76), bgPanel=argb(base, .82 if LT else .76),
            bgPopup=argb(base, .90 if LT else .86),
            bg2=argb(W, .66) if LT else argb(W, .06),
            border=argb(K, .08) if LT else argb(W, .08), borderWidth=1,
            highlight=none, glow=none, sheen=none, tint=none, tint2=none, tint3=none,
            rimTop=argb(W, .95) if LT else argb(W, .14), rimBottom=argb(K, .12) if LT else argb(W, .04),
            shadow=argb(K, .14 if LT else .34), shadowBig=argb(K, .20 if LT else .48),
            win=argb(base, .88 if LT else .84), winSolid=argb(base, .97 if LT else .95),
            winBorder=argb(K, .10) if LT else argb(W, .10),
            card=argb(W, .70) if LT else argb(W, .045), cardBorder=1,
            barRad=6, panelRad=8, winRad=8, ctlRad=4, roundK=0.85,
            shBlur=24, shY=8, shBigBlur=48, shBigY=16, shSpread=0)
    elif estilo == "suave":
        # Suave: superficies sólidas, mates y de poco contraste, teñidas de pastel del acento; sin bordes, esquinas
        # muy redondeadas, controles en píldora, sombras amplias y difusas del color del acento, un degradado
        # vertical muy leve (más claro arriba, como arcilla) y el estado activo en el contenedor primario (pastel)
        # Una sola superficie para la barra, los paneles, los menús y las ventanas (antes la barra iba en s1 y los
        # paneles en s3: el centro de control se veía de otro color que la barra)
        sur = mix(mix(c["s1"], c["s3"], .5), c["p"], .13 if LT else .09)
        pan = sur
        S = dict(
            estilo="suave", blur=False, pill=True,
            bg=argb(sur, 1), bgPanel=argb(pan, 1),
            bgPopup=argb(pan, 1),
            bg2=argb(mix(pan, c["p"], .14 if LT else .10), 1) if LT else argb(mix(mix(c["s3"], c["s4"], .5), c["p"], .14), 1),
            border=argb(c["ov"], .3), borderWidth=0, highlight=none, glow=none,
            rimTop=none, rimBottom=none, tint=none, tint2=none, tint3=none,
            sheen=argb(W, .35 if LT else .045),
            shadow=argb(mix(K, c["p"], .4), .12 if LT else .30), shadowBig=argb(mix(K, c["p"], .4), .18 if LT else .42),
            win=argb(sur, 1), winSolid=argb(sur, 1), winBorder=argb(mix(c["ov"], c["p"], .3), .6),
            card=argb(mix(c["s3"], c["p"], .14 if LT else .09), 1), cardBorder=0,
            barRad=14, panelRad=18, winRad=14, ctlRad=12, roundK=1.6,
            shBlur=40, shY=12, shBigBlur=64, shBigY=20, shSpread=-2)
    else:
        # Material 3: superficies con un ligero tinte del color primario y niveles de contenedor por tono
        # La barra, los paneles (centro de control, notificaciones, OSD, Spotlight…) y las ventanas del shell usan
        # la misma superficie: antes los paneles iban en s3 y se veían de otro color que la barra. Lo que va
        # dentro (mosaicos, campos, tarjetas) se separa con bg2/s3.
        sur = mix(c["s1"], c["p"], .05 if LT else .04)
        S = dict(
            estilo="flat", blur=False, pill=False,
            bg=argb(sur, 1), bgPanel=argb(sur, 1), bgPopup=argb(sur, 1),
            bg2=argb(mix(mix(c["s3"], c["s4"], .5), c["p"], .08), 1),
            border=argb(c["ov"], .5), borderWidth=0, highlight=none, glow=none,
            rimTop=none, rimBottom=none, sheen=none, tint=none, tint2=none,
            shadow=argb(K, .12 if LT else .30), shadowBig=argb(K, .20 if LT else .45),
            win=argb(sur, 1), winSolid=argb(sur, 1), winBorder=argb(c["ov"], 1), barRad=6, panelRad=10, winRad=8, ctlRad=6, roundK=1.0)
    # Sombras de los paneles del shell (Glass): radio/desplazamiento del estilo y «Sombras» de Apariencia
    base_sh = {"flat": (14, 3, 52, 18, -2), "aurora": (26, 8, 52, 18, 0), "tonal": (20, 6, 48, 16, 0)}.get(estilo)
    if base_sh:
        S.update(shBlur=base_sh[0], shY=base_sh[1], shBigBlur=base_sh[2], shBigY=base_sh[3], shSpread=base_sh[4])
    sk = SHADOWS.get(s.get("shadows", "suaves"), SHADOWS["suaves"])
    for key in ("shadow", "shadowBig"):
        a = int(S[key][1:3], 16) / 255
        S[key] = argb("#" + S[key][3:], min(1, a * sk["alpha"]))
    for key in ("shBlur", "shBigBlur"):
        S[key] = round(S[key] * sk["blur"])
    for key in ("shY", "shBigY"):
        S[key] = round(S[key] * sk["y"])
    S["shadows"] = s.get("shadows", "suaves") if s.get("shadows") in SHADOWS else "suaves"
    S.setdefault("tint3", none)
    S.setdefault("card", None)
    if S["card"] is None:
        S["card"] = S["bg2"] if estilo == "aurora" else argb(c["s3"], 1)
        S["cardBorder"] = 1 if estilo == "aurora" else 0
    k = ROUNDNESS.get(s.get("roundness", "auto"), 1.0)
    for key in ("barRad", "panelRad", "winRad", "ctlRad"):
        S[key] = max(0, round(S[key] * k))
    S["roundK"] = round(S["roundK"] * k, 3)
    S["pill"] = k >= 2.0 or (estilo == "suave" and k >= 0.7)
    if high:   # también Material: bordes de verdad en lugar de solo tono
        S["borderWidth"] = max(S["borderWidth"], 1)
        S["border"] = argb(c["o"], 1)
    return S

# ---------- salidas ----------
# Resaltado de la ventana activa (Ajustes › Apariencia › Ventanas): borde de Hyprland.
#   sutil    1 px del acento muy rebajado; las inactivas, casi invisibles (por defecto)
#   color    2 px con degradado acento → terciario
#   brillo   como «sutil» y además un halo del acento alrededor (la sombra de la activa, en config/apply/10-look.py)
#   ninguno  sin borde (las sombras separan las ventanas)
def active_border(c, S, s):
    """(border_size, active_border, inactive_border) ya como valores Lua (cadena o degradado)."""
    mode = s.get("activeBorder", "sutil")
    LT = bool(c.get("light"))
    soft_in = rgba_hypr(c["ov"], .45 if LT else .35)
    if mode == "ninguno":
        return 0, '"%s"' % rgba_hypr(c["p"], 0), '"%s"' % rgba_hypr(c["ov"], 0)
    if mode == "color":
        return 2, '{ colors = { "%s", "%s" }, angle = 45 }' % (rgba_hypr(c["p"], .95), rgba_hypr(c.get("ter", c["p"]), .85)), \
            '"%s"' % rgba_hypr(c["ov"], .7)
    # sutil / brillo: el acento mezclado con el contorno, con poca opacidad
    return 1, '"%s"' % rgba_hypr(mix(c["p"], c["ov"], .25), .55 if LT else .45), '"%s"' % soft_in

def hypr_lua(c, S, s):
    focus = bool(s.get("_focus"))
    gi, go = (0, 0) if focus else (int(s.get("gapsIn", 4)), int(s.get("gapsOut", 4)))
    anim = motion_preset(s)[0] != "ninguno"
    bsize, act, inact = active_border(c, S, s)
    lines = [
        "-- GENERADO por hf-apply a partir de ~/.config/hyprfrijol/settings.json — no editar",
        "hl.config({",
        "    general = {",
        f"        gaps_in = {gi}, gaps_out = {go}, border_size = {0 if focus else bsize},",
        f'        col = {{ active_border = {act}, inactive_border = {inact} }},',
        "    },",
        "    decoration = {",
        f"        rounding = {0 if focus else S['winRad']},",
        f"        rounding_power = {ROUNDING_POWER.get(s.get('roundingShape', 'auto'), 2.6)},",
        f"        blur = {{ enabled = {'true' if S['blur'] else 'false'} }},",
        f"        inactive_opacity = {0.97 if S['blur'] else 1.0},",
        "    },",
        f"    animations = {{ enabled = {'true' if anim else 'false'} }},",
        f'    misc = {{ background_color = "{rgba_hypr(c["bg"])}" }},',
        "})",
    ]
    lines += motion_lua(s)
    # Extensiones: cada archivo config/apply/*.py puede añadir líneas (los usa la app de Ajustes)
    for ext in sorted((ROOT / "config/apply").glob("*.py")) if (ROOT / "config/apply").is_dir() else []:
        ns = {}
        try:
            exec(compile(ext.read_text(), str(ext), "exec"), ns)
            extra = ns.get("hypr_lua", lambda s, c: [])(s, c)
            if extra:
                lines.append(f"-- {ext.name}")
                lines.extend(extra)
        except Exception as e:  # una extensión rota no debe romper el resto
            lines.append(f"-- {ext.name}: error {e!r}")
    return "\n".join(lines) + "\n"

def hyprlock_conf(c):
    return "\n".join([
        "# GENERADO por hf-apply",
        f"$primary = {rgba_hypr(c['p'])}",
        f"$surface = {rgba_hypr(c['s1'])}",
        f"$text = {rgba_hypr(c['t'])}",
        f"$textMuted = {rgba_hypr(c['tv'])}",
        f"$outlineVariant = {rgba_hypr(c['ov'], .4)}",
        f"$fieldBg = {rgba_hypr(c['s1'], .45)}",
        "",
    ])

def hsl_hex(h, s, l):
    import colorsys
    r, g, b = colorsys.hls_to_rgb((h % 360) / 360, l, s)
    return "#%02X%02X%02X" % (round(r * 255), round(g * 255), round(b * 255))

def ansi_colors(c):
    """Los 16 colores ANSI del terminal: los de la paleta (palettes.json "ansi", p. ej. Catppuccin o Nord) o,
    si no los trae (paletas propias, matugen, monocromo, variantes derivadas), unos armónicos con ella:
    rojo/verde/amarillo/azul/magenta/cian con la luminosidad del modo y un toque del color principal."""
    a = c.get("ansi")
    if isinstance(a, list) and len(a) == 16 and all(valid_hex(x) for x in a):
        return [x.upper() for x in a]
    LT = bool(c.get("light"))
    hues = (4, 130, 42, 215, 300, 185)        # rojo verde amarillo azul magenta cian
    norm = [mix(hsl_hex(h, .55, .40 if LT else .70), c["p"], .12) for h in hues]
    bright = [mix(hsl_hex(h, .65, .33 if LT else .78), c["p"], .08) for h in hues]
    if LT:
        return [c["t"]] + norm + [c["o"], c["tv"]] + bright + [mix(c["t"], "#000000", .3)]
    return [c["s4"]] + norm + [c["tv"], c["o"]] + bright + [c["t"]]

def kitty_conf(c, S):
    op = 0.86 if S["blur"] else 1.0
    a = ansi_colors(c)
    return "\n".join([
        "# GENERADO por hf-apply · Ajustes › Apariencia › «Aplicar el tema a las apps» lo incluye en kitty.conf",
        "# (include ~/.local/state/hyprfrijol/kitty-colors.conf) y kitty lo recarga en vivo (SIGUSR1)",
        f"background {c['s1']}", f"foreground {c['t']}",
        f"cursor {c['p']}", f"cursor_text_color {c['onP']}",
        f"selection_background {c['pc']}", f"selection_foreground {c['onPc']}",
        f"url_color {c['p']}",
        f"active_border_color {c['p']}", f"inactive_border_color {c['ov']}", f"bell_border_color {c['ter']}",
        f"active_tab_background {c['p']}", f"active_tab_foreground {c['onP']}",
        f"inactive_tab_background {c['s3']}", f"inactive_tab_foreground {c['tv']}",
        f"tab_bar_background {c['bg']}",
        f"mark1_background {c['p']}", f"mark1_foreground {c['onP']}",
        f"mark2_background {c['ter']}", f"mark2_foreground {c['s1']}",
        *[f"color{i} {a[i]}" for i in range(16)],
        f"background_opacity {op}", "",
    ])

def gtk_css(c):
    return "\n".join([
        "/* GENERADO por hf-apply · @import url(\"file://%s\"); en ~/.config/gtk-4.0/gtk.css */" % (STATE / "gtk-colors.css"),
        f"@define-color accent_color {c['p']};", f"@define-color accent_bg_color {c['p']};",
        f"@define-color accent_fg_color {c['onP']};", f"@define-color window_bg_color {c['s1']};",
        f"@define-color window_fg_color {c['t']};", f"@define-color view_bg_color {c['s3']};",
        f"@define-color headerbar_bg_color {c['s3']};", f"@define-color card_bg_color {c['s4']};", "",
    ])

def real_home():
    """¿Es HOME el del usuario? Con un HOME de prueba no se recargan apps de la sesión real (kitty, Dolphin…)."""
    try:
        import pwd
        return str(HOME) == pwd.getpwuid(os.getuid()).pw_dir
    except Exception:
        return False

def cmd_set(pairs):
    USER.mkdir(parents=True, exist_ok=True)
    cur = load(SETTINGS, {}) or {}
    for p in pairs:
        k, _, v = p.partition("=")
        try:
            cur[k] = json.loads(v)
        except Exception:
            cur[k] = v
    write_if_changed(SETTINGS, json.dumps(cur, indent=2, ensure_ascii=False) + "\n")

def main(argv):
    if argv[:1] == ["toggle-mode"]:
        # Claro ⇄ oscuro (si estaba en «según la hora», pasa al contrario de lo que se ve ahora)
        s = settings()
        _, c = resolve_palette(s)
        cmd_set(["themeMode=" + ("oscuro" if c.get("light") else "claro")])
        argv = [a for a in argv[1:] if a.startswith("--")]
    if argv[:1] == ["set"]:
        cmd_set([a for a in argv[1:] if not a.startswith("--")])
        argv = [a for a in argv[1:] if a.startswith("--")]
    STATE.mkdir(parents=True, exist_ok=True)
    s = settings()
    key, c = resolve_palette(s)
    c = apply_accent(c, s)
    if s.get("estilo") == "suave" and c.get("light"):
        # Suave marca la selección y lo activo con el contenedor primario: en claro, algo más de color para que
        # se distinga de las tarjetas pastel
        c["pc"] = mix(c["pc"], c["p"], .35)
    c = fix_contrast(c, bool(s.get("highContrast")))
    c["ansi"] = ansi_colors(c)   # 16 colores del terminal (kitty, btop, KDE): los de la paleta o armónicos
    S = style_tokens(c, s)
    theme = {
        "paletteKey": key, "paletteName": c.get("name", key), "light": bool(c.get("light")),
        "colorMode": s.get("colorMode"), "c": {k: v for k, v in c.items() if k not in ("name", "light")},
        "S": S, "font": s.get("fontFamily", "Inter"), "fontScale": float(s.get("fontScale", 1.0)),
        "reduceMotion": bool(s.get("reduceMotion")), "highContrast": bool(s.get("highContrast")),
        "motion": motion_shell(s, S["estilo"]),
    }
    if "--print" in argv:
        print(json.dumps(theme, indent=2)); return
    write_if_changed(STATE / "theme.json", json.dumps(theme, indent=2) + "\n")
    hypr_changed = write_if_changed(STATE / "settings.lua", hypr_lua(c, S, s))
    write_if_changed(STATE / "hyprlock-colors.conf", hyprlock_conf(c))
    kitty_changed = write_if_changed(STATE / "kitty-colors.conf", kitty_conf(c, S))
    write_if_changed(STATE / "gtk-colors.css", gtk_css(c))
    if "--no-reload" in argv:
        return
    if hypr_changed and os.environ.get("HF_SESSION"):
        subprocess.run(["hyprctl", "reload", "config-only"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # kitty: solo con el HOME de verdad (con un HOME de prueba, p. ej. dev/try.sh, no tocar tus terminales)
    if kitty_changed and real_home():
        subprocess.run(["pkill", "-USR1", "-u", str(os.getuid()), "-x", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main(sys.argv[1:])
