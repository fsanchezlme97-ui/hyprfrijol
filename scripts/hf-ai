SETTINGS = HOME / ".config/hyprfrijol/settings.json"
QS = ["qs", "-p", str(ROOT / "config/quickshell")]

# ---------------------------------------------------------------- ajustes
def load(p, d=None):
    try:
        return json.loads(pathlib.Path(p).read_text())
    except Exception:
        return d

def settings():
    s = dict(load(ROOT / "config/defaults/settings.json", {}) or {})
    s.update(load(SETTINGS, {}) or {})
    return s

def jrun(cmd):
    try:
        v = json.loads(run(cmd) or "{}")
        return {} if v is None else v      # «[]» (sin ventanas) sigue siendo una lista: no es «no responde»
    except Exception:
        return {}

def run(cmd, timeout=10, input=None, env=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input,
                           env={**os.environ, **env} if env else None)
        return r.stdout.strip()
    except Exception:
        return ""

