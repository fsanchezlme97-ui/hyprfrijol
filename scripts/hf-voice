#!/usr/bin/env python3
"""hf-voice — comandos de voz de hyprfrijol: entiende frases en español («Reproduce Walk de los Foo Fighters desde
YouTube», «sube el volumen al 50 por ciento», «nueva pestaña»…) y las ejecuta. Sin IA: expresiones regulares. Lo
que no entiende se lo pasa al asistente (hf-ai, en el panel lateral, con sus reglas de aprobación).

  hf-voice parse "<frase>"          imprime la intención en JSON sin ejecutar nada (prueba en seco)
  hf-voice run "<frase>" [--no-ai] [--dry-run]
                                    la ejecuta → {"ok", "intent", "label", "msg", "fallback"}
  hf-voice youtube "<búsqueda>" [--service youtube|music|spotify] [--print]
                                    busca la primera canción/vídeo (yt-dlp; si falta, la página de resultados) y la abre
  hf-voice browser <op> [valor] [--print]
                                    new-tab · close-tab · next-tab · prev-tab · back · forward · reload · scroll-down ·
                                    scroll-up · top · bottom · fullscreen · find <texto> · search <texto> · open <sitio|url>
  hf-voice intents                  lista de intenciones admitidas (para Ajustes y la documentación)
  hf-voice test                     prueba el analizador con frases de ejemplo (en seco)

Ajustes: voiceAiFallback (true: lo no entendido va a la IA) · voiceMusicService youtube|music|spotify (al decir
«pon X» sin decir dónde) · dictationWakeWord (palabra de activación, «Distro»: «Distro, …», «oye Distro …») ·
voiceCommands (órdenes propias: [{"phrase":"modo cine","do":"run|app|url|orden","value":"…"}], «*» en la frase → {x})
· voiceAliases ({"toca":"reproduce"}: palabras tuyas para las órdenes de serie). Van antes que las de serie.
Pruebas: HF_VOICE_OPEN="<orden>" abre las direcciones con esa orden en lugar de xdg-open (la dirección va al final);
HF_VOICE_NO_NET=1 no consulta YouTube (usa la búsqueda).
"""
import difflib, json, os, pathlib, re, shlex, shutil, subprocess, sys, time, unicodedata, urllib.parse, urllib.request
for _k, _v in list(os.environ.items()):   # variables HL_* (hypr-liquid): siguen valiendo
    if _k.startswith("HL_"): os.environ.setdefault("HF_" + _k[3:], _v)

HOME = pathlib.Path.home()
ROOT = pathlib.Path(os.environ.get("HF_ROOT") or pathlib.Path(__file__).resolve().parent.parent)
SETTINGS = HOME / ".config/hyprfrijol/settings.json"
QS = ["qs", "-p", str(ROOT / "config/quickshell")]

def load(p, d=None):
    try:
        return json.loads(pathlib.Path(p).read_text())
    except Exception:
        return d

def settings():
    s = dict(load(ROOT / "config/defaults/settings.json", {}) or {})
    s.update(load(SETTINGS, {}) or {})
    return s

# ---------------------------------------------------------------- texto
def fold(s):
    """minúsculas y sin tildes, carácter a carácter (misma longitud: los índices valen en el original)."""
    out = []
    for c in s:
        d = unicodedata.normalize("NFD", c)
        out.append((d[0] if d else c).lower())       # ñ → n también (las expresiones van sin tildes ni eñes)
    return "".join(out)

def clean(s):
    s = re.sub(r"[¿?¡!«»\"“”…]", " ", s or "")
    s = re.sub(r"(?<!\d)[.,;:](?!\d)|[.,;:](?=\s|$)", " ", s)
    return re.sub(r"\s+", " ", s).strip()

UNITS = {"cero": 0, "un": 1, "uno": 1, "una": 1, "dos": 2, "tres": 3, "cuatro": 4, "cinco": 5, "seis": 6, "siete": 7,
         "ocho": 8, "nueve": 9, "diez": 10, "once": 11, "doce": 12, "trece": 13, "catorce": 14, "quince": 15,
         "dieciseis": 16, "diecisiete": 17, "dieciocho": 18, "diecinueve": 19, "veinte": 20, "veintiun": 21,
         "veintiuno": 21, "veintiuna": 21, "veintidos": 22, "veintitres": 23, "veinticuatro": 24, "veinticinco": 25,
         "veintiseis": 26, "veintisiete": 27, "veintiocho": 28, "veintinueve": 29, "cien": 100, "ciento": 100}
TENS = {"treinta": 30, "cuarenta": 40, "cincuenta": 50, "sesenta": 60, "setenta": 70, "ochenta": 80, "noventa": 90}
NUM_RE = r"(\d{1,3}|(?:treinta|cuarenta|cincuenta|sesenta|setenta|ochenta|noventa)(?: y (?:un|uno|una|dos|tres|cuatro|cinco|seis|siete|ocho|nueve))?|" \
         + "|".join(sorted(UNITS, key=len, reverse=True)) + ")"

def num(w):
    w = fold(w or "").strip()
    if w.isdigit():
        return int(w)
    m = re.fullmatch(r"(\w+)(?: y (\w+))?", w)
    if not m:
        return None
    if m.group(1) in TENS:
        return TENS[m.group(1)] + (UNITS.get(m.group(2) or "cero", 0))
    return UNITS.get(w)

WAKE_DEFAULT = "distro"     # en homenaje a las distribuciones de Linux; se cambia en Ajustes › Dictado
# cómo suele escribir «Distro» el reconocedor. Las que son palabras corrientes («diestro», «distrito»…) solo valen
# con «oye/hey» delante, con coma detrás o si lo que sigue es una orden que se entiende (wake_split).
WAKE_ALTS = {"distro": {"distro", "distros", "distró", "dis tro", "disto", "destro", "dystro", "distra", "distrou"},
             "frijol": {"frijol", "frijoles", "frejol", "frijo", "fri jol", "free jol", "frijolito"}}
WAKE_LOOSE = {"distro": {"diestro", "distrito", "bistro", "dextro", "de stro", "de tro", "district"}}
WAKE_PRE = r"(?:(?:oye|hey|ey|ok|okey|eh|hola|vale)[\s,]+)"

def wake_word(word=None):
    return fold(word or settings().get("dictationWakeWord") or WAKE_DEFAULT).strip() or WAKE_DEFAULT

def _alt(words):
    return "|".join(sorted((re.escape(a) for a in words), key=len, reverse=True))

def wake_re(word=None):
    w = wake_word(word)
    return re.compile(r"^\W*" + WAKE_PRE + r"?(?:" + _alt({w} | WAKE_ALTS.get(w, set())) + r")\b[\s,.:;!¡-]*", re.I)

def strip_wake(text, word=None, loose=False):
    """(True, resto) si la frase empieza por la palabra de activación («Distro, …», «oye Distro …», «hey Distro»).
    loose=True: también las parecidas sin coma (quien llama comprueba que el resto sea una orden)."""
    t = text or ""
    f = fold(t)
    m = wake_re(word).match(f)
    if m:
        return True, t[m.end():].strip()
    w = wake_word(word)
    lw = WAKE_LOOSE.get(w, set())
    if lw:   # «oye diestro, …» o «distrito, …»
        m = re.match(r"^\W*(?:" + WAKE_PRE + r"(?:" + _alt(lw) + r")\b|(?:" + _alt(lw) + r")\s*[,:])[\s,.:;!¡-]*", f)
        if m:
            return True, t[m.end():].strip()
    # parecida («Distor», «Bistró»): sola al principio y con coma, como se dice «Distro, …»
    m = re.match(r"^\W*" + WAKE_PRE + r"?([a-z]+)\s*[,:]\s*", f)
    if m and difflib.SequenceMatcher(None, m.group(1), w).ratio() >= 0.75:
        return True, t[m.end():].strip()
    if loose:
        m = re.match(r"^\W*" + WAKE_PRE + r"?([a-z]+(?: [a-z]+)?)\b[\s,.:;!¡-]*", f)
        if m:
            first = m.group(1).split(" ")[0]
            cand = [m.group(1).replace(" ", ""), first]
            if any(c in lw or difflib.SequenceMatcher(None, c, w).ratio() >= 0.8 for c in cand):
                end = m.end() if m.group(1).replace(" ", "") in lw | {w} or difflib.SequenceMatcher(None, m.group(1).replace(" ", ""), w).ratio() >= 0.8 \
                    else m.start(1) + len(first)
                return True, t[end:].strip(" ,.:;")
    return False, t

def wake_split(text, word=None, s=None):
    """¿Es una orden dentro del dictado? Exacta → sí. Parecida sin coma → solo si el resto es una orden conocida."""
    ok, rest = strip_wake(text, word)
    if ok:
        return True, rest
    ok, rest = strip_wake(text, word, loose=True)
    if ok and rest and parse(rest, s, wake=False)["intent"] not in ("unknown", "none"):
        return True, rest
    return False, text

# ---------------------------------------------------------------- órdenes propias (Ajustes › Dictado)
def aliases(s):
    """voiceAliases: {"toca": "reproduce", "dale": "pon"} → palabra que dices → palabra que entiende el analizador."""
    a = s.get("voiceAliases") or {}
    return {fold(k).strip(): fold(v).strip() for k, v in a.items() if isinstance(k, str) and isinstance(v, str) and k.strip() and v.strip()} \
        if isinstance(a, dict) else {}

def apply_aliases(o, s):
    """Cambia en la frase original las palabras (o grupos) de voiceAliases; se buscan sin tildes ni mayúsculas."""
    for k, v in sorted(aliases(s).items(), key=lambda kv: -len(kv[0])):
        spans = [m.span() for m in re.finditer(r"(?<![\w])" + re.escape(k) + r"(?![\w])", fold(o))]
        for a, b in reversed(spans):
            o = o[:a] + v + o[b:]
    return o

CUSTOM_KINDS = {"run": "Ejecutar", "app": "Abrir app", "url": "Abrir web", "orden": "Equivale a"}

def custom(t, o, s):
    """voiceCommands: [{"phrase":"modo cine","do":"run|app|url|orden","value":"…"}]. «*» en la frase recoge el resto
    («busca * en mi wiki» → {x} en value). Devuelve la intención o None."""
    for c in s.get("voiceCommands") or []:
        if not isinstance(c, dict) or not str(c.get("phrase") or "").strip() or c.get("do") not in CUSTOM_KINDS:
            continue
        ph = clean(fold(str(c["phrase"])))
        rx = r"\s*".join("(.+?)" if w == "*" else re.escape(w) for w in ph.split(" "))
        m = re.fullmatch(rx, t)
        x = o[m.start(1):m.end(1)].strip() if m and m.groups() else ""
        if not m and "*" not in ph and len(ph) >= 6 and difflib.SequenceMatcher(None, ph, t).ratio() >= 0.88:
            m = True                                   # casi igual («modo sine» → «modo cine»)
        if not m:
            continue
        v = str(c.get("value") or "")
        lab = str(c.get("label") or c["phrase"])
        if c["do"] == "orden":
            it = parse(v.replace("{x}", x), s, custom_ok=False)
            return {**it, "label": f"{lab} → {it['label']}", "custom": c["phrase"]}
        if c["do"] == "url":
            return I("url", lab, url=v.replace("{x}", urllib.parse.quote_plus(x)), custom=c["phrase"])
        if c["do"] == "app":
            return I("launch", lab, app=v.replace("{x}", x), custom=c["phrase"])
        return I("run", lab, command=v.replace("{x}", shlex.quote(x)) if x else v.replace("{x}", ""), custom=c["phrase"])
    return None

