SCREEN_INTENT = re.compile(r"\b(haz(me)? (un )?(doble )?clic|dale (un )?clic|clica|cliquea|(pulsa|presiona|toca) (en|sobre) |"
                           r"(pulsa|presiona) (el|la) (boton|enlace|casilla|pestana|icono)|escribe (en|dentro de) (el|la|ese|esa|este|esta) "
                           r"(campo|cuadro|caja|buscador|barra)|senalame)")

# «¿dónde está…?», «búscame el pdf…»: los modelos pequeños contestan «no tengo acceso» en vez de usar la consulta
# files; se les recuerda en el mismo mensaje (no cambia lo que ve el usuario)
FILE_INTENT = re.compile(r"\b(donde (esta|estan|tengo|guarde|deje|quedo|quedaron|puse|descargue|baje)\b|"
                         r"(busca|buscame|encuentra|encuentrame|localiza) (el|la|los|las|un|una|mi|mis|ese|esa) |"
                         r"(archivo|fichero|documento|carpeta|pdf)s? (que|de|del|con|llamad)|"
                         r"(resume|resumeme|resumir|leeme|lee|que dice|que pone) (el|la|los|las|mi|mis|ese|esa|este|esta) )")
FILE_NUDGE = ("\n\n[Nota del sistema: es sobre un archivo o carpeta del equipo. Paso 1: busca con "
              "```hf-query\n[{\"type\":\"files\",\"query\":\"<una palabra del nombre>\"}]\n``` (añade \"ext\" si la dice). "
              "Paso 2, si hay que leerlo o resumirlo: ```hf-query\n[{\"type\":\"read_file\",\"path\":\"<ruta>\"}]\n```. "
              "Después contesta (la ruta, o el resumen). Ábrelo solo si lo pide.]")

def file_intent(req, s):
    if not can_read(s):
        return False
    last = next((m for m in reversed(req.get("messages") or []) if m.get("role") == "user"), {})
    import unicodedata
    t = unicodedata.normalize("NFD", str(last.get("text") or "").lower())
    return bool(FILE_INTENT.search("".join(c for c in t if not unicodedata.combining(c))))

READ_INTENT = re.compile(r"\b(resume|resumeme|resumir|resumen|leeme|lee|que dice|que pone|explicame|de que (va|trata))\b")
OPEN_INTENT = re.compile(r"\b(abre|abrelo|abrela|abreme|abrir|ensename|muestrame|llevame|ve a)\b")

def read_instead(req, raw):
    """{"type":"read_file",…} si el usuario pidió leer o resumir (no abrir) y el modelo propone abrir un archivo."""
    last = next((m for m in reversed(req.get("messages") or []) if m.get("role") == "user"), {})
    import unicodedata
    t = unicodedata.normalize("NFD", str(last.get("text") or "").replace(FILE_NUDGE, "").lower())
    t = "".join(c for c in t if not unicodedata.combining(c))
    if not READ_INTENT.search(t) or OPEN_INTENT.search(t):
        return None
    m = re.search(r"```(?:hf-actions)?\s*(.*?)\s*```", raw, re.S)
    a = next((a for a in actions_json(m.group(1)) if isinstance(a, dict) and a.get("type") == "file"), None) if m else None
    return {"type": "read_file", "path": a["path"]} if a and isinstance(a.get("path"), str) else None

def _selftest_file_intent():
    s = {"aiReadDesktop": True}
    yes = ["¿Dónde está el CHANGELOG?", "búscame el pdf de la factura", "dónde guardé las fotos de la boda",
           "encuentra mi currículum", "el archivo que bajé ayer"]
    yes += ["resúmeme el CHANGELOG de hyprfrijol", "¿qué dice el contrato?"]
    no = ["pon la barra arriba", "¿qué hora es?", "dibuja un gato"]
    assert all(file_intent({"messages": [{"role": "user", "text": x}]}, s) for x in yes)
    assert not any(file_intent({"messages": [{"role": "user", "text": x}]}, s) for x in no)
    assert not file_intent({"messages": [{"role": "user", "text": yes[0]}]}, {"aiReadDesktop": False})
    raw = 'Voy.\n```hf-actions\n[{"type":"file","op":"open","path":"/x/CHANGELOG.md"}]\n```'
    ask = lambda q: {"messages": [{"role": "user", "text": q}]}
    assert read_instead(ask("resúmeme el CHANGELOG"), raw) == {"type": "read_file", "path": "/x/CHANGELOG.md"}
    assert read_instead(ask("ábreme el CHANGELOG"), raw) is None
    assert read_instead(ask("lee el CHANGELOG y ábrelo"), raw) is None
    assert read_instead(ask("resúmeme el CHANGELOG"), "Listo.") is None

def screen_intent(req, s):
    """¿El último mensaje pide usar o señalar algo de la pantalla? (y está permitido)"""
    if s.get("aiScreenControl", True) is False or s.get("aiContextCapture", True) is False or not can_read(s) \
            or not allowed(s)[0]:
        return False
    last = next((m for m in reversed(req.get("messages") or []) if m.get("role") == "user"), {})
    import unicodedata
    t = unicodedata.normalize("NFD", str(last.get("text") or last.get("content") or "").lower())
    t = "".join(c for c in t if not unicodedata.combining(c))
    return bool(SCREEN_INTENT.search(t))
