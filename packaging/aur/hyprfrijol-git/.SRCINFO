pkgbase = hyprfrijol-git
	pkgdesc = Escritorio completo sobre Hyprland con un shell de Quickshell (barra, paneles, asistente de IA, dictado)
	pkgver = 0
	pkgrel = 1
	url = https://github.com/fsanchezlme97-ui/hyprfrijol
	install = hyprfrijol-git.install
	arch = any
	license = MIT
	makedepends = git
	depends = hyprland
	depends = hyprlock
	depends = hypridle
	depends = xdg-desktop-portal-hyprland
	depends = quickshell
	depends = qt6-declarative
	depends = qt6-svg
	depends = qt6-wayland
	depends = qt6-imageformats
	depends = matugen
	depends = python
	depends = jq
	depends = wl-clipboard
	depends = polkit
	depends = inter-font
	optdepends = xdg-desktop-portal-gtk: portal: diálogos de abrir/guardar
	optdepends = libnotify: notify-send
	optdepends = zenity: diálogos de los scripts
	optdepends = xdg-user-dirs: carpetas del usuario y xdg-open
	optdepends = xdg-utils: carpetas del usuario y xdg-open
	optdepends = gnome-keyring: llavero (contraseñas, claves de la IA)
	optdepends = libsecret: llavero (contraseñas, claves de la IA)
	optdepends = curl: IA, actualizaciones
	optdepends = glib2: gsettings, gdbus y gio (tema GTK, papelera, avisos de unidades)
	optdepends = gtk3: abrir apps por su .desktop (gtk-launch)
	optdepends = util-linux: lsblk, findmnt y rfkill (discos y modo avión)
	optdepends = noto-fonts: tipografía de respaldo
	optdepends = noto-fonts-emoji: emojis (Spotlight «;»)
	optdepends = ttf-jetbrains-mono: monoespaciada (Ajustes, terminal)
	optdepends = papirus-icon-theme: iconos de apps (con carpetas del acento)
	optdepends = gsettings-desktop-schemas: tema claro/oscuro de las apps GTK
	optdepends = adw-gtk-theme: tema claro/oscuro de las apps GTK
	optdepends = qt6ct: tema y colores de las apps Qt
	optdepends = imagemagick: miniaturas, fondos animados, conversión
	optdepends = ffmpeg: miniaturas, fondos animados, conversión
	optdepends = qt6-webengine: web apps del panel lateral (WhatsApp, YouTube…)
	optdepends = kitty: terminal por defecto (HF.terminal)
	optdepends = btop: administrador de tareas y mezclador
	optdepends = pavucontrol: administrador de tareas y mezclador
	optdepends = flatpak: apps de Flathub (Aplicaciones, Subtítulos en vivo)
	optdepends = desktop-file-utils: registrar apps y web apps (update-desktop-database)
	optdepends = hyprsunset: luz nocturna
	optdepends = networkmanager: red y Wi-Fi (nmcli)
	optdepends = nm-connection-editor: editor avanzado de conexiones y VPN (nm-connection-editor)
	optdepends = pipewire: sonido (PipeWire) y pactl
	optdepends = wireplumber: sonido (PipeWire) y pactl
	optdepends = pipewire-pulse: sonido (PipeWire) y pactl
	optdepends = libpulse: sonido (PipeWire) y pactl
	optdepends = cava: onda de audio de la barra
	optdepends = cups: impresoras: lpstat, lpoptions y el asistente (servicio: systemctl enable --now cups.socket)
	optdepends = cups-filters: impresoras: lpstat, lpoptions y el asistente (servicio: systemctl enable --now cups.socket)
	optdepends = system-config-printer: impresoras: lpstat, lpoptions y el asistente (servicio: systemctl enable --now cups.socket)
	optdepends = udisks2: memorias USB y tarjetas SD: montar, expulsar y avisos (hf-devices)
	optdepends = ntfs-3g: discos de Windows (NTFS) y memorias exFAT, aunque el kernel no traiga o no cargue su driver
	optdepends = exfatprogs: discos de Windows (NTFS) y memorias exFAT, aunque el kernel no traiga o no cargue su driver
	optdepends = power-profiles-daemon: batería y modos de energía
	optdepends = upower: batería y modos de energía
	optdepends = git: actualizar HyprFrijol por versiones (hf-update)
	optdepends = pciutils: nombre de la GPU (lspci) en Acerca y hf-doctor
	optdepends = pacman-contrib: ver qué hay por actualizar sin tocar el sistema (checkupdates)
	optdepends = accountsservice: nombre y avatar de tu cuenta (AccountsService)
	optdepends = wtype: escribir emojis / dictado en la ventana con foco
	optdepends = alsa-utils: grabar el micrófono con arecord (si no hay pw-record)
	optdepends = ydotool: escribir en apps XWayland y clics simulados (si wtype no basta)
	optdepends = python-vosk: Vosk: dictado en tiempo real, palabra a palabra (motor por defecto si está; si no, whisper); sin paquete: hf-dictate install-vosk (venv con pip en ~/.local/share/hyprfrijol/whisper/vosk-venv) · modelos de alphacephei.com/vosk/models
	optdepends = vosk-api: Vosk: dictado en tiempo real, palabra a palabra (motor por defecto si está; si no, whisper); sin paquete: hf-dictate install-vosk (venv con pip en ~/.local/share/hyprfrijol/whisper/vosk-venv) · modelos de alphacephei.com/vosk/models
	optdepends = grim: capturas de pantalla
	optdepends = slurp: capturas de pantalla
	optdepends = wf-recorder: grabación de pantalla
	optdepends = tesseract: OCR de capturas (copiar texto)
	optdepends = tesseract-data-spa: OCR de capturas (copiar texto)
	optdepends = tesseract-data-eng: OCR de capturas (copiar texto)
	optdepends = cliphist: historial del portapapeles
	optdepends = playerctl: música y brillo
	optdepends = brightnessctl: música y brillo
	optdepends = python-pymupdf: Firmar documentos PDF (hf-sign); sin él usa Poppler y se pierden enlaces y formularios
	optdepends = python-gobject: selector de archivos, enviar al móvil y avisos del asistente (hf-pickfile, hf-phone, hf-ai)
	optdepends = poppler: OCR y conversión de PDF desde Nautilus (pdftoppm, hf-fileact)
	optdepends = yt-dlp: descargas de vídeo y audio (hf-download)
	optdepends = qt6-multimedia: fondo en movimiento (vídeo) en el bloqueo, el selector de fondos y el login visual
	optdepends = qt6-multimedia-ffmpeg: fondo en movimiento (vídeo) en el bloqueo, el selector de fondos y el login visual
	provides = hyprfrijol
	conflicts = hyprfrijol
	source = hyprfrijol::git+https://github.com/fsanchezlme97-ui/hyprfrijol.git
	sha256sums = SKIP

pkgname = hyprfrijol-git
