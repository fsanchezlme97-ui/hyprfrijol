#!/usr/bin/env bash
# hf-migrate — limpia lo que dejaron las funciones y los nombres retirados de hyprfrijol. Se puede repetir sin miedo:
# hf-update lo ejecuta tras cada actualización y hf-apply lo lanza solo (--retired-only) si queda algo.
#
#   hf-migrate                 limpia lo retirado en tu usuario
#   hf-migrate --dry-run       solo muestra lo que haría
#   hf-migrate --quiet         sin mensajes (salvo errores)
#   hf-migrate --retired-only  igual que sin opciones (lo usa hf-apply)
#
# Qué hace (solo en tu $HOME; nunca usa sudo):
#   Funciones retiradas — perfiles de actividad (hf-profile): borra ~/.local/state/hyprfrijol/{profile,
#      profile-bar,profile.lua,notify-policy}; si el perfil había puesto «no molestar» (avisos favoritos/silencio)
#      lo quita; quita profiles, profileRules y notifyFavorites de settings.json (copia antes en
#      settings.json.antes-sin-perfiles) y el enlace ~/.local/bin/hf-profile. No toca el modo de energía.
#      Dictado sin IA: quita dictationAI y cambia dictationWakeWord «Frijol» (la de antes) por «Distro»
#      (copia en settings.json.antes-sin-ia-dictado).
#      Web apps (0.8.28): borra sus lanzadores, el enlace hf-webapp y sus claves de settings.json (copia en
#      settings.json.antes-sin-webapps); sus sesiones guardadas se quedan.
#      Asistente «Samantha» → «Helpert» (0.8.20), y su personalidad si era la de fábrica (copia en
#      settings.json.antes-de-helpert).
#      «Helpert» → «Harper» (0.10.28), igual (copia en settings.json.antes-de-harper).
#      Estilo único Math (0.9.0): «estilo» pasa a «math» y SkySoul a «transparencia: true» (copia en
#      settings.json.antes-de-math); borra el enlace roto a la fuente Doto de Chroma.
#      hf-apply lo lanza solo (--retired-only) si queda algo de esto.
set -euo pipefail

NEW=hyprfrijol
DRY=0 QUIET=0 BIN="$HOME/.local/bin"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)   DRY=1 ;;
    --quiet)     QUIET=1 ;;
    --retired-only) ;;
    -h|--help)   sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opción desconocida: $1 (usa --help)" >&2; exit 1 ;;
  esac
  shift
done

say()  { [ "$QUIET" = 1 ] || printf '\033[1;36m▸\033[0m %s\n' "$*"; }
run()  { if [ "$DRY" = 1 ]; then [ "$QUIET" = 1 ] || { printf '  [dry-run]'; printf ' %q' "$@"; echo; }; else "$@"; fi; }

# ---------- Funciones retiradas ----------
retire_features() {
  local st="$HOME/.local/state/$NEW" cfg="$HOME/.config/$NEW/settings.json" root
  root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
  # Perfiles de actividad (hf-profile): estado
  local pol=""; [ -f "$st/notify-policy" ] && pol="$(tr -d '[:space:]' < "$st/notify-policy")"
  if { [ "$pol" = favoritos ] || [ "$pol" = silencio ]; } && [ -e "$st/dnd" ] && [ ! -s "$st/dnd" ]; then
    # «no molestar» sin hora de fin junto a la política de un perfil = lo puso el perfil: se quita (también en el
    # shell en marcha). Un «no molestar» con hora de fin, o sin política de perfil, es tuyo y se queda.
    say "Perfiles retirados: quito el «no molestar» que puso el perfil (avisos: $pol)"
    if [ "$DRY" = 0 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v qs >/dev/null; then
      qs -p "$root/config/quickshell" ipc call notifs setDnd false >/dev/null 2>&1 || true
    fi
    run rm -f "$st/dnd"
  fi
  if [ -n "$pol" ] && [ "$pol" != normales ]; then
    say "Perfiles retirados: avisos normales (notify-policy era «$pol»)"
    [ "$DRY" = 1 ] || printf 'normales\n' > "$st/notify-policy"   # por si aún corre el shell antiguo
  fi
  local reload=0 f
  grep -qs 'hl.config' "$st/profile.lua" && reload=1
  for f in profile profile-bar profile.lua notify-policy; do
    [ -e "$st/$f" ] || [ -L "$st/$f" ] || continue
    say "Perfiles retirados: borro $st/$f"
    run rm -f "$st/$f"
  done
  # profile.lua quitaba efectos (perfil Juego): recargar para recuperarlos
  if [ "$reload" = 1 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
    say "Perfiles retirados: recargo Hyprland (profile.lua cambiaba efectos)"
    run hyprctl reload config-only >/dev/null 2>&1 || true
  fi
  # Ajustes
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and any(k in d for k in ("profiles","profileRules","notifyFavorites")) else 1)' "$cfg" 2>/dev/null; then
    local bak="$cfg.antes-sin-perfiles"; [ -e "$bak" ] && bak="$bak-$(date +%Y%m%d-%H%M%S)"
    say "Perfiles retirados: quito profiles, profileRules y notifyFavorites de $cfg (copia: $bak)"
    run cp -p "$cfg" "$bak"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])   # si settings.json es un enlace (dotfiles), se escribe su destino
d = json.load(open(p))
for k in ("profiles", "profileRules", "notifyFavorites"):
    d.pop(k, None)
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Dictado sin IA (dictationAI retirada) y palabra de órdenes «Frijol» → «Distro» (solo si era la de antes)
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and ("dictationAI" in d or str(d.get("dictationWakeWord","")).strip().lower()=="frijol") else 1)' "$cfg" 2>/dev/null; then
    local bak="$cfg.antes-sin-ia-dictado"; [ -e "$bak" ] && bak="$bak-$(date +%Y%m%d-%H%M%S)"
    say "Dictado: quito dictationAI (el dictado ya no usa IA) y la palabra «Frijol» pasa a «Distro» en $cfg (copia: $bak)"
    run cp -p "$cfg" "$bak"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
d.pop("dictationAI", None)
if str(d.get("dictationWakeWord", "")).strip().lower() == "frijol":
    d["dictationWakeWord"] = "Distro"
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Asistente «Samantha» (0.8.13) → «Helpert» (0.8.20); la personalidad solo si era la de fábrica (huella sha256)
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and d.get("aiName")=="Samantha" else 1)' "$cfg" 2>/dev/null; then
    local bak="$cfg.antes-de-helpert"; [ -e "$bak" ] && bak="$bak-$(date +%Y%m%d-%H%M%S)"
    say "Asistente: «Samantha» pasa a llamarse «Helpert» en $cfg (copia: $bak)"
    run cp -p "$cfg" "$bak"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" "$root/config/defaults/settings.json" <<'PY'
import hashlib, json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
new = json.load(open(sys.argv[2]))
d["aiName"] = new["aiName"]
if hashlib.sha256(str(d.get("aiPersona", "")).encode()).hexdigest() == "4f3f37d99edaa9aaf0eb7e2ef2441e9b32049714bbe810e1c75ab60516a18bbd":
    d["aiPersona"] = new["aiPersona"]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Asistente «Helpert» (0.8.20) → «Harper» (0.10.28); la personalidad solo si era la de fábrica (huella sha256)
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and d.get("aiName")=="Helpert" else 1)' "$cfg" 2>/dev/null; then
    local bak="$cfg.antes-de-harper"; [ -e "$bak" ] && bak="$bak-$(date +%Y%m%d-%H%M%S)"
    say "Asistente: «Helpert» pasa a llamarse «Harper» en $cfg (copia: $bak)"
    run cp -p "$cfg" "$bak"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" "$root/config/defaults/settings.json" <<'PY'
import hashlib, json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
new = json.load(open(sys.argv[2]))
d["aiName"] = new["aiName"]
if hashlib.sha256(str(d.get("aiPersona", "")).encode()).hexdigest() == "6e1875ceac777e8354284e96980251112c042d90fbcee9e7c1ae559fca078588":
    d["aiPersona"] = new["aiPersona"]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Web apps (retiradas en 0.8.28): cierra las que sigan abiertas, borra sus lanzadores y el enlace de hf-webapp y
  # quita sus claves de settings.json (copia en settings.json.antes-sin-webapps). Sus sesiones guardadas
  # (~/.local/share/hyprfrijol/webapps) no se tocan: se pueden borrar a mano.
  local apps="$HOME/.local/share/applications" auto="$HOME/.config/autostart" f
  for f in "$apps"/hf-webapp-*.desktop "$auto"/hf-webapp-*.desktop; do
    [ -e "$f" ] || continue
    say "Web apps retiradas: borro el lanzador $f"
    run rm -f "$f"
  done
  if [ -L "$BIN/hf-webapp" ] && [ ! -e "$BIN/hf-webapp" ]; then
    say "Web apps retiradas: borro el enlace roto $BIN/hf-webapp"
    run rm -f "$BIN/hf-webapp"
  fi
  [ "$DRY" = 1 ] || pkill -f 'modules/sidepanel/webapp/host.qml' 2>/dev/null || true
  if [ -f "$cfg" ] && grep -qE '"(webapps|webappEngine|webappPreload)"' "$cfg"; then
    say "Web apps retiradas: quito webapps, webappEngine y webappPreload de $cfg"
    run cp -n "$cfg" "$cfg.antes-sin-webapps"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
for k in ("webapps", "webappEngine", "webappPreload"):
    d.pop(k, None)
if isinstance(d.get("sidePanelApps"), list):
    d["sidePanelApps"] = ["ia"]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # MQTT / Home Assistant (retirado en 0.11.x): las claves ya no se usan.
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); k=("mqttBroker","mqttUser","mqttPasswd","mqttEnabled","mqttHaTopic","mqttServers","mqttImageDir","mqttNewsUrl","mqttNotesFile"); sys.exit(0 if isinstance(d,dict) and any(x in d for x in k) else 1)' "$cfg" 2>/dev/null; then
    say "MQTT retirado: quito sus claves de $cfg (copia: $cfg.antes-sin-mqtt)"
    run cp -n "$cfg" "$cfg.antes-sin-mqtt"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
for k in ("mqttBroker", "mqttUser", "mqttPasswd", "mqttEnabled", "mqttHaTopic", "mqttServers", "mqttImageDir", "mqttNewsUrl", "mqttNotesFile"):
    d.pop(k, None)
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Estilo único Math (0.9.0): SkySoul (y sus nombres de antes) → transparencia; Material y Chroma → sin ella.
  # Se repite sin miedo: solo actúa si «estilo» aún no es «math».
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and d.get("estilo","math")!="math" else 1)' "$cfg" 2>/dev/null; then
    say "Estilo: pasa a Math (Chroma y SkySoul se retiraron; SkySoul queda como «Transparencia») en $cfg"
    run cp -n "$cfg" "$cfg.antes-de-math"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
old = d.get("estilo")
if "transparencia" not in d:
    d["transparencia"] = old in ("skysoul", "aurora", "liquid", "tonal")
d["estilo"] = "math"
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Voz sin conversación (0.11.0): fuera el modo del micrófono, la conversación, el compañero y las respuestas
  # habladas; «asistente» en dictationAiFix pasa a «nunca». La voz de Harper queda solo como lectora (aiVoice).
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); k=("micMode","aiTalkMode","aiConvSilence","aiConvInterrupt","aiCompanion","aiCompanionFreq","aiCompanionLook","aiMuted","aiVoiceLocal","aiScreenAsk"); sys.exit(0 if isinstance(d,dict) and (any(x in d for x in k) or d.get("dictationAiFix")=="asistente") else 1)' "$cfg" 2>/dev/null; then
    say "Ajustes retirados (modo del micrófono, conversación por voz, compañero, preguntar antes de mirar la pantalla) en $cfg"
    run cp -n "$cfg" "$cfg.antes-de-voz-sin-ia"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
for k in ("micMode", "aiTalkMode", "aiConvSilence", "aiConvInterrupt", "aiCompanion", "aiCompanionFreq",
          "aiCompanionLook", "aiMuted", "aiVoiceLocal", "aiScreenAsk"):
    d.pop(k, None)
if d.get("dictationAiFix") == "asistente":
    d["dictationAiFix"] = "nunca"
if d.get("aiAnnounceUrgent") or d.get("aiAnnounceGreet"):   # leer avisos ahora depende de «Leer en voz alta»
    d["aiVoice"] = True
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Personalidad de Harper (0.11.1): la de fábrica de antes (mayordomo de tú) pasa a la nueva (formal, de usted,
  # concisa y con algún sarcasmo). Solo si no la habías cambiado (huella sha256).
  if [ -f "$cfg" ] && python3 -I -c 'import hashlib,json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and hashlib.sha256(str(d.get("aiPersona","")).encode()).hexdigest()=="48a0582337e7ebe8e8c7f8399d5300d2d5a8b3e4a0b3e5ff919f3ec915034077" else 1)' "$cfg" 2>/dev/null; then
    say "Asistente: personalidad nueva de Harper en $cfg (copia: $cfg.antes-de-persona-formal)"
    run cp -n "$cfg" "$cfg.antes-de-persona-formal"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" "$root/config/defaults/settings.json" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
d["aiPersona"] = json.load(open(sys.argv[2]))["aiPersona"]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Barra (0.12.0): un solo botón de Harper (fuera «voz» y «dictado»), sin «Barra viva» ni resumen de avisos
  if [ -f "$cfg" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); m=d.get("barModules") if isinstance(d,dict) else None; sys.exit(0 if isinstance(d,dict) and ("barLive" in d or "notifDigestAuto" in d or (isinstance(m,list) and ("voz" in m or "dictado" in m))) else 1)' "$cfg" 2>/dev/null; then
    say "Barra: dictado y órdenes de voz quedan en el botón de Harper; quito barLive y notifDigestAuto de $cfg"
    run cp -n "$cfg" "$cfg.antes-de-boton-unico"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
d.pop("barLive", None)
d.pop("notifDigestAuto", None)
m = d.get("barModules")
if isinstance(m, list) and ("voz" in m or "dictado" in m):
    if "ia" not in m:
        m = ["ia" if x in ("voz", "dictado") else x for x in m]
    d["barModules"] = list(dict.fromkeys(x for x in m if x not in ("voz", "dictado")))
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Paletas retiradas (0.9.2: 12 temas en pares oscuro y claro): la que tengas pasa a la más parecida.
  # Solo si ya no existe en el repo ni en palettes-user.json (los temas importados no se tocan).
  if [ -f "$cfg" ] && python3 -I - "$cfg" "$root/config/themes/palettes.json" "$HOME/.config/$NEW/palettes-user.json" <<'PY' 2>/dev/null
import json, os, sys
d = json.load(open(sys.argv[1]))
k = d.get("palette") if isinstance(d, dict) else None
have = set(json.load(open(sys.argv[2])))
if os.path.exists(sys.argv[3]):
    have |= set(json.load(open(sys.argv[3])) or {})
sys.exit(0 if k and k not in have else 1)
PY
  then
    say "Paleta retirada: la cambio por la más parecida de las 12 de ahora en $cfg"
    run cp -n "$cfg" "$cfg.antes-de-temas"
    [ "$DRY" = 1 ] || python3 -I - "$cfg" <<'PY'
import json, os, sys
# shortcut: tabla fija de 0.9.2; si se retiran más paletas, se añaden aquí
NEAR = {"pizarra": "grafito", "lavanda": "lila", "verde": "everforest", "ambar": "gruvbox", "azul": "nord",
        "menta": "everforest", "menta-claro": "everforest-claro", "melocoton": "rosa", "melocoton-claro": "rosa-claro",
        "cielo": "nord", "cielo-claro": "nord-claro", "catppuccin-macchiato": "catppuccin-mocha",
        "catppuccin-frappe": "catppuccin-mocha", "tokyo-night-storm": "tokyo-night", "rose-pine-moon": "rose-pine",
        "kanagawa-dragon": "kanagawa", "dracula": "tokyo-night", "alucard": "tokyo-night-dia", "solarized": "nord",
        "solarized-claro": "gruvbox-claro", "one-dark": "tokyo-night", "one-light": "tokyo-night-dia", "ayu": "gruvbox",
        "ayu-claro": "gruvbox-claro", "ayu-mirage": "tokyo-night", "github": "grafito", "github-claro": "claro",
        "flexoki": "gruvbox", "flexoki-claro": "gruvbox-claro", "monokai-pro": "grafito", "nightfox": "tokyo-night",
        "medianoche": "nord", "carbon": "oxocarbon", "bosque": "everforest", "vino": "ciruela", "oceano": "nord",
        "cobre": "gruvbox", "neon": "tokyo-night", "hielo": "nord-claro", "papel": "claro", "arena": "gruvbox-claro",
        "salvia": "everforest-claro"}
p = os.path.realpath(sys.argv[1])
d = json.load(open(p))
d["palette"] = NEAR.get(d.get("palette"), "grafito")
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
os.replace(tmp, p)
PY
  fi
  # Fuente Doto de Chroma (retirada en 0.9.0): el enlace en ~/.local/share/fonts ya no lleva a nada
  if [ -L "$HOME/.local/share/fonts/hyprfrijol/Doto.ttf" ] && [ ! -e "$HOME/.local/share/fonts/hyprfrijol/Doto.ttf" ]; then
    say "Chroma retirado: borro el enlace roto a la fuente Doto"
    run rm -f "$HOME/.local/share/fonts/hyprfrijol/Doto.ttf"
  fi
  # Enlace ~/.local/bin/hf-profile que ya no lleva a nada
  if [ -L "$BIN/hf-profile" ] && [ ! -e "$BIN/hf-profile" ]; then
    say "Perfiles retirados: borro el enlace roto $BIN/hf-profile"
    run rm -f "$BIN/hf-profile"
  fi
  return 0
}
retire_features
say "Limpieza lista$([ "$DRY" = 1 ] && echo ' (dry-run: no se ha cambiado nada)')."
