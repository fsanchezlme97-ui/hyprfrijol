#!/usr/bin/env python3
"""hf-ai — asistente de hyprfrijol (lo usan el panel lateral, el Spotlight «?» y hf-mcp).

  hf-ai chat '<json>'        {"messages":[{"role":"user|ai","text":"…","images":["/ruta.png"]}], "context":{"window":true,"clipboard":true,"capture":false}}
                             → {"text": "...", "actions": [...], "labels": [...], "code": "...", "model": "…", "error": null}
                             Con "stream": true (el panel) responde en directo: líneas {"partial": "texto hasta ahora"}
                             y {"step": "consulta"} mientras llega, y al final {"final": {…lo de arriba…}}.
                             "model": "<id>" repite con otro modelo del mismo proveedor («Repetir con otro modelo»).
  hf-ai ask "pregunta"       atajo de terminal: responde en texto plano
  hf-ai apply '<acciones>'   aplica acciones al shell y guarda cómo deshacerlas → {"undo": "<id>", "labels": [...]}
  hf-ai undo <id>            deshace un apply
  hf-ai log                  registro de acciones: las 30 últimas que se pueden deshacer [{id, time, labels}]
  hf-ai selftest             comprueba el filtro de secretos y las apps privadas
  hf-ai labels '<acciones>'  etiquetas en español de unas acciones (+ plan: ¿se puede deshacer?, ¿pide confirmación?)
  hf-ai query <tipo> [texto] consulta de solo lectura: windows | active_window | screen | notifications | files <texto> |
                             apps <texto> | settings <filtro> | system | timers   (o un JSON {"type":…})
  hf-ai tool <nombre> '<json>'  herramienta (las mismas que hf-mcp): hf-ai tools las lista (approval: si pide aprobación)
  hf-ai approvals            lo «aprobado siempre» (aiAlwaysApprove) con su nombre en español
  hf-ai summon               atajo Super+Ctrl+A: guarda la ventana activa (y su captura) y abre el asistente con ella
  hf-ai timers               temporizadores en marcha (acción "timer")
  hf-ai timer start <min> [etiqueta] | timer cancel <id|all>   temporizador a mano (ventana del pomodoro)
  hf-ai handoff '<json>'     copia la conversación y la abre en Claude Desktop (o `claude` en kitty)
  hf-ai attach <origen>…     adjunta imágenes al chat: clipboard | pick (selector de archivos) | - (base64 por stdin)
                             | ruta | file://… | https://…  → {"images": [rutas], "error": …}
  hf-ai capture [imagen]     captura de pantalla (o la imagen dada) + OCR (tesseract) → texto para el contexto
  hf-ai status               proveedor y disponibilidad
  hf-ai mcp list | check <id> | call <id> <herramienta> '<json>'   servidores MCP del usuario (aiMcpServers):
                             la lista con sus herramientas, comprobar uno (lee y guarda sus herramientas) o probar una
  hf-ai chat --print-request '<json>'   no llama al modelo: imprime la petición que enviaría (sin la clave)
  hf-ai models [proveedor]   modelos que se pueden elegir (por defecto, los del proveedor que responde)
                             → {"models": [[id, nombre]…], "error": …}
  hf-ai test                 prueba la conexión con el proveedor → {"ok": bool, "text": "…"}
  hf-ai transform "instrucción" < texto   aplica la instrucción al texto y lo imprime en plano (hf-dictate)
  hf-ai recipes | recipe <id> | recipe-save '<json>' | recipe-remove <id>   recetas (Resumir, Traducir, Corregir…):
                             la lista, ejecutar una, guardar o borrar una propia (~/.local/share/hyprfrijol/ai-recetas.json)
  hf-ai talk                 hablar con el asistente por voz (como Super + Alt + H): empieza o termina de escuchar
  hf-ai speak "texto" | - | --stop   Helpert lo lee en voz alta (corta lo anterior): voz local Piper (sharvard);
                             sin Piper, Gemini TTS
  hf-ai announce "texto" | - | --greet   Sophia lo anuncia (Gemini TTS, voz aiVoiceName; sin clave o si falla, Helpert).
                             Calla en «no molestar». --greet: saludo con la hora y el tiempo, una vez por sesión
                             (aiAnnounceGreet)
  hf-ai voice-install [--tty]  instala la voz local: venv con piper-tts y la voz es_ES-sharvard-medium (~77 MB)
  hf-ai key status|set|clear gemini   clave de Gemini: set la lee de stdin (o de HF_AI_KEY_IN), nunca de argv

Proveedor (Ajustes › IA, settings.json):
  aiProvider  "claude-code" (CLI `claude -p`, por defecto) | "ollama" | "openai-compatible" | "gemini" | "off"
  aiModel     p. ej. "haiku" / "sonnet" (claude-code), "llama3.2" (ollama), "gpt-4o-mini", "gemini-flash-latest"…
  aiEndpoint  http://localhost:11434 (ollama) · https://api…/v1 (openai-compatible)
  aiKeyEnv    variable de entorno con la clave (openai-compatible), por defecto HF_AI_KEY
  Gemini      clave de https://aistudio.google.com/apikey: $GEMINI_API_KEY / $GOOGLE_API_KEY, o guardada con
              `hf-ai key set gemini` en el llavero (secret-tool) o en ~/.config/hyprfrijol/secrets/gemini.key (600)
Permisos (Ajustes › IA): aiContextCapture (leer capturas adjuntas y la pantalla), aiTerminal (proponer comandos),
  aiControlShell (proponer/aplicar cambios al shell; también lo respeta hf-mcp), aiConfirm (lo aplica el panel),
  aiReadDesktop (consultas de solo lectura: ventanas, avisos, archivos, estado), aiContextWindow (ventanas).
Acciones: ajustes (cualquier clave de settings.json salvo las de la IA, comandos, red y seguridad), fondo, espacios,
  ventanas (enfocar/cerrar/mover/…), abrir apps y webs, música, volumen, brillo, no molestar, cafeína, temporizadores,
  pomodoro, borrar avisos, vistas y comandos de terminal (siempre con confirmación). Casi todas se deshacen.
Consultas: el modelo puede pedir datos con un bloque ```hf-query``` (hasta 3 rondas) antes de responder.
Imágenes: con visión (claude-code por stream-json, Gemini inline_data, OpenAI image_url, Ollama si el modelo tiene
  "vision") se mandan reducidas a 1568 px (ImageMagick); si no, su texto por OCR. aiVision true/false lo fuerza.
Pruebas sin gastar: aiProvider "mock" responde con la lista JSON de $HF_AI_MOCK o ~/.cache/hyprfrijol/ai-mock.json.
"""
import json, os, re, subprocess, sys, time, pathlib, shutil, urllib.request, urllib.error, urllib.parse
for _k, _v in list(os.environ.items()):   # variables HL_* (hypr-liquid): siguen valiendo
    if _k.startswith("HL_"): os.environ.setdefault("HF_" + _k[3:], _v)

HOME = pathlib.Path.home()
ROOT = pathlib.Path(os.environ.get("HF_ROOT") or pathlib.Path(__file__).resolve().parent.parent)
STATE = HOME / ".local/state/hyprfrijol"
UNDO = HOME / ".cache/hyprfrijol/undo"
SETTINGS = HOME / ".config/hyprfrijol/settings.json"
QS = ["qs", "-p", str(ROOT / "config/quickshell")]

# ---------------------------------------------------------------- ajustes
def load(p, d=None):
    try:
        return json.loads(pathlib.Path(p).read_text())
    except Exception:
        return d

def settings():
    s = dict(load(ROOT / "config/defaults/settings.json", {}) or {})
    s.update(load(SETTINGS, {}) or {})
    return s

def jrun(cmd):
    try:
        return json.loads(run(cmd) or "{}") or {}
    except Exception:
        return {}

def run(cmd, timeout=10, input=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input)
        return r.stdout.strip()
    except Exception:
        return ""

