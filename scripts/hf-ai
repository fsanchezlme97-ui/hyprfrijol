def defaults():
    return load(ROOT / "config/defaults/settings.json", {}) or {}

def settable(k, d=None):
    if k in SET_KEYS:
        return True
    d = defaults() if d is None else d
    if k not in d or DENY_KEYS.search(k):
        return False
    v = d[k]
    return isinstance(v, (bool, int, float, str)) or (isinstance(v, list) and all(isinstance(x, str) for x in v))

