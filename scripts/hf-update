#!/usr/bin/env bash
# hf-update — actualiza HYPRFRIJOL (este repo) por versiones etiquetadas (git tags vX.Y.Z).
# No confundir con hf-updates (paquetes del sistema: pacman, Flatpak, firmware).
#
#   hf-update check [--json]      busca versiones nuevas (git fetch --tags) y dice si hay una más reciente
#   hf-update status --json       lo último comprobado, sin red (lo usa Ajustes › Sistema)
#   hf-update list [--json]       versiones disponibles (la actual marcada)
#   hf-update notes [DESDE] [A]   notas de versión entre dos versiones (anotación del tag o CHANGELOG.md)
#   hf-update apply <tag>|latest  cambia a esa versión, ejecuta las migraciones (hf-migrate, hf-apply) y reinicia el shell
#   (antes de cambiar de versión guarda tu perfil: hf-perfil guardar → ~/.config/hyprfrijol/perfil.json)
#   hf-update rollback            vuelve a la versión anterior a la última actualización (o al tag anterior)
#   hf-update auto                comprobación periódica (hfUpdateCheck: weekly|daily|never) con aviso
#
# Opciones: --repo DIR (clon a actualizar; por defecto el de este script) · --remote NOMBRE (origin)
#           --stash (guarda tus cambios locales con git stash antes) · --yes · --no-restart · --no-fetch
# Con cambios locales sin guardar no actualiza: lo dice y ofrece --stash. Nunca hace push.
set -uo pipefail
for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
REPO="${HF_UPDATE_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
REMOTE=origin STASH=0 YES=0 RESTART=1 FETCH=1 JSON=0 ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="$2"; shift ;; --remote) REMOTE="$2"; shift ;;
    --stash) STASH=1 ;; --yes|-y) YES=1 ;; --no-restart) RESTART=0 ;; --no-fetch) FETCH=0 ;; --json) JSON=1 ;;
    -h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
CMD="${1:-check}"; shift || true

STATE="$HOME/.local/state/hyprfrijol"
CACHE="$HOME/.cache/hyprfrijol"
HIST="$STATE/hf-update-history"       # una línea por cambio: fecha \t repo \t rev anterior \t desc anterior \t destino
LAST="$CACHE/hf-update.json"          # resultado del último check
mkdir -p "$STATE" "$CACHE"
G() { git -C "$REPO" "$@"; }
if [ -t 1 ]; then B=$'\033[1m' C=$'\033[1;36m' Y=$'\033[1;33m' R=$'\033[1;31m' Z=$'\033[0m'; else B="" C="" Y="" R="" Z=""; fi
say()  { printf '%s▸%s %s\n' "$C" "$Z" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$Z" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$R" "$Z" "$1" >&2; exit "${2:-1}"; }
have() { command -v "$1" >/dev/null 2>&1; }
setting() { # setting <clave> <defecto>
  local f v
  for f in "$HOME/.config/hyprfrijol/settings.json" "$REPO/config/defaults/settings.json"; do
    v="$(jq -r --arg k "$1" 'if has($k) then .[$k] | tostring else empty end' "$f" 2>/dev/null)" && [ -n "$v" ] && { echo "$v"; return; }
  done
  echo "$2"
}

if ! G rev-parse --git-dir >/dev/null 2>&1; then
  # Instalado con un paquete (hyprfrijol-git del AUR, en /opt): lo actualiza el gestor de paquetes
  pkg="$(command -v pacman >/dev/null && pacman -Qqo "$REPO/scripts/hf-update" 2>/dev/null)"
  if [ -n "$pkg" ]; then
    case "$CMD" in
      auto) exit 0 ;;
      status|check) [ "$JSON" = 1 ] && { printf '{"packaged":true,"package":"%s","msg":"Se actualiza con tu ayudante del AUR (paru -Syu o yay -Syu)"}\n' "$pkg"; exit 0; } ;;
    esac
    die "HyprFrijol está instalado con el paquete $pkg: actualízalo con tu ayudante del AUR (paru -Syu o yay -Syu)" 0
  fi
  die "$REPO no es un clon de git: no se puede actualizar con hf-update (vuelve a instalar con el bootstrap)"
fi

# Versiones: solo X.Y.Z (con o sin «v»), de más nueva a más vieja
tags() { G tag -l | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sort -V -r; }
current_tag() { G describe --tags --exact-match HEAD 2>/dev/null | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | head -n1; }
base_tag() { G describe --tags --abbrev=0 --match 'v[0-9]*' HEAD 2>/dev/null || G describe --tags --abbrev=0 HEAD 2>/dev/null; }
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "${1#v}" "${2#v}" | sort -V | tail -n1)" = "${1#v}" ]; }   # newer A B → A > B
dirty() { [ -n "$(G status --porcelain --untracked-files=no 2>/dev/null)" ]; }
fetch() {
  [ "$FETCH" = 1 ] || return 0
  G remote get-url "$REMOTE" >/dev/null 2>&1 || { warn "El clon no tiene el remoto «$REMOTE»"; return 1; }
  GIT_TERMINAL_PROMPT=0 timeout 60 git -C "$REPO" fetch -q --tags --force "$REMOTE" 2>/dev/null || { warn "No se pudo consultar $REMOTE (¿sin red?)"; return 1; }
}

tag_date() { G log -1 --format=%cs "$1" 2>/dev/null; }
tag_subject() { G tag -l --format='%(contents:subject)' "$1" 2>/dev/null | head -n1; }

# Notas de una versión: anotación del tag; si no tiene (tag ligero), su sección de CHANGELOG.md
notes_for() {
  local t="$1" body
  body="$(G tag -l --format='%(contents)' "$t" 2>/dev/null | sed '/-----BEGIN PGP SIGNATURE-----/,$d')"
  if [ "$(G cat-file -t "$t" 2>/dev/null)" = tag ] && [ -n "$(printf '%s' "$body" | tr -d '[:space:]')" ]; then printf '%s\n' "$body"; return; fi
  G show "$t:CHANGELOG.md" 2>/dev/null | awk -v v="${t#v}" '
    /^## / { if (on) exit; if (index($0, "[" v "]") || $2 == v || $2 == "v" v || index($0, " " v " ")) { on = 1; next } }
    on { print }'
}
notes() { # notes DESDE A → todas las versiones en (DESDE, A], de la más nueva a la más vieja
  local from="${1:-}" to="${2:-}" t
  [ -n "$to" ] || to="$(tags | head -n1)"
  for t in $(tags); do
    newer "$t" "$to" && continue
    [ -n "$from" ] && ! newer "$t" "$from" && continue
    echo "${B}── $t$Z  ($(tag_date "$t"))"
    notes_for "$t" | sed '/^[[:space:]]*$/N;/^\n$/D'
    echo
  done
}

status_json() {
  local cur base latest br
  cur="$(current_tag)"; base="$(base_tag)"; latest="$(tags | head -n1)"
  br="$(G symbolic-ref --short -q HEAD || echo "")"
  local up=false; [ -n "$latest" ] && newer "$latest" "${cur:-${base:-0.0.0}}" && up=true
  local prev; prev="$(tail -n1 "$HIST" 2>/dev/null | awk -F'\t' -v r="$REPO" '$2 == r {print $4}')"
  jq -n --arg repo "${REPO/#$HOME/\~}" --arg cur "$cur" --arg base "$base" --arg latest "$latest" --arg br "$br" \
        --arg rev "$(G rev-parse --short HEAD)" --argjson dirty "$(dirty && echo true || echo false)" \
        --argjson up "$up" --arg checked "$(date -Iseconds)" --arg prev "$prev" \
        --arg notes "$( [ "$up" = true ] && notes "${cur:-$base}" "$latest" | sed -E 's/\x1b\[[0-9;]*m//g' | head -c 4000)" \
        --arg every "$(setting hfUpdateCheck weekly)" \
    '{ repo: $repo, current: (if $cur != "" then $cur else null end), base: (if $base != "" then $base else null end),
       rev: $rev, branch: $br, dirty: $dirty, latest: (if $latest != "" then $latest else null end), update: $up,
       notes: $notes, rollback: (if $prev != "" then $prev else null end), checked: $checked, every: $every }'
}

check() {
  fetch || true
  local j; j="$(status_json)"; printf '%s\n' "$j" > "$LAST"
  if [ "$JSON" = 1 ]; then printf '%s\n' "$j"; return; fi
  local cur latest up
  cur="$(jq -r '.current // .base // "sin versión"' <<<"$j")"; latest="$(jq -r '.latest // ""' <<<"$j")"; up="$(jq -r .update <<<"$j")"
  echo "HyprFrijol $cur ($(G rev-parse --short HEAD)$(dirty && echo ", con cambios locales")) en ${REPO/#$HOME/\~}"
  if [ -z "$latest" ]; then echo "No hay versiones publicadas (tags vX.Y.Z) en $REMOTE."
  elif [ "$up" = true ]; then echo "${B}Hay una versión nueva: $latest$Z  →  hf-update apply $latest"; echo; notes "$cur" "$latest"
  else echo "Estás en la última versión ($latest)."; fi
}

list() {
  local cur; cur="$(current_tag)"
  if [ "$JSON" = 1 ]; then
    local t; for t in $(tags); do jq -n --arg t "$t" --arg d "$(tag_date "$t")" --arg s "$(tag_subject "$t")" --argjson c "$([ "$t" = "$cur" ] && echo true || echo false)" '{tag:$t, date:$d, subject:$s, current:$c}'; done | jq -s .
    return
  fi
  [ -n "$(tags)" ] || { echo "No hay versiones (tags vX.Y.Z). Prueba hf-update check."; return; }
  local t; for t in $(tags); do printf '  %s %-10s %s  %s\n' "$([ "$t" = "$cur" ] && echo "●" || echo " ")" "$t" "$(tag_date "$t")" "$(tag_subject "$t")"; done
}

ask() { [ "$YES" = 1 ] && return 0; [ -t 0 ] || return 1; local r; read -r -p "$1 [s/N] " r; [[ "$r" =~ ^[sSyY] ]]; }

ensure_clean() {
  dirty || return 0
  warn "El repo tiene cambios locales sin guardar:"; G status --short --untracked-files=no | head -n 15 >&2
  if [ "$STASH" = 1 ] || { [ -t 0 ] && YES=0 ask "¿Guardarlos con git stash (los recuperas con «git -C ${REPO/#$HOME/\~} stash pop»)?"; }; then
    G stash push -q -m "hf-update $(date '+%F %T')" || die "git stash falló"
    say "Cambios guardados en git stash"
  else
    die "No actualizo con cambios locales. Guárdalos (git commit / git stash) o usa --stash." 3
  fi
}

# Tras cambiar de versión: enlaces nuevos en ~/.local/bin, migraciones, ajustes y shell
post_update() {
  local bin="$HOME/.local/bin" s n=0
  if [ -L "$bin/hf-apply" ] && [ "$(readlink -f "$bin/hf-apply")" = "$REPO/scripts/hf-apply" ]; then
    for s in "$REPO"/scripts/hf-*; do
      [ -f "$s" ] || continue; [ -x "$s" ] || chmod +x "$s"
      [ -e "$bin/$(basename "$s")" ] || [ -L "$bin/$(basename "$s")" ] || { ln -s "$s" "$bin/$(basename "$s")" && n=$((n + 1)); }
    done
    [ "$n" -gt 0 ] && say "Enlaces nuevos en ~/.local/bin: $n"
  fi
  [ -x "$REPO/scripts/hf-migrate" ] && { "$REPO/scripts/hf-migrate" --no-repo --quiet >/dev/null 2>&1 || warn "hf-migrate avisó de algo (ejecútalo a mano para verlo)"; }
  if [ -x "$REPO/scripts/hf-apply" ]; then
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -n "${HF_SESSION:-}" ] && [ "$RESTART" = 1 ]; then HF_ROOT="$REPO" "$REPO/scripts/hf-apply" >/dev/null 2>&1
    else HF_ROOT="$REPO" "$REPO/scripts/hf-apply" --no-reload >/dev/null 2>&1; fi || warn "hf-apply falló: si algo se ve mal, hf-safe menu"
  fi
  if [ "$RESTART" = 1 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -n "${HF_SESSION:-}" ] && [ -x "$REPO/scripts/hf-shell" ]; then
    say "Reiniciando el shell…"; HF_ROOT="$REPO" "$REPO/scripts/hf-shell" restart
  fi
  [ -x "$REPO/scripts/hf-safe" ] && "$REPO/scripts/hf-safe" snapshot "tras actualizar a $(G describe --tags --always)" >/dev/null 2>&1 || true
}

switch_to() { # switch_to <destino> <nota>
  local to="$1" prev prevd
  prev="$(G rev-parse HEAD)"; prevd="$(G describe --tags --always 2>/dev/null)"
  [ "$(G rev-parse "$to^{commit}" 2>/dev/null)" = "$prev" ] && { say "Ya estás en $to"; return 0; }
  G checkout -q --detach "$to" || die "git checkout $to falló"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$REPO" "$prev" "$prevd" "$to" >> "$HIST"
  say "HyprFrijol: $prevd → $(G describe --tags --always HEAD)"
  post_update
  rm -f "$LAST"
  say "Listo. Si algo falla: hf-update rollback (o, desde el login, «HyprFrijol (modo seguro)»)."
}

apply() {
  local to="${1:-}"
  [ -n "$to" ] || die "Uso: hf-update apply <tag>|latest (mira hf-update list)"
  ensure_clean
  fetch || true
  [ "$to" = latest ] && { to="$(tags | head -n1)"; [ -n "$to" ] || die "No hay versiones publicadas"; }
  G rev-parse -q --verify "refs/tags/$to" >/dev/null || die "No existe la versión $to (hf-update list)"
  local cur; cur="$(current_tag)"; [ -n "$cur" ] || cur="$(base_tag)"
  if [ -n "$cur" ] && newer "$to" "$cur"; then echo; notes "$cur" "$to"
  else echo; echo "${B}── $to$Z"; notes_for "$to"; echo; fi
  [ -n "$cur" ] && newer "$cur" "$to" && warn "$to es anterior a la versión actual ($cur)"
  ask "¿Actualizar HyprFrijol a $to?" || { [ -t 0 ] && die "Cancelado" 0; die "Sin terminal: usa --yes" 2; }
  # Foto de cómo está el equipo antes de cambiar nada (hf-perfil aplicar la recrea en otro equipo o tras reinstalar)
  [ -x "$REPO/scripts/hf-perfil" ] && "$REPO/scripts/hf-perfil" guardar --quiet >/dev/null 2>&1
  switch_to "$to"
}

rollback() {
  ensure_clean
  local prev
  prev="$(awk -F'\t' -v r="$REPO" '$2 == r {p = $3} END {print p}' "$HIST" 2>/dev/null)"
  if [ -z "$prev" ] || ! G cat-file -e "$prev^{commit}" 2>/dev/null; then
    local cur; cur="$(current_tag)"; [ -n "$cur" ] || cur="$(base_tag)"
    prev="$(tags | awk -v c="$cur" 'f {print; exit} $0 == c {f = 1}')"
    [ -n "$prev" ] || die "No sé a qué volver: no hay historial de hf-update ni una versión anterior a ${cur:-la actual}"
  fi
  local d; d="$(G describe --tags --always "$prev")"
  say "Volver a $d"
  ask "¿Volver a la versión anterior ($d)?" || { [ -t 0 ] && die "Cancelado" 0; die "Sin terminal: usa --yes" 2; }
  switch_to "$prev"
}

auto() {
  local every; every="$(setting hfUpdateCheck weekly)"
  local secs; case "$every" in daily) secs=86400 ;; never|off|false) exit 0 ;; *) secs=604800 ;; esac
  local stamp="$STATE/hf-update-last-check" now; now="$(date +%s)"
  [ -f "$stamp" ] && [ $((now - $(stat -c %Y "$stamp"))) -lt "$secs" ] && exit 0
  [ "${1:-}" = --now ] || sleep 90                        # que la sesión termine de arrancar
  G remote get-url "$REMOTE" >/dev/null 2>&1 || exit 0     # copia sin remoto (desarrollo): nada que buscar
  fetch || exit 0
  touch "$stamp"
  local j; j="$(status_json)"; printf '%s\n' "$j" > "$LAST"
  [ "$(jq -r .update <<<"$j")" = true ] || exit 0
  local latest; latest="$(jq -r .latest <<<"$j")"
  grep -qxF "$latest" "$STATE/hf-update-notified" 2>/dev/null && exit 0
  echo "$latest" >> "$STATE/hf-update-notified"
  have notify-send || exit 0
  local act
  act="$(timeout 600 notify-send -a HyprFrijol -i system-software-update -w -A ver="Ver novedades" \
        "HyprFrijol $latest disponible" "Tienes $(jq -r '.current // .base // "una versión anterior"' <<<"$j"). Actualiza desde Ajustes › Sistema." 2>/dev/null)"
  [ "$act" = ver ] && qs -p "$REPO/config/quickshell" ipc call settings open sistema >/dev/null 2>&1
  exit 0
}

case "$CMD" in
  check)    check ;;
  status)   if [ -s "$LAST" ]; then cat "$LAST"; else FETCH=0; status_json; fi ;;
  list)     [ "$FETCH" = 1 ] && [ "$JSON" = 0 ] && { fetch || true; }; list ;;
  notes)    notes "${1:-$(current_tag)}" "${2:-}" | { [ "$JSON" = 1 ] && jq -R -s '{notes: .}' || cat; } ;;
  apply)    apply "${1:-}" ;;
  rollback) rollback ;;
  auto)     auto "${1:-}" ;;
  *) die "Orden desconocida: $CMD (usa --help)" ;;
esac
