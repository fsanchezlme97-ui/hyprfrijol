# Herramientas que pueden borrar o quitar algo sin vuelta atrás (hf-mcp lo anuncia como destructiveHint)
DESTRUCTIVE_TOOLS = {"window_action", "clear_notifications", "device_action", "download_control", "browser_control"}

def tool_call(name, args):
    t = next((x for x in TOOL_SPECS if x[0] == name), None)
    if not t:
        return {"error": f"Herramienta desconocida: {name}"}
    q = t[4](args or {})
    if t[3] == "query":
        lab, res = run_query(q, {"window": True})
        res = redact(res)[0]   # también por MCP (Claude Desktop…): el filtro de secretos vale para todo lo que sale
        try:
            return {"result": json.loads(res)}
        except Exception:
            return {"result": res}
    acts = validate([{k: v for k, v in q.items() if v is not None}])
    if not acts:
        return {"error": "Acción no válida (revisa los argumentos; ¿existe la app o la ventana?)"}
    return do_apply(acts)

PROVIDERS["mock"] = call_mock

# «Seguir en…» del panel: lleva la conversación (y el contexto elegido) a otra herramienta de IA. Ajuste aiHandoff:
#   "auto" (por defecto: la del proveedor si está instalada; si no, la primera que haya) · "off" · el id de una de
#   HANDOFF_TARGETS · "custom" = aiHandoffCmd, una orden cualquiera con {prompt} (el texto) o {file} (un .md con él),
#   p. ej. «kitty -e mi-agente --prompt {prompt}»; sin marcador se abre tal cual con el texto en el portapapeles.
# cli = se abre en la terminal con el texto como argumento · app = se abre la app y el texto queda en el portapapeles.
HANDOFF_TARGETS = [
    {"id": "t3code", "label": "T3 Code", "bin": ["t3code"], "kind": "app"},
    {"id": "claude-desktop", "label": "Claude Desktop", "bin": ["claude-desktop", "claude-desktop-bin"], "kind": "app"},
    {"id": "claude-code", "label": "Claude Code", "bin": ["claude"], "kind": "cli", "args": ["{prompt}"]},
    {"id": "codex", "label": "Codex", "bin": ["codex"], "kind": "cli", "args": ["{prompt}"]},
    {"id": "gemini-cli", "label": "Gemini CLI", "bin": ["gemini"], "kind": "cli", "args": ["-i", "{prompt}"]},
    {"id": "qwen-code", "label": "Qwen Code", "bin": ["qwen"], "kind": "cli", "args": ["-i", "{prompt}"]},
    {"id": "opencode", "label": "opencode", "bin": ["opencode"], "kind": "cli", "args": ["--prompt", "{prompt}"]},
    {"id": "cursor", "label": "Cursor", "bin": ["cursor"], "kind": "app"},
    {"id": "zed", "label": "Zed", "bin": ["zed", "zeditor"], "kind": "app"},
]
PROVIDER_HARNESS = {"claude-code": "claude-code", "gemini": "gemini-cli", "openai": "codex"}

def handoff_targets():
    out = []
    for t in HANDOFF_TARGETS:
        b = next((which_cli(x) for x in t["bin"] if which_cli(x)), None)
        if b:
            out.append(dict(t, path=b))
    return out

def handoff_target(s=None):
    """El destino elegido (dict con id, label, kind…) o None si está apagado o no hay ninguno."""
    s = s or settings()
    want = s.get("aiHandoff") or "auto"
    if want == "off":
        return None
    if want == "custom":
        cmd = (s.get("aiHandoffCmd") or "").strip()
        return {"id": "custom", "label": (s.get("aiHandoffLabel") or "").strip() or "mi herramienta", "kind": "custom", "cmd": cmd} if cmd else None
    found = handoff_targets()
    if want != "auto":
        return next((t for t in found if t["id"] == want), None)
    pref = PROVIDER_HARNESS.get(s.get("aiProvider") or "")
    return next((t for t in found if t["id"] == pref), None) or (found[0] if found else None)

def do_handoff(req):
    msgs = req.get("messages") or []
    md = "Conversación desde el panel de hyprfrijol:\n\n" + transcript(msgs)
    ctx = redact(gather(req.get("context") or {}))[0]
    if ctx:
        md += "\n\n---\n" + ctx
    subprocess.run(["wl-copy"], input=md, text=True)
    # la conversación es privada: en la carpeta del usuario en /run (XDG_RUNTIME_DIR), solo legible por él
    f = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or HOME / ".cache/hyprfrijol") / "hf-handoff.md"
    f.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(md)
    t = handoff_target()
    if not t:
        return {"target": "clipboard", "text": "Copiada al portapapeles", "sub": "No hay ninguna herramienta para seguir la conversación"}
    # un argumento no puede pasar de 128 KB: con más, se le pasa el archivo
    prompt = md if len(md.encode()) < 120000 else f"Lee {f} (la conversación y su contexto) y sigue desde ahí."
    fill = lambda a: a.replace("{prompt}", prompt).replace("{file}", str(f))
    run = lambda argv: subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        if t["kind"] == "cli":
            term = settings().get("terminal") or "kitty"
            run([term, "-e", t["path"]] + [fill(a) for a in t["args"]])
            return {"target": t["id"], "text": "Abierta en " + t["label"], "sub": "Se envió la conversación y el contexto que elegiste"}
        if t["kind"] == "custom":
            argv = shlex.split(t["cmd"])
            sent = any("{prompt}" in a or "{file}" in a for a in argv)
            run([fill(a) for a in argv])
            return {"target": "custom", "text": "Abierta en " + t["label"],
                    "sub": "Se envió la conversación" if sent else "La conversación está en el portapapeles: pégala con Ctrl+V"}
        run([t["path"]])
        return {"target": t["id"], "text": "Abierta en " + t["label"], "sub": "La conversación está en el portapapeles: pégala con Ctrl+V"}
    except (OSError, ValueError) as e:
        return {"target": "clipboard", "text": "Copiada al portapapeles", "sub": f"No se pudo abrir {t['label']} ({e.__class__.__name__})"}

def status():
    s = settings()
    prov = s.get("aiProvider") or "claude-code"
    ok, hint = True, ""
    if prov == "claude-code":
        ok = bool(shutil.which("claude"))
        hint = "" if ok else "Falta el comando claude"
    elif prov == "gemini":
        ok = bool(gemini_key()[0])
        hint = "" if ok else "Falta la clave"
    elif prov == "opencode":
        ok = bool(which_cli("opencode"))
        hint = "" if ok else "Falta el comando opencode"
    elif prov == "cli":
        ok = bool(next((x for x in local_clis() if x["id"] == s.get("aiCli") and x["provider"] == "cli"), None))
        hint = "" if ok else "No encuentro esa IA de terminal"
    elif prov == "off":
        ok, hint = False, "Desactivado"
    if prov == "gemini":
        model = gemini_model(s)
    elif prov == "opencode":
        # el elegido en Ajustes o, si no hay ninguno, el de la configuración de OpenCode (no hace falta el servicio)
        model = str(s.get("aiModel") or "").strip() or opencode_configured() or OPENCODE_DEFAULT
    else:
        model = str(s.get("aiModel") or "").strip()
    cap = {"in": [], "out": [], "label": ""}
    if ok:
        try:
            cap = caps(prov, s)
        except Exception:
            pass
    return {"provider": prov, "model": model, "available": ok, "hint": hint,
            "caps": cap,
            "desktop": bool(shutil.which("claude-desktop") or shutil.which("claude-desktop-bin")), "voiceLocal": piper_ready()}

def caps(prov=None, s=None):
    """Las prestaciones del proveedor elegido: qué admite y qué devuelve, además del texto.
    → {"in": [...], "out": [...], "label": "ve imágenes"}"""
    s = s if s is not None else settings()
    prov = prov or (s.get("aiProvider") or "claude-code")
    cin, cout = [], []
    if prov == "opencode":
        c = opencode_caps(opencode_model_id(s))
        cin, cout = c.get("in") or [], c.get("out") or []
    elif prov == "ollama":
        try:
            ep = ollama_ep(s)
            cl = http_json(ep + "/api/show", {"model": s.get("aiModel") or "gemma4:e4b"}, timeout=5).get("capabilities") or []
            if "vision" in cl:
                cin = ["image"]
        except Exception:
            pass
    elif prov in ("claude-code", "gemini"):
        cin = ["image"]           # los dos aceptan imágenes
    elif prov == "openai-compatible":
        cin = []                  # depende del modelo; no se presupone
    return {"in": cin, "out": cout, "label": cap_label({"in": cin})}

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return
    cmd, rest = argv[0], argv[1:]
    arg = rest[0] if rest else ""
    stdin_text = None
    if arg == "-" and cmd != "attach":
        arg = stdin_text = sys.stdin.read()
    if cmd == "chat":
        pr = "--print-request" in rest or "--dry-run" in rest
        rest = [r for r in rest if r not in ("--print-request", "--dry-run")]
        arg = rest[0] if rest else ""
        if arg == "-":                       # «hf-ai chat --dry-run -»: la entrada ya se leyó arriba si iba primero
            arg = stdin_text if stdin_text is not None else sys.stdin.read()
        req = json.loads(arg or "{}")
        if req.get("stream") and not pr:
            global LIVE
            LIVE = Live()
            t0 = time.time()
            try:
                out = do_chat(req)
            except Exception as e:   # que el panel reciba siempre su línea final
                out = {"text": "", "actions": [], "labels": [], "code": "", "error": f"hf-ai falló: {e}"[:300]}
            LIVE.emit({"final": out})
            log_activity(req, out, time.time() - t0, "panel"); return
        t0 = time.time()
        out = do_chat(req, print_request=pr)
        if pr:
            print(json.dumps(out, ensure_ascii=False, indent=2)); return
        log_activity(req, out, time.time() - t0, "panel")
    elif cmd == "ask":
        t0, req = time.time(), {"messages": [{"role": "user", "text": " ".join(rest)}], "context": {"window": False, "clipboard": False}}
        out = do_chat(req)
        log_activity(req, out, time.time() - t0, "terminal")
        print(out.get("error") or out["text"])
        if out.get("labels"):
            print("\nCambios propuestos: " + " · ".join(out["labels"]))
        return
    elif cmd == "apply":
        out = do_apply(json.loads(arg))
    elif cmd == "log":                      # registro de acciones (lo que aún se puede deshacer), lo más nuevo arriba
        out = []
        for f in sorted(UNDO.glob("*.json"), reverse=True):
            rec = load(f, {}) or {}
            out.append({"id": f.stem, "time": time.strftime("%d/%m %H:%M", time.localtime(f.stat().st_mtime)),
                        "labels": [label(a) for a in rec.get("actions") or []]})
    elif cmd == "activity":                 # registro del asistente: activity [n] | activity clear
        out = clear_activity() if arg == "clear" else activity(int(arg) if arg.isdigit() else 200)
    elif cmd in ("save-svg", "open-svg"):    # «Guardar» / «Abrir en grande» de un esquema del panel
        out = save_svg(arg, rest[1] if len(rest) > 1 else "{}", open_it=cmd == "open-svg")
    elif cmd == "selftest":
        _selftest_redact()
        _selftest_handoff()
        _selftest_reply()
        _selftest_bool()
        _selftest_name()
        _selftest_files()
        _selftest_queries()
        _selftest_file_intent()
        _selftest_choice()
        _selftest_svg()
        _selftest_converse()
        out = {"ok": True}
    elif cmd == "undo":
        out = do_undo(arg)
    elif cmd == "labels":
        acts = validate(json.loads(arg))
        out = {"labels": [label(a) for a in acts], "plan": [meta(a) for a in acts],
               "auto": bool(acts) and all(meta(a)["kind"] in set(settings().get("aiAlwaysApprove") or []) and not meta(a)["confirm"] for a in acts)}
    elif cmd == "query":
        q = json.loads(arg) if arg.strip().startswith("{") else {"type": arg, **({"query": rest[1], "filter": rest[1]} if len(rest) > 1 else {})}
        lab, res = run_query(q, {"window": True, "screenOk": True})   # la escribes tú en la terminal
        out = {"label": lab, "result": res}
    elif cmd == "tool":
        out = tool_call(arg, json.loads(rest[1]) if len(rest) > 1 else {})
    elif cmd == "tools":
        out = [{"name": n, "description": d, "kind": k, "approval": k == "action"} for n, d, _, k, _ in TOOL_SPECS]
    elif cmd == "summon":
        out = do_summon()
    elif cmd == "approvals":
        # hf-ai approvals → [{kind, label}] de lo «aprobado siempre» (aiAlwaysApprove; lo revoca Ajustes › IA)
        out = [{"kind": k, "label": kind_label(k)} for k in (settings().get("aiAlwaysApprove") or [])]
    elif cmd == "timers":
        out = timers_list()
    elif cmd == "timer":
        # hf-ai timer start <min> [etiqueta…] · hf-ai timer cancel <id|all>
        if arg == "start" and len(rest) > 1:
            try:
                mins = float(rest[1].replace(",", "."))
            except ValueError:
                raise SystemExit("minutos no válidos: " + rest[1])
            if not 0 < mins <= 24 * 60:
                raise SystemExit("minutos fuera de rango (0–1440)")
            out = {"id": timer_start(mins, " ".join(rest[2:]).strip()[:60]), "timers": timers_list()}
        elif arg == "cancel" and len(rest) > 1:
            timer_cancel(rest[1]); out = {"timers": timers_list()}
        else:
            raise SystemExit("uso: hf-ai timer start <min> [etiqueta] | hf-ai timer cancel <id|all>")
    elif cmd == "handoff":
        out = do_handoff(json.loads(arg or "{}"))
    elif cmd == "handoff-targets":
        # lo instalado y el destino elegido (el panel pone «Seguir en <label> ↗» si hay uno)
        cur = handoff_target()
        out = {"targets": [{"id": t["id"], "label": t["label"], "kind": t["kind"]} for t in handoff_targets()],
               "current": {"id": cur["id"], "label": cur["label"]} if cur else None}
    elif cmd == "attach":
        # hf-ai attach clipboard | pick | - (base64 por stdin) | <ruta | file://… | https://…> [más…]
        out = {"images": [], "error": None}
        for src in (rest or ["clipboard"]):
            r = do_attach(src)
            out["images"] += [p for p in r["images"] if p not in out["images"]]
            out.setdefault("files", [])
            out["files"] += [p for p in r.get("files", []) if p not in out["files"]]
            out["error"] = out["error"] or r["error"]
        if out["images"] or out.get("files"):
            out["error"] = None
    elif cmd == "capture":
        out = {"text": capture_text(arg or None)}
    elif cmd == "peek":
        out = peek()
    elif cmd == "status":
        out = status()
    elif cmd == "clis":
        out = {"clis": local_clis()}
    elif cmd == "mcp":
        # hf-ai mcp list | check <id> | call <id> <herramienta> '<json>'
        if arg == "check" and len(rest) > 1:
            out = mcp_check(rest[1])
        elif arg == "call" and len(rest) > 2:
            try:
                r = mcp_call(rest[1], rest[2], json.loads(rest[3]) if len(rest) > 3 else {})
                out = {"ok": not r.get("isError"), "text": mcp_result_text(r)}
            except (McpError, ValueError) as e:
                out = {"ok": False, "error": str(e)}
        else:
            s = settings()
            cache = mcp_cache()
            out = {"localOnly": local_only(s), "servers": [
                {**{k: x.get(k) for k in ("id", "name", "command", "url", "authEnv", "enabled", "autoRead")},
                 "tools": [{k: t[k] for k in ("name", "title", "description", "readOnly")} for t in mcp_entry(x, cache).get("tools") or []],
                 "checked": mcp_entry(x, cache).get("checked"), "error": mcp_entry(x, cache).get("error"),
                 "urlProblem": mcp_url_problem(x["url"]) if x.get("url") else None}
                for x in mcp_servers(dict(s, aiLocalOnly=False), enabled_only=False)]}
    elif cmd == "models":
        prov = arg or provider_for(settings())[0]      # el que responde de verdad (en modo local, Ollama)
        out = models_for(prov)
    elif cmd == "caps":
        # hf-ai caps [proveedor] → qué admite y qué devuelve el modelo elegido
        s = settings()
        prov = arg or provider_for(s)[0]
        out = {"provider": prov, "model": model_name(prov, s), **caps(prov, s)}
    elif cmd == "test":
        out = test_provider()
    elif cmd == "transform":
        # hf-ai transform "<instrucción>" < texto  → texto transformado en plano (lo usa hf-dictate)
        text = sys.stdin.read()
        try:
            print(transform_text(" ".join(rest), text) or text.strip())
        except AIError as e:
            print(text.strip()); print(str(e), file=sys.stderr); sys.exit(1)
        return
    elif cmd == "dictfix":
        # hf-ai dictfix '{"vocab": "…", "before": "…"}' < texto  → texto corregido en plano (lo usa hf-dictate)
        text = sys.stdin.read()
        opts = json.loads(arg) if arg.strip().startswith("{") else {}
        try:
            print(dictation_fix(text, opts.get("vocab", ""), opts.get("before", "")) or text.strip())
        except AIError as e:
            print(text.strip()); print(str(e), file=sys.stderr); sys.exit(1)
        return
    elif cmd == "recipes":
        out = recipes()
    elif cmd == "recipe":
        out = run_recipe(arg)
    elif cmd == "recipe-save":
        out = recipe_save(json.loads(arg))
    elif cmd == "recipe-remove":
        out = recipe_remove(arg)
    elif cmd == "speak":
        if arg == "--stop":
            speak_stop(); out = {"ok": True, "error": ""}
        else:
            out = speak(arg)
    elif cmd == "voice-warm":                # la conversación empieza: que la primera respuesta ya suene al momento
        c = voice_conn()
        out = {"ok": bool(c), "error": "" if c else "La voz local no está instalada"}
        if c:
            c.close()
        ollama_warm()
    elif cmd == "announce":
        out = greet() if arg == "--greet" else announce(arg)
    elif cmd == "voice-install":
        sys.exit(voice_install(tty="--tty" in rest))
    elif cmd == "key":
        sub, prov = (rest + ["", ""])[:2]
        prov = prov or "gemini"
        if sub == "set":
            k = os.environ.get("HF_AI_KEY_IN") or ("" if sys.stdin.isatty() else sys.stdin.read())
            out = key_set(prov, k)
        elif sub == "clear":
            out = key_clear(prov)
        else:
            out = key_status(prov)
    else:
        print(f"Orden desconocida: {cmd}", file=sys.stderr); sys.exit(1)
    print(json.dumps(out, ensure_ascii=False))

if __name__ == "__main__":
    main(sys.argv[1:])
