#!/usr/bin/env bash
# hf-profile — perfiles de actividad
#   hf-profile <trabajo|diseno|juego|personal>
#   hf-profile next | current | list | show [perfil]
# Cada perfil cambia: ajustes de Hyprland, modo de energía, avisos («no molestar»), fondo, apps y pomodoro.
# Se configuran en ~/.config/hyprfrijol/settings.json → "profiles": { "<perfil>": { … } } (se mezcla con los
# valores por defecto de abajo). Campos: wallpaper (ruta; si no, <carpeta de fondos>/perfiles/<perfil>.*),
# apps (ids .desktop o comandos), avisos (normales|favoritos|silencio), energia (balanced|performance|power-saver),
# gamemode (bool), pomodoro (bool), barra (fija|flotante|oculta).
# Apps extra sin tocar ajustes: export PROFILE_APPS_juego="steam discord"
# HF_TRY=1 → solo imprime lo que haría.
set -euo pipefail

for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
ROOT="${HF_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
STATE="$HOME/.local/state/hyprfrijol"; mkdir -p "$STATE"
SETTINGS="$HOME/.config/hyprfrijol/settings.json"
ORDER=(trabajo diseno juego personal)
cur="$(cat "$STATE/profile" 2>/dev/null || echo trabajo)"
DRY="${HF_TRY:-0}"

DEFAULTS='{
  "trabajo":  { "name": "Trabajo",   "apps": [], "avisos": "favoritos", "energia": "balanced",    "barra": "fija",   "pomodoro": true },
  "diseno":   { "name": "Diseño 3D", "apps": ["blender", "org.freecad.FreeCAD", "OrcaSlicer"], "avisos": "normales", "energia": "performance", "barra": "fija" },
  "juego":    { "name": "Juego",     "apps": ["steam", "com.heroicgameslauncher.hgl", "discord"], "avisos": "silencio", "energia": "performance", "gamemode": true, "barra": "oculta" },
  "personal": { "name": "Personal",  "apps": [], "avisos": "normales", "energia": "power-saver", "barra": "fija" }
}'

cfg() {   # cfg <perfil> → JSON del perfil (defecto + ajustes del usuario)
  local user='{}'
  [ -f "$SETTINGS" ] && user="$(jq -c --arg p "$1" '.profiles[$p] // {}' "$SETTINGS" 2>/dev/null || echo '{}')"
  jq -c --arg p "$1" --argjson u "$user" '(.[$p] // {}) + $u' <<<"$DEFAULTS"
}

case "${1:-next}" in
  current) echo "$cur"; exit 0 ;;
  list)    printf '%s\n' "${ORDER[@]}"; exit 0 ;;
  show)    cfg "${2:-$cur}"; exit 0 ;;
  -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
  next)
    P="${ORDER[0]}"
    for i in "${!ORDER[@]}"; do [ "${ORDER[$i]}" = "$cur" ] && P="${ORDER[$(( (i + 1) % ${#ORDER[@]} ))]}"; done ;;
  *) P="$1" ;;
esac
case " ${ORDER[*]} " in *" $P "*) ;; *) echo "Perfil desconocido: $P (usa: ${ORDER[*]})" >&2; exit 1 ;; esac

C="$(cfg "$P")"
get() { jq -r --arg k "$1" '.[$k] // empty | if type == "array" then join(" ") else tostring end' <<<"$C"; }
NAME="$(get name)"; POWER="$(get energia)"; POWER="${POWER:-balanced}"
AVISOS="$(get avisos)"; GAMEMODE="$(get gamemode)"; POMO="$(get pomodoro)"; BARRA="$(get barra)"
APPS="$(get apps)"; EXTRA_VAR="PROFILE_APPS_$P"; APPS="${!EXTRA_VAR:-$APPS}"

run() { if [ "$DRY" = 1 ]; then echo "[hf-profile] $*"; else "$@"; fi; }

# Ajustes de Hyprland del perfil
LUA='-- sin cambios sobre la base'
[ "$POWER" = performance ] && LUA='hl.config({ debug = { vfr = false } })'
if [ "$GAMEMODE" = true ]; then LUA='hl.config({
    decoration = { blur = { enabled = false }, shadow = { enabled = false } },
    animations = { enabled = false },
    general    = { allow_tearing = true },
})'; fi
if [ "$DRY" = 1 ]; then echo "[hf-profile] profile.lua ← ${LUA%%$'\n'*}"; else
  printf -- '-- Perfil: %s (lo escribe hf-profile)\n%s\n' "$P" "$LUA" > "$STATE/profile.lua"
  echo "$P" > "$STATE/profile"
fi

[ -n "${HF_SESSION:-}" ] && run hyprctl reload config-only >/dev/null 2>&1 || true
command -v powerprofilesctl >/dev/null && { run powerprofilesctl set "$POWER" 2>/dev/null || true; }

# Avisos: silencio → no molestar; favoritos → no molestar + lista de apps permitidas (notify-policy)
DND=false; [ "$AVISOS" = silencio ] || [ "$AVISOS" = favoritos ] && DND=true
if [ "$DRY" != 1 ]; then
  if [ "$DND" = true ]; then : > "$STATE/dnd"; else rm -f "$STATE/dnd"; fi
  printf '%s\n' "${AVISOS:-normales}" > "$STATE/notify-policy"
fi
run qs -p "$ROOT/config/quickshell" ipc call notifs setDnd "$DND" >/dev/null 2>&1 || true

# Barra: fija / flotante (ajuste barMode); oculta = modo sin distracciones
case "$BARRA" in
  fija|flotante) [ "$(jq -r '.barMode // "fija"' "$SETTINGS" 2>/dev/null)" = "$BARRA" ] || run "$ROOT/scripts/hf-apply" set "barMode=$BARRA" >/dev/null 2>&1 || true ;;
esac
[ "$DRY" = 1 ] || echo "${BARRA:-fija}" > "$STATE/profile-bar"

# Pomodoro
[ "$POMO" = true ] && { run qs -p "$ROOT/config/quickshell" ipc call pomodoro start 0 >/dev/null 2>&1 || true; }

# Fondo: el del ajuste o <carpeta de fondos>/perfiles/<perfil>.*
WP="$(get wallpaper)"; WP="${WP/#\~/$HOME}"
if [ -z "$WP" ] || [ ! -f "$WP" ]; then
  WP=""
  PICS="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
  for d in "${HF_WALL_DIR:-}" "$PICS/Fondos" "$PICS/Wallpapers"; do
    [ -n "$d" ] || continue
    WP="$(find "$d/perfiles" -maxdepth 1 -type f -iname "$P.*" 2>/dev/null | head -n1 || true)"
    [ -n "$WP" ] && break
  done
fi
[ -n "$WP" ] && { run "$ROOT/scripts/hf-wallpaper" "$WP" || true; }

# Apps del perfil (ids .desktop o comandos), sin duplicar las que ya están abiertas
OPEN="$(hyprctl clients -j 2>/dev/null | jq -r '.[].class' 2>/dev/null | tr 'A-Z' 'a-z' || true)"
for a in $APPS; do
  low="$(tr 'A-Z' 'a-z' <<<"${a##*.}")"
  grep -qx -- "$low" <<<"$OPEN" && continue
  if command -v gtk-launch >/dev/null && { [ -f "/usr/share/applications/$a.desktop" ] || [ -f "$HOME/.local/share/applications/$a.desktop" ] || [ -f "/var/lib/flatpak/exports/share/applications/$a.desktop" ]; }; then
    [ "$DRY" = 1 ] && echo "[hf-profile] gtk-launch $a" || { setsid gtk-launch "$a" >/dev/null 2>&1 & }
  elif command -v "$a" >/dev/null; then
    [ "$DRY" = 1 ] && echo "[hf-profile] $a" || { setsid "$a" >/dev/null 2>&1 & }
  fi
done

[ "$DRY" = 1 ] || { command -v notify-send >/dev/null && notify-send -a "Perfiles" "Perfil: $NAME" "Energía: $POWER · avisos: ${AVISOS:-normales}$( [ "${BARRA:-fija}" = oculta ] && echo " · barra escondida: lleva el cursor al borde para verla")" || true; }
