{
  "_doc": "Acciones que la app de Ajustes (Teclado y atajos) puede reasignar. La clave es la descripción del bind (description en hl.bind); lua es el dispatcher. Lo usan modules/settings/sections/Teclado.qml y config/apply/60-binds.py.",
  "Terminal": "function() hl.exec_cmd(HF.terminal) end",
  "Archivos": "function() hl.exec_cmd(HF.files) end",
  "Cerrar ventana": "hl.dsp.window.close()",
  "Maximizar": "hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"toggle\" })",
  "Minimizar": "hl.dsp.global(\"hf:minimizar\")",
  "Restaurar minimizada": "hl.dsp.global(\"hf:restaurar\")",
  "Pantalla completa": "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"toggle\" })",
  "Flotante": "hl.dsp.window.float({ action = \"toggle\" })",
  "Ventanas flotantes / mosaico": "hl.dsp.global(\"hf:modoventanas\")",
  "Fijar encima": "hl.dsp.window.pin()",
  "Bloquear": "hl.dsp.exec_cmd(\"loginctl lock-session\")",
  "Bloquear pantalla": "hl.dsp.exec_cmd(\"loginctl lock-session\")",
  "Siguiente fondo": "hl.dsp.exec_cmd(\"hf-wallpaper next\")",
  "No molestar": "hl.dsp.exec_cmd(HF.qs .. \" ipc call notifs toggleDnd\")",
  "Spotlight": "hl.dsp.global(\"hf:spotlight\")",
  "Abrir Spotlight": "hl.dsp.global(\"hf:spotlight\")",
  "Vista general": "hl.dsp.global(\"hf:vista\")",
  "Panel lateral": "hl.dsp.global(\"hf:ia\")",
  "Asistente de IA": "hl.dsp.global(\"hf:ia\")",
  "Ajustes rápidos": "hl.dsp.global(\"hf:ajustes\")",
  "Ajustes": "hl.dsp.global(\"hf:ajustesapp\")",
  "Herramientas": "hl.dsp.global(\"hf:herramientas\")",
  "Dictado": "hl.dsp.global(\"hf:dictado\")",
  "Comando de voz": "hl.dsp.global(\"hf:comando\")",
  "Portapapeles": "hl.dsp.global(\"hf:portapapeles\")",
  "Historial del portapapeles": "hl.dsp.global(\"hf:portapapeles\")",
  "Emojis": "hl.dsp.global(\"hf:emojis\")",
  "Agenda": "hl.dsp.global(\"hf:agenda\")",
  "Notificaciones": "hl.dsp.global(\"hf:notificaciones\")",
  "Organizar ventanas": "hl.dsp.global(\"hf:snap\")",
  "Cambiar de ventana": "hl.dsp.global(\"hf:alttab\")",
  "Captura": "hl.dsp.global(\"hf:captura\")",
  "Modo sin distracciones": "hl.dsp.global(\"hf:enfoque\")",
  "Menú de apagado": "hl.dsp.global(\"hf:energia\")",
  "Widgets": "hl.dsp.global(\"hf:widgets\")",
  "Mostrar / ocultar barra": "hl.dsp.global(\"hf:barra\")",
  "Menú de energía": "hl.dsp.global(\"hf:energia\")",
  "Sin distracciones": "hl.dsp.global(\"hf:enfoque\")",
  "Cafeína": "hl.dsp.global(\"hf:cafeina\")",
  "Fondos de pantalla": "hl.dsp.global(\"hf:fondos\")",
  "Asistente / panel lateral": "hl.dsp.global(\"hf:ia\")",
  "Asistente con la ventana actual": "hl.dsp.exec_cmd(HF.scripts .. \"/hf-ai summon\")",
  "Selector de color": "hl.dsp.global(\"hf:color\")",
  "Captura de pantalla": "hl.dsp.exec_cmd(HF.scripts .. \"/hf-capture screen\")",
  "Grabar (otra vez: detener)": "hl.dsp.exec_cmd(HF.qs .. \" ipc call shell openWith captura grabar\")",
  "Espacio anterior": "hl.dsp.focus({ workspace = \"r-1\" })",
  "Espacio siguiente / nuevo": "hl.dsp.focus({ workspace = \"r+1\" })",
  "Cambiar de ventana (atrás)": "hl.dsp.global(\"hf:altprev\")",
  "Ventanas de la misma app": "hl.dsp.global(\"hf:altapp\")",
  "Ajustar ventana": "hl.dsp.global(\"hf:snap\")",
  "Mitad izquierda": "HF.scroll(\"focus l\", hl.dsp.global(\"hf:snapleft\"))",
  "Mitad derecha": "HF.scroll(\"focus r\", hl.dsp.global(\"hf:snapright\"))",
  "Maximizar / mitad superior": "hl.dsp.global(\"hf:snapup\")",
  "Restaurar / mitad inferior": "hl.dsp.global(\"hf:snapdown\")",
  "Cambiar modo de ventanas": "hl.dsp.global(\"hf:modoventanas\")",
  "Mitad izquierda / columna anterior": "HF.scroll(\"focus l\", hl.dsp.global(\"hf:snapleft\"))",
  "Mitad derecha / columna siguiente": "HF.scroll(\"focus r\", hl.dsp.global(\"hf:snapright\"))",
  "Mover columna ←": "HF.scroll(\"swapcol l\")",
  "Mover columna →": "HF.scroll(\"swapcol r\")",
  "Proporción − / columna más estrecha": "HF.scroll(\"colresize -conf\", hl.dsp.layout(\"splitratio -0.1\"))",
  "Proporción + / columna más ancha": "HF.scroll(\"colresize +conf\", hl.dsp.layout(\"splitratio +0.1\"))",
  "Cambiar división / columna propia": "HF.scroll(\"promote\", hl.dsp.layout(\"togglesplit\"))",
  "Encajar las columnas a la vista": "HF.scroll(\"fit visible\")"
}
