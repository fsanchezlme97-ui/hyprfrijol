#!/usr/bin/env python3
"""hf-apply — aplica los ajustes de hyprfrijol a todo el sistema.

Lee  ~/.config/hyprfrijol/settings.json  (lo escriben la app de Ajustes, los ajustes rápidos y la IA)
y genera en ~/.local/state/hyprfrijol/:
  theme.json            tema resuelto (paleta + estilo). Lo lee Quickshell (Theme.qml)
  settings.lua          lo que Hyprland necesita (bordes, huecos, redondeo, blur, animaciones…)
  hyprlock-colors.conf  colores del bloqueo
  kitty-colors.conf     colores de kitty  (include ~/.local/state/hyprfrijol/kitty-colors.conf)
  gtk-colors.css        colores para GTK  (@import en ~/.config/gtk-4.0/gtk.css)
y, si estamos en la sesión de hyprfrijol y algo cambió, recarga Hyprland y kitty.

Uso:  hf-apply [--no-reload] [--print]
      hf-apply set clave=valor [clave=valor…]     (atajo para cambiar ajustes desde la terminal)
"""
import json, os, sys, subprocess, datetime, pathlib
for _k, _v in list(os.environ.items()):   # variables HL_* (hypr-liquid): siguen valiendo
    if _k.startswith("HL_"): os.environ.setdefault("HF_" + _k[3:], _v)

HOME = pathlib.Path.home()
ROOT = pathlib.Path(os.environ.get("HF_ROOT") or pathlib.Path(__file__).resolve().parent.parent)
STATE = HOME / ".local/state/hyprfrijol"
USER = HOME / ".config/hyprfrijol"
SETTINGS = USER / "settings.json"
# Primera vez tras el cambio de nombre (hypr-liquid → hyprfrijol): mueve las carpetas antiguas y deja enlaces
if any((HOME / d / "hypr-liquid").is_dir() and not (HOME / d / "hypr-liquid").is_symlink() for d in (".config", ".local/state", ".local/share", ".cache")):
    subprocess.run([str(ROOT / "scripts/hf-migrate"), "--dirs-only", "--quiet"], check=False)

def load(p, default=None):
    try:
        return json.loads(pathlib.Path(p).read_text())
    except Exception:
        return default

def write_if_changed(path, text):
    path = pathlib.Path(path)
    if path.exists() and path.read_text() == text:
        return False
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)
    return True

def settings():
    s = dict(load(ROOT / "config/defaults/settings.json", {}))
    s.update(load(SETTINGS, {}) or {})
    return s

# ---------- colores ----------
def hex_rgb(h):
    h = h.lstrip("#")
    if len(h) == 8:
        h = h[2:]
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)

def argb(h, a):
    """#AARRGGBB para QML"""
    r, g, b = hex_rgb(h)
    return "#%02X%02X%02X%02X" % (round(max(0, min(1, a)) * 255), r, g, b)

def rgba_hypr(h, a=1.0):
    r, g, b = hex_rgb(h)
    return "rgba(%02x%02x%02x%02x)" % (r, g, b, round(a * 255))

def _hm(v, default):
    for x in (v, default):
        try:
            h, _, m = str(x).partition(":")
            return int(h) * 60 + int(m or 0)
        except Exception:
            pass
    return 0

def sun_location(s):
    """Ubicación para el amanecer/atardecer: la ciudad fija del clima o la última por IP (caché de Weather.qml)."""
    try:
        if s.get("weatherLat", "") not in ("", None) and s.get("weatherLon", "") not in ("", None):
            return float(s["weatherLat"]), float(s["weatherLon"])
    except Exception:
        pass
    loc = (load(HOME / ".cache/hyprfrijol/weather.json", {}) or {}).get("loc") or {}
    try:
        return float(loc["lat"]), float(loc["lon"])
    except Exception:
        return None

def sun_times(day, lat, lon):
    """Amanecer y atardecer (minutos locales) con la ecuación de NOAA; igual que services/Sun.qml.
    Devuelve (amanecer, atardecer, polar) con polar "" · "dia" (sol de medianoche) · "noche"."""
    import math
    n = day.timetuple().tm_yday
    g = 2 * math.pi / 365 * (n - 1)
    eq = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g) - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    phi = math.radians(lat)
    cos_h = math.cos(math.radians(90.833)) / (math.cos(phi) * math.cos(decl)) - math.tan(phi) * math.tan(decl)
    if cos_h > 1:
        return 720, 720, "noche"
    if cos_h < -1:
        return 0, 1440, "dia"
    ha = math.degrees(math.acos(cos_h))
    tz = datetime.datetime(day.year, day.month, day.day, 12).astimezone().utcoffset().total_seconds() / 60
    rise = round(720 - 4 * (lon + ha) - eq + tz) % 1440
    sset = round(720 - 4 * (lon - ha) - eq + tz) % 1440
    return rise, sset, ""

def sun_today(s):
    """(amanecer, atardecer, polar) de hoy: calculados si sunAuto y hay ubicación; si no, sunrise/sunset a mano."""
    loc = sun_location(s) if s.get("sunAuto", True) is not False else None
    if loc:
        return sun_times(datetime.date.today(), *loc)
    return _hm(s.get("sunrise"), "07:00"), _hm(s.get("sunset"), "19:00"), ""

def is_light_now(s):
    mode = s.get("themeMode", "oscuro")
    if mode == "claro":
        return True
    if mode == "auto":
        now = datetime.datetime.now()
        if s.get("themeSchedule", "horas") == "sol":
            rise, sset, polar = sun_today(s)
            if polar:
                return polar == "dia"
            m = now.hour * 60 + now.minute
            return rise <= m < sset if rise <= sset else (m >= rise or m < sset)
        return int(s.get("lightFrom", 7)) <= now.hour < int(s.get("lightTo", 19))
    return False

def resolve_palette(s):
    pals = load(ROOT / "config/themes/palettes.json", {})
    # Temas importados (hf-plugin theme: colors.toml de Omarchy) → ~/.config/hyprfrijol/palettes-user.json, mismo formato
    pals.update({k: v for k, v in (load(USER / "palettes-user.json", {}) or {}).items() if isinstance(v, dict) and v.get("p")})
    mode = s.get("colorMode", "auto")
    light = is_light_now(s)
    if mode == "mono":
        key = "monoclaro" if light else "mono"
        return key, dict(pals[key])
    if mode == "elegir":
        key = s.get("palette", "grafito")
        c = dict(pals.get(key) or pals["grafito"])
        # Las paletas del diseño son de un solo modo: si el modo pedido (Claro / Oscuro / Según la hora) es el
        # otro, se usa su pareja si la tiene (las pastel: «rosa» ⇄ «rosa-claro») o se deriva la variante con el
        # mismo acento sobre las superficies de «claro» o «grafito».
        if bool(c.get("light")) != light:
            pair = pals.get(c.get("pair", ""))
            c = dict(pair) if pair and bool(pair.get("light")) == light else flip_palette(c, light, pals)
        for k in ("pair", "group", "variant"):
            c.pop(k, None)
        return key, c
    auto = load(STATE / "colors.json") or load(ROOT / "config/defaults/colors.json")
    c = dict(auto["light" if light else "dark"])
    c["name"] = "Automático"
    return "auto", c

def valid_hex(h):
    h = str(h or "").strip()
    return len(h) == 7 and h[0] == "#" and all(ch in "0123456789abcdefABCDEF" for ch in h[1:])

def apply_accent(c, s):
    """Ajustes › Apariencia › Acento: un color elegido (accent = "#RRGGBB") sustituye al principal de la paleta
    (p, onP, pc, onPc y el tinte de sc). El contraste lo corrige luego fix_contrast; onP elige negro o blanco."""
    acc = s.get("accent") or ""
    if not valid_hex(acc):
        return c
    c = dict(c)
    acc = acc.upper()
    light = bool(c.get("light"))
    W, K = "#FFFFFF", "#000000"
    # El acento se usa también como texto (enlaces, iconos activos): se oscurece o aclara sin perder saturación
    # hasta 4.5:1 sobre las superficies
    p = fit_lightness(acc, [c["s1"], c["s3"], c["s4"]], 4.5)
    if light:
        c.update(p=p, pc=mix(c["s1"], acc, .22), onPc=fit_lightness(mix(acc, K, .6), [mix(c["s1"], acc, .22)], 7.0),
                 sc=mix(c["sc"], acc, .18))
    else:
        c.update(p=p, pc=mix(c["s3"], acc, .34), onPc=mix(acc, W, .72), sc=mix(c["sc"], acc, .14))
    # Texto sobre el acento: negro (teñido) o blanco, el que más contraste dé
    dark_on = mix(c["p"], K, .8)
    c["onP"] = dark_on if contrast(dark_on, c["p"]) >= contrast(W, c["p"]) else W
    c["accent"] = acc
    return c

def fit_lightness(col, bgs, target):
    """Cambia solo la luminosidad (HLS) de col, hacia el lado que más contraste dé, hasta target sobre bgs."""
    import colorsys
    if min(contrast(col, b) for b in bgs) >= target:
        return col
    r, g, b = (v / 255 for v in hex_rgb(col))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    down = luminance(bgs[0]) > 0.18
    out = col
    for i in range(1, 41):
        nl = max(0.0, l - i * 0.02) if down else min(1.0, l + i * 0.02)
        rr, gg, bb = colorsys.hls_to_rgb(h, nl, s)
        out = "#%02X%02X%02X" % (round(rr * 255), round(gg * 255), round(bb * 255))
        if min(contrast(out, x) for x in bgs) >= target:
            break
    return out

def best_on(bg, target, hint=None):
    """Texto sobre bg: el tono propuesto si llega a target; si no, casi negro o casi blanco teñidos de bg
    (el lado que más contraste dé); si tampoco llegan, negro o blanco puros."""
    if hint and contrast(hint, bg) >= target:
        return hint
    dark, light = mix(bg, "#000000", .82), mix(bg, "#FFFFFF", .9)
    pick = dark if contrast(dark, bg) >= contrast(light, bg) else light
    if contrast(pick, bg) >= target:
        return pick
    return "#000000" if contrast("#000000", bg) >= contrast("#FFFFFF", bg) else "#FFFFFF"

def mix(a, b, t):
    """Mezcla dos colores #RRGGBB (t = peso de b)."""
    ra, ga, ba = hex_rgb(a); rb, gb, bb = hex_rgb(b)
    return "#%02X%02X%02X" % (round(ra + (rb - ra) * t), round(ga + (gb - ga) * t), round(ba + (bb - ba) * t))

def flip_palette(c, light, pals):
    """Variante clara (u oscura) de una paleta fija: superficies de «claro»/«grafito» con un toque del acento,
    y el acento/terciario oscurecidos (o aclarados) para que mantengan el contraste."""
    base = pals.get("claro" if light else "grafito") or c
    acc, ter = c["p"], c.get("ter", c["p"])
    ink, paper = ("#000000", "#FFFFFF") if light else ("#FFFFFF", "#000000")
    out = {k: mix(base[k], acc, 0.06) for k in ("bg", "s1", "s3", "s4", "sc", "ov")}
    out.update({
        "p": mix(acc, ink, 0.5 if light else 0.4), "onP": paper if light else mix(acc, paper, 0.75),
        "pc": mix(acc, paper, 0.62 if light else 0.6), "onPc": mix(acc, ink, 0.72),
        "onSc": base["onSc"], "ter": mix(ter, ink, 0.45 if light else 0.35),
        "t": base["t"], "tv": base["tv"], "o": base["o"],
        "name": c.get("name", "") + (" · claro" if light else " · oscuro"), "light": light,
    })
    return out

# ---------- contraste (WCAG) ----------
def luminance(h):
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = hex_rgb(h)
    return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b)

def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)

def push_contrast(fg, bgs, target):
    """Acerca fg al negro o al blanco (lo que más contraste dé) hasta llegar a target sobre todos los bgs."""
    ink = "#000000" if luminance(bgs[0]) > 0.18 else "#FFFFFF"
    out = fg
    for i in range(1, 21):
        if min(contrast(out, b) for b in bgs) >= target:
            break
        out = mix(fg, ink, i * 0.05)
    return out

def fix_contrast(c, high=False):
    """Texto sobre superficies ≥ 4.5:1 (AA); con alto contraste, ≥ 7:1 (AAA) y bordes más marcados.
    Corrige las paletas de matugen (dependen del fondo) y las variantes derivadas por flip_palette."""
    c = dict(c)
    surf = [c["s1"], c["s3"], c["s4"]]
    t_min = 7.0 if high else 4.5
    for k in ("t", "tv"):
        c[k] = push_contrast(c[k], surf, t_min)
    for k in ("p", "ter"):   # solo la luminosidad: el acento no pierde saturación (no se agrisa)
        c[k] = fit_lightness(c[k], surf, 4.5 if not high else 5.5)
    for on, bg in (("onP", "p"), ("onPc", "pc"), ("onSc", "sc")):
        fixed = push_contrast(c[on], [c[bg]], t_min)
        # Si para llegar hubo que gastar el tono (p. ej. negro → gris sobre un acento oscurecido), mejor el otro lado
        c[on] = fixed if fixed == c[on] or contrast(fixed, c[bg]) >= t_min and abs(luminance(fixed) - luminance(c[on])) < .3 \
            else best_on(c[bg], t_min)
    c["tv"] = push_contrast(c["tv"], [c["sc"]], 4.5)
    if high:
        # Bordes y separadores con contraste de componente (≥ 3:1) y el texto secundario casi como el principal
        c["o"] = push_contrast(c["o"], surf, 4.5)
        c["ov"] = push_contrast(c["ov"], surf, 3.0)
        c["tv"] = mix(c["tv"], c["t"], 0.35)
    return c

# Forma de las esquinas de las ventanas (decoration:rounding_power): 2 = circular, 3–4 = continua tipo «squircle»
ROUNDING_POWER = {"circular": 2.0, "continua": 3.0, "squircle": 4.0}

# Redondeo del shell (Ajustes › Apariencia › Redondeo): multiplica los radios del estilo.
# La base es sobria (esquinas poco redondeadas); «Redondo»/«Máximo» las suavizan.
ROUNDNESS = {"recto": 0.35, "sobrio": 0.7, "auto": 1.0, "suave": 1.0, "redondo": 1.5, "maximo": 2.2}

# Estilos visuales (Ajustes › Apariencia › Estilo). «tonal» es interno (Aurora/Mica con menos transparencia).
STYLES = ("flat", "aurora", "mica", "suave")

# Sombras (Ajustes › Apariencia › Ventanas › Sombras): opacidad, radio y desplazamiento relativos al estilo
SHADOWS = {
    "ninguna":  {"alpha": 0.0, "blur": 1.0, "y": 1.0},
    "suaves":   {"alpha": 0.8, "blur": 1.35, "y": 1.1},
    "marcadas": {"alpha": 1.5, "blur": 0.85, "y": 0.9},
}

# ---------- movimiento ----------
