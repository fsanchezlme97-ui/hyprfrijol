#!/usr/bin/env bash
# hf-remote — escritorio remoto: conectarse a otros equipos (RDP, VNC, SSH, SPICE) y compartir este (VNC).
# Lo usan Ajustes › Escritorio remoto, la IA y la terminal.
#
#   hf-remote list                       conexiones guardadas (ajuste "remoteHosts"), una línea JSON por equipo
#   hf-remote clients                    clientes instalados (JSON)
#   hf-remote connect <nombre|url>       url: rdp://[dominio\]usuario@equipo[:puerto] · vnc:// · ssh:// · spice://
#   hf-remote secret set|clear|has <nombre>   contraseña en el llavero (libsecret); nunca en settings.json
#   hf-remote server status|start|stop|restart   compartir este escritorio por VNC (wayvnc)
#   hf-remote server auth <usuario>      pide contraseña y activa cifrado (TLS + RSA-AES) en ~/.config/wayvnc
#   hf-remote server noauth              quita la contraseña (y con ella vuelve a escuchar solo en este equipo)
#   hf-remote rdp status|start|stop|restart   compartir ESTA sesión por RDP (hypr-rdp): desde Windows con mstsc
#   hf-remote rdp password               pide la contraseña de RDP (usuario = el tuyo) y la guarda en ~/.config/hypr-rdp
#   hf-remote rdp boot                   al iniciar sesión: lo arranca si rdpServer está activo
#
# RDP (hypr-rdp, AUR): sin contraseña NUNCA se arranca (hypr-rdp aceptaría a cualquiera). rdpListen: «tailscale»
# (por defecto: solo la IP de Tailscale), «red» (0.0.0.0) o «local». rdpOutput: la pantalla que se ve ("" = la
# principal o, si no está conectada, la más grande; «virtual» = una pantalla nueva solo para la conexión). Corre
# como unidad de usuario hf-rdp (systemd-run, se reintenta si Tailscale aún no está conectado al arrancar).
#
# Seguridad: sin contraseña wayvnc NUNCA escucha en la red; aunque vncListen pida 0.0.0.0, «server start»
# se queda en 127.0.0.1 y avisa. «status» da listen (lo pedido) y effective (lo que se usa de verdad).
#
# Contraseñas: si hay una en el llavero se pasa a FreeRDP por stdin (/args-from:stdin), nunca en la línea de
# órdenes. Si no, el cliente la pide (sdl-freerdp3 y Remmina con su diálogo; xfreerdp3 en una terminal).
#
# Cliente RDP «auto» (remoteClient): Remmina (el más compatible con Windows: RD Gateway, varias pantallas,
# portapapeles, carpetas, impresoras, sonido, NLA) › FreeRDP 3 (sdl-freerdp3 › wlfreerdp3 › xfreerdp3; el más
# rápido, sin interfaz) › GNOME Conexiones (sencillo, sin puerta de enlace). Con contraseña en el llavero se usa
# FreeRDP si está (Remmina guarda las suyas). Remmina recibe un perfil .remmina generado en
# ~/.local/share/hyprfrijol/remmina/ con puerta de enlace, varias pantallas, portapapeles, sonido y carpeta.
# HF_REMOTE_DRY_RUN=1 imprime la orden sin abrir nada.
set -uo pipefail
for _v in ${!HL_@}; do _n="HF_${_v#HL_}"; [ -n "${!_n+x}" ] || export "$_n=${!_v}"; done; unset _v _n   # variables HL_* (hypr-liquid): siguen valiendo
ROOT="${HF_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
SETTINGS="$HOME/.config/hyprfrijol/settings.json"
DEFAULTS="$ROOT/config/defaults/settings.json"
VNCDIR="$HOME/.config/wayvnc"
PROFILES="${XDG_DATA_HOME:-$HOME/.local/share}/hyprfrijol/remmina"
DRY="${HF_REMOTE_DRY_RUN:-0}"

setting() {   # setting <clave> → JSON (el del usuario manda sobre el de config/defaults)
  local f
  for f in "$SETTINGS" "$DEFAULTS"; do
    [ -f "$f" ] || continue
    jq -ce --arg k "$1" 'if has($k) then .[$k] else error end' "$f" 2>/dev/null && return 0
  done
  echo null
}
notify() { [ "$DRY" = 1 ] && { echo "# aviso: $*"; return 0; }; command -v notify-send >/dev/null && notify-send -a "Escritorio remoto" -i preferences-desktop-remote-desktop "$@"; }
term() {
  local t="${TERMINAL:-}" c
  for c in "$t" kitty ghostty foot alacritty wezterm konsole; do [ -n "$c" ] && command -v "$c" >/dev/null && { t=$c; break; }; done
  case "$t" in wezterm) setsid -f wezterm start -- "$@";; *) setsid -f "$t" -e "$@";; esac >/dev/null 2>&1
}
have() { command -v "$1" >/dev/null 2>&1; }
# FreeRDP 3: el cliente SDL (pide la contraseña en una ventana, Wayland nativo) › wlfreerdp › xfreerdp (XWayland)
freerdp_bin() { local b; for b in sdl-freerdp3 sdl-freerdp wlfreerdp3 wlfreerdp xfreerdp3 xfreerdp; do have $b && { echo $b; return; }; done; }
remmina_cmd() {   # Remmina del sistema o de Flathub
  if have remmina; then echo remmina
  elif have flatpak && flatpak info org.remmina.Remmina >/dev/null 2>&1; then echo "flatpak run org.remmina.Remmina"; fi
}
remmina_rdp() {   # ¿Remmina trae el plugin RDP? (en Debian/Fedora/openSUSE va aparte)
  [ -n "${HF_REMOTE_FAKE_RDP_PLUGIN:-}" ] && return 0   # pruebas
  [ "$(remmina_cmd)" = remmina ] || return 0
  ls /usr/lib/remmina/plugins/*rdp* /usr/lib64/remmina/plugins/*rdp* /usr/lib/*-linux-gnu/remmina/plugins/*rdp* >/dev/null 2>&1
}
run() {   # run <orden…>: la abre aparte (con HF_REMOTE_DRY_RUN=1 solo la imprime)
  if [ "$DRY" = 1 ]; then printf '$'; printf ' %q' "$@"; printf '\n'; return 0; fi
  setsid -f "$@" >/dev/null 2>&1
}

clients() {
  local rc; rc="$(remmina_cmd)"
  jq -cn --arg freerdp "$(freerdp_bin)" \
    --argjson remmina "$([ -n "$rc" ] && echo true || echo false)" \
    --argjson remminaRdp "$([ -n "$rc" ] && remmina_rdp && echo true || echo false)" \
    --arg rdpAuto "$(rdp_client auto false)" \
    --argjson connections "$(have gnome-connections && echo true || echo false)" \
    --argjson vncviewer "$(have vncviewer && echo true || echo false)" \
    --argjson remoteviewer "$(have remote-viewer && echo true || echo false)" \
    --argjson secret "$(have secret-tool && echo true || echo false)" \
    --argjson wayvnc "$(have wayvnc && echo true || echo false)" \
    '{freerdp:$freerdp,remmina:$remmina,remminaRdp:$remminaRdp,rdpAuto:$rdpAuto,connections:$connections,vncviewer:$vncviewer,remoteviewer:$remoteviewer,secret:$secret,wayvnc:$wayvnc}'
}

list() { setting remoteHosts | jq -c '(. // [])[]'; }

# ---------- llavero ----------
secret() {
  local op="${1:?set|clear|has}" n="${2:?nombre}"
  have secret-tool || { echo "Falta secret-tool (libsecret)" >&2; return 1; }
  case "$op" in
    set) echo "Contraseña para «$n» (se guarda en el llavero, no en settings.json):"
         secret-tool store --label="hyprfrijol · $n" service hyprfrijol-remote host "$n";;
    # hypr-liquid-remote: servicio anterior al cambio de nombre; se sigue leyendo
    clear) secret-tool clear service hyprfrijol-remote host "$n"; secret-tool clear service hypr-liquid-remote host "$n";;
    has) secret-tool lookup service hyprfrijol-remote host "$n" >/dev/null 2>&1 || secret-tool lookup service hypr-liquid-remote host "$n" >/dev/null 2>&1;;
    get) secret-tool lookup service hyprfrijol-remote host "$n" 2>/dev/null || secret-tool lookup service hypr-liquid-remote host "$n" 2>/dev/null;;
  esac
}

# ---------- conectar ----------
# Convierte una url en un objeto como los de remoteHosts
from_url() {
  local u="$1" proto rest user="" host port="" domain=""
  proto="${u%%://*}"; rest="${u#*://}"; rest="${rest%%/*}"
  if [[ "$rest" == *@* ]]; then user="${rest%@*}"; rest="${rest##*@}"; fi
  if [[ "$user" == *\\* ]]; then domain="${user%%\\*}"; user="${user#*\\}"; fi
  if [[ "$user" == *\;* ]]; then domain="${user#*;}"; user="${user%%;*}"; fi
  host="${rest%:*}"; [[ "$rest" == *:* ]] && port="${rest##*:}"
  jq -cn --arg p "$proto" --arg h "$host" --arg po "$port" --arg u "$user" --arg d "$domain" --arg n "$host" \
    '{name:$n,proto:$p,host:$h,port:(if $po=="" then null else ($po|tonumber) end),user:$u,domain:$d,opts:{}}'
}
# rdp_client <remoteClient> <hay contraseña en el llavero> → remmina | freerdp | connections | ""
rdp_client() {
  local want="$1" pw="$2" fr rm co
  fr="$(freerdp_bin)"; rm="$( [ -n "$(remmina_cmd)" ] && remmina_rdp && echo y)"; co="$(have gnome-connections && echo y)"
  case "$want" in
    remmina) [ -n "$rm" ] && { echo remmina; return; };;
    freerdp) [ -n "$fr" ] && { echo freerdp; return; };;
    connections) [ -n "$co" ] && { echo connections; return; };;
  esac
  # automático (o el elegido no está): Remmina › FreeRDP › Conexiones; con contraseña guardada, FreeRDP primero
  [ "$pw" = true ] && [ -n "$fr" ] && { echo freerdp; return; }
  [ -n "$rm" ] && { echo remmina; return; }
  [ -n "$fr" ] && { echo freerdp; return; }
  [ -n "$co" ] && { echo connections; return; }
  echo ""
}
# Perfil de Remmina con las opciones de la conexión (se rehace cada vez; conserva la contraseña que guardó Remmina)
remmina_profile() {   # remmina_profile <json del equipo> → ruta del .remmina
  local h="$1" name host port user domain gw f old_pw slug
  name="$(jq -r '.name // .host' <<<"$h")"; host="$(jq -r '.host' <<<"$h")"; port="$(jq -r '.port // empty' <<<"$h")"
  user="$(jq -r '.user // ""' <<<"$h")"; domain="$(jq -r '.domain // ""' <<<"$h")"; gw="$(jq -r '.opts.gateway // ""' <<<"$h")"
  o() { jq -r --arg k "$1" '.opts[$k] // empty' <<<"$h"; }
  slug="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-60)"
  mkdir -p "$PROFILES"; f="$PROFILES/$slug.remmina"
  old_pw="$(grep -m1 '^password=' "$f" 2>/dev/null)"
  local full=0 multi=0 dyn=1
  [ "$(o fullscreen)" = true ] && full=1; [ "$(o multimon)" = true ] && { multi=1; full=1; }; [ "$(o dynamicRes)" = false ] && dyn=0
  {
    echo "[remmina]"
    echo "name=$name"; echo "protocol=RDP"; echo "server=$host${port:+:$port}"
    echo "username=$user"; echo "domain=$domain"
    [ -n "$old_pw" ] && echo "$old_pw"
    if [ -n "$gw" ]; then echo "gateway_server=$gw"; echo "gateway_usage=0"; fi   # 0 = usar siempre la puerta de enlace
    echo "sound=$([ "$(o sound)" = false ] && echo off || echo local)"
    echo "disableclipboard=$([ "$(o clipboard)" = false ] && echo 1 || echo 0)"
    echo "multimon=$multi"
    [ "$(o drives)" = true ] && echo "sharefolder=$HOME"
    echo "viewmode=$([ $full = 1 ] && echo 4 || echo 1)"                          # 4 pantalla completa · 1 ventana
    echo "resolution_mode=$([ $full = 1 ] && echo 1 || echo 2)"                   # 1 la del cliente · 2 la de la ventana
    echo "scale=$([ $dyn = 1 ] && echo 2 || echo 0)"                              # 2 = resolución dinámica
    echo "cert_ignore=0"
  } > "$f"
  chmod 600 "$f"
  echo "$f"
}
connect() {
  local target="${1:?nombre o url}" h
  if [[ "$target" == *://* ]]; then h="$(from_url "$target")"
  else h="$(setting remoteHosts | jq -c --arg n "$target" '(. // [])[] | select(.name == $n)' | head -1)"; fi
  [ -n "$h" ] || { echo "No hay ninguna conexión llamada «$target»" >&2; notify -u critical "No encuentro «$target»"; exit 1; }
  local name proto host port user domain client
  name="$(jq -r '.name // .host' <<<"$h")"; proto="$(jq -r '.proto // "rdp"' <<<"$h")"
  host="$(jq -r '.host // ""' <<<"$h")"; port="$(jq -r '.port // empty' <<<"$h")"
  user="$(jq -r '.user // ""' <<<"$h")"; domain="$(jq -r '.domain // ""' <<<"$h")"
  client="$(jq -r '.client // empty' <<<"$h")"; [ -n "$client" ] || client="$(setting remoteClient | jq -r '. // "auto"')"
  opt() { jq -r --arg k "$1" '.opts[$k] // empty' <<<"$h"; }
  [ -n "$host" ] || { echo "Falta el equipo" >&2; exit 1; }
  case "$proto" in
    rdp)
      local pw="" use fr; have secret-tool && pw="$(secret get "$name" || true)"
      use="$(rdp_client "$client" "$([ -n "$pw" ] && echo true || echo false)")"
      local gw; gw="$(opt gateway)"
      case "$use" in
        remmina)
          local rc; read -ra rc <<<"$(remmina_cmd)"
          run "${rc[@]}" -c "$(remmina_profile "$h")"; return;;
        connections)
          [ -n "$gw" ] && notify -u critical "Conexiones no usa puerta de enlace" "«$name» necesita $gw: instala Remmina o FreeRDP en Ajustes › Escritorio remoto"
          run gnome-connections "rdp://$host${port:+:$port}"; return;;
        "") notify -u critical "No hay cliente RDP" "Instala Remmina o FreeRDP en Ajustes › Escritorio remoto"; exit 1;;
      esac
      fr="$(freerdp_bin)"
      local a=("/v:$host${port:+:$port}" "/cert:tofu" "/title:$name")
      [ -n "$user" ] && a+=("/u:$user"); [ -n "$domain" ] && a+=("/d:$domain")
      if [ "$(opt multimon)" = true ]; then a+=("/multimon" "/f")
      else
        [ "$(opt fullscreen)" = true ] && a+=("/f")
        [ "$(opt dynamicRes)" != false ] && a+=("/dynamic-resolution")
      fi
      [ "$(opt sound)" != false ] && a+=("/sound")
      [ "$(opt clipboard)" != false ] && a+=("/clipboard")
      [ "$(opt drives)" = true ] && a+=("/drive:Inicio,$HOME")
      local g=""; [ -n "$gw" ] && g="/gateway:g:$gw${user:+,u:$user}${domain:+,d:$domain}"
      if [ -n "$pw" ]; then
        # Toda la línea por stdin: la contraseña no aparece en ps
        if [ "$DRY" = 1 ]; then printf '$ %s /args-from:stdin  <<< ' "$fr"; printf '%q ' "${a[@]}" "/p:***" ${g:+"$g,p:***"}; echo; return; fi
        { printf '%s\n' "${a[@]}" "/p:$pw"; [ -n "$g" ] && printf '%s\n' "$g,p:$pw"; } | setsid -f "$fr" /args-from:stdin >/dev/null 2>&1
        return
      fi
      [ -n "$g" ] && a+=("$g")
      if [[ "$fr" == sdl-* ]]; then
        run "$fr" "${a[@]}"   # el cliente SDL pide usuario/contraseña en una ventana
      else
        [ "$DRY" = 1 ] && { printf '$ <terminal>'; printf ' %q' "$fr" "${a[@]}" /from-stdin; echo; return; }
        term "$fr" "${a[@]}" /from-stdin        # wlfreerdp y xfreerdp los piden en la terminal
      fi;;
    vnc)
      if [ "$client" != remmina ] && [ "$client" != connections ] && have vncviewer; then
        local v=("$host::${port:-5900}"); [ "$(opt fullscreen)" = true ] && v+=("-FullScreen")
        setsid -f vncviewer "${v[@]}" >/dev/null 2>&1
      elif [ "$client" != connections ] && have remmina; then setsid -f remmina -c "vnc://${user:+$user@}$host${port:+:$port}" >/dev/null 2>&1
      elif have gnome-connections; then setsid -f gnome-connections "vnc://$host${port:+:$port}" >/dev/null 2>&1
      else notify -u critical "No hay cliente VNC" "Instala TigerVNC, Remmina o Conexiones"; exit 1; fi;;
    spice)
      if have remote-viewer; then setsid -f remote-viewer "spice://$host:${port:-5900}" >/dev/null 2>&1
      elif have remmina; then setsid -f remmina -c "spice://$host:${port:-5900}" >/dev/null 2>&1
      else notify -u critical "No hay cliente SPICE" "Instala virt-viewer"; exit 1; fi;;
    ssh)
      term ssh ${port:+-p "$port"} "${user:+$user@}$host";;
    *) echo "Protocolo desconocido: $proto" >&2; exit 1;;
  esac
}

# ---------- compartir este escritorio (wayvnc) ----------
vnc_ips() { ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print $2" "a[1]}'; }
vnc_auth() { grep -qs '^enable_auth=true' "$VNCDIR/config"; }
is_local() { case "$1" in 127.*|localhost|::1) return 0;; *) return 1;; esac; }
server() {
  local op="${1:-status}" listen port output effective
  listen="$(setting vncListen | jq -r '. // "127.0.0.1"')"; port="$(setting vncPort | jq -r '. // 5900')"
  output="$(setting vncOutput | jq -r '. // ""')"
  effective="$listen"; is_local "$listen" || vnc_auth || effective=127.0.0.1
  case "$op" in
    status)
      local run=false auth=false clients=0 ips
      pgrep -x wayvnc >/dev/null && run=true
      vnc_auth && auth=true
      $run && have wayvncctl && clients="$(timeout 2 wayvncctl -j client-list 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
      ips="$(vnc_ips | jq -Rnc '[inputs | split(" ") | {dev:.[0], ip:.[1]}]')"
      local fw=""; systemctl is-active -q ufw 2>/dev/null && fw=ufw; systemctl is-active -q firewalld 2>/dev/null && fw=firewalld
      jq -cn --argjson installed "$(have wayvnc && echo true || echo false)" --argjson running $run --argjson auth $auth \
        --arg listen "$listen" --arg effective "$effective" --argjson port "$port" --arg output "$output" --argjson ips "$ips" --arg host "$(hostname 2>/dev/null || cat /etc/hostname)" \
        --argjson clients "${clients:-0}" --arg fw "$fw" \
        '{installed:$installed,running:$running,auth:$auth,listen:$listen,effective:$effective,port:$port,output:$output,ips:$ips,host:$host,clients:$clients,firewall:$fw}';;
    start)
      have wayvnc || { notify -u critical "Falta wayvnc"; exit 1; }
      pgrep -x wayvnc >/dev/null && exit 0
      local a=(); [ -n "$output" ] && a+=(-o "$output")
      if [ "$effective" != "$listen" ]; then
        notify -u critical "Sin contraseña solo se comparte en este equipo" "Para dejar entrar a otros equipos de tu red pon usuario y contraseña en Ajustes › Escritorio remoto. Mientras, VNC escucha en 127.0.0.1:$port."
      fi
      setsid -f wayvnc "${a[@]}" "$effective" "$port" >/dev/null 2>&1
      sleep 0.6; pgrep -x wayvnc >/dev/null || { notify -u critical "wayvnc no arrancó" "Prueba «wayvnc $effective $port» en una terminal para ver el error"; exit 1; }
      if is_local "$effective"; then
        [ "$effective" = "$listen" ] && notify "Compartiendo el escritorio solo en este equipo" "VNC en 127.0.0.1:$port (entra con un túnel: ssh -L $port:localhost:$port)"
      else
        notify "Compartiendo el escritorio en la red · con contraseña" "VNC en $(vnc_ips | awk '{print $2}' | head -1 || echo localhost):$port"
      fi;;
    stop) pkill -x wayvnc; true;;
    restart) pgrep -x wayvnc >/dev/null || exit 0; pkill -x wayvnc; sleep 0.5; "$0" server start;;
    auth)
      local u="${2:-$USER}" pw pw2
      have openssl || { echo "Falta openssl" >&2; exit 1; }
      mkdir -p "$VNCDIR"; chmod 700 "$VNCDIR"
      read -rsp "Contraseña de VNC para «$u»: " pw; echo; read -rsp "Repítela: " pw2; echo
      [ -n "$pw" ] && [ "$pw" = "$pw2" ] || { echo "No coinciden" >&2; exit 1; }
      ( cd "$VNCDIR" || exit 1
        [ -f tls_key.pem ] || openssl req -x509 -newkey rsa:4096 -sha384 -days 3650 -nodes -keyout tls_key.pem -out tls_cert.pem \
             -subj "/CN=$(hostname)" -addext "subjectAltName=DNS:$(hostname),DNS:localhost" 2>/dev/null
        [ -f rsa_key.pem ] || { if have ssh-keygen; then ssh-keygen -q -m pem -t rsa -b 3072 -N "" -f rsa_key.pem && rm -f rsa_key.pem.pub; else openssl genrsa -traditional -out rsa_key.pem 3072 2>/dev/null; fi; }
        umask 077
        { echo "use_relative_paths=true"; echo "enable_auth=true"; echo "username=$u"; echo "password=$pw"
          echo "private_key_file=tls_key.pem"; echo "certificate_file=tls_cert.pem"; echo "rsa_private_key_file=rsa_key.pem"; } > config
        chmod 600 config tls_key.pem rsa_key.pem )
      echo "Listo: wayvnc pedirá usuario y contraseña, con cifrado TLS (VeNCrypt) y RSA-AES."
      pgrep -x wayvnc >/dev/null && { pkill -x wayvnc; sleep 0.5; "$0" server start; };;
    noauth)
      [ -f "$VNCDIR/config" ] && sed -i 's/^enable_auth=.*/enable_auth=false/' "$VNCDIR/config"
      pgrep -x wayvnc >/dev/null && { pkill -x wayvnc; sleep 0.5; "$0" server start; }; true;;
    *) echo "server status|start|stop|restart|auth|noauth" >&2; exit 1;;
  esac
}

# ---------- compartir este escritorio por RDP (hypr-rdp) ----------
RDPDIR="$HOME/.config/hypr-rdp"
RDPPW="$RDPDIR/password"
rdp_addr() {   # dirección donde escuchar según rdpListen (vacía si Tailscale no está conectado)
  case "$(setting rdpListen | jq -r '. // "tailscale"')" in
    red) echo 0.0.0.0;;
    local) echo 127.0.0.1;;
    *) have tailscale && tailscale ip -4 2>/dev/null | head -1;;
  esac
}
rdp_output() {   # pantalla que se comparte ("" = una nueva, virtual)
  local o mons
  o="$(setting rdpOutput | jq -r '. // ""')"
  [ "$o" = virtual ] && return 0
  mons="$(hyprctl monitors -j 2>/dev/null)" || mons='[]'
  [ -z "$o" ] && o="$(setting primaryMonitor | jq -r '. // ""')"
  if [ -n "$o" ] && jq -e --arg o "$o" 'any(.[]; .name == $o)' <<<"$mons" >/dev/null; then echo "$o"; return 0; fi
  jq -r 'max_by(.width * .height) | .name // empty' <<<"$mons"
}
rdp() {
  local op="${1:-status}" port
  port="$(setting rdpPort | jq -r '. // 3389')"
  case "$op" in
    status)
      local run=false fw=""
      systemctl --user is-active -q hf-rdp 2>/dev/null && run=true
      systemctl is-active -q ufw 2>/dev/null && fw=ufw; systemctl is-active -q firewalld 2>/dev/null && fw=firewalld
      jq -cn --argjson installed "$(have hypr-rdp && echo true || echo false)" --argjson running $run \
        --argjson password "$([ -s "$RDPPW" ] && echo true || echo false)" --arg listen "$(setting rdpListen | jq -r '. // "tailscale"')" \
        --arg addr "$(rdp_addr)" --argjson port "$port" --arg output "$(rdp_output)" --arg user "$USER" \
        --argjson tailscale "$(have tailscale && echo true || echo false)" --arg fw "$fw" \
        '{installed:$installed,running:$running,password:$password,listen:$listen,addr:$addr,port:$port,output:$output,user:$user,tailscale:$tailscale,firewall:$fw}';;
    run)   # lo que corre dentro de la unidad hf-rdp
      local addr out a=()
      # Comprobado otra vez aquí: la unidad se reintenta sola y el archivo pudo borrarse o vaciarse entre medias
      # (sin contraseña hypr-rdp deja entrar a cualquiera). Código 3: systemd no la reintenta (RestartPreventExitStatus)
      [ -s "$RDPPW" ] || { echo "Sin contraseña de RDP ($RDPPW): no se arranca" >&2; exit 3; }
      addr="$(rdp_addr)"
      [ -n "$addr" ] || { echo "Tailscale no está conectado: sin dirección donde escuchar" >&2; exit 1; }
      out="$(rdp_output)"; [ -n "$out" ] && a+=(--output "$out")
      exec hypr-rdp -u "$USER" --password-file "$RDPPW" --bind "$addr:$port" "${a[@]}";;
    start)
      have hypr-rdp || { notify -u critical "Falta hypr-rdp" "Instálalo desde Ajustes › Escritorio remoto (AUR: hypr-rdp)"; exit 1; }
      [ -s "$RDPPW" ] || { notify -u critical "RDP sin contraseña" "Ponla en Ajustes › Escritorio remoto: sin ella cualquiera podría entrar."; exit 1; }
      systemctl --user is-active -q hf-rdp && exit 0
      systemctl --user reset-failed hf-rdp 2>/dev/null
      systemd-run --user --unit=hf-rdp --collect -q -p Restart=on-failure -p RestartSec=10 -p RestartPreventExitStatus=3 \
        -E WAYLAND_DISPLAY -E HYPRLAND_INSTANCE_SIGNATURE -E XDG_RUNTIME_DIR -E PATH \
        "$0" rdp run || { notify -u critical "No se pudo arrancar el escritorio remoto (RDP)" "journalctl --user -u hf-rdp"; exit 1; }
      sleep 1.5
      if systemctl --user is-active -q hf-rdp; then
        local addr; addr="$(rdp_addr)"
        notify "Escritorio remoto (RDP) activo" "Conéctate a ${addr:-…}:$port con el usuario $USER"
      else
        notify -u critical "El escritorio remoto (RDP) no arrancó" "$(journalctl --user -u hf-rdp -n 3 -o cat 2>/dev/null | tail -1)"
      fi;;
    stop) systemctl --user stop hf-rdp 2>/dev/null; true;;
    restart) systemctl --user is-active -q hf-rdp || exit 0; systemctl --user stop hf-rdp; sleep 0.5; "$0" rdp start;;
    password)
      local pw pw2
      read -rsp "Contraseña para entrar por RDP (usuario $USER): " pw; echo; read -rsp "Repítela: " pw2; echo
      [ -n "$pw" ] && [ "$pw" = "$pw2" ] || { echo "No coinciden" >&2; exit 1; }
      [ "${#pw}" -ge 8 ] || { echo "Usa al menos 8 caracteres" >&2; exit 1; }
      mkdir -p "$RDPDIR"; chmod 700 "$RDPDIR"
      ( umask 077; printf '%s' "$pw" > "$RDPPW" ); chmod 600 "$RDPPW"
      echo "Listo: mstsc pedirá el usuario $USER y esta contraseña."
      "$0" rdp restart;;
    boot) [ "$(setting rdpServer)" = true ] && exec "$0" rdp start; true;;
    *) echo "rdp status|start|stop|restart|password|boot" >&2; exit 1;;
  esac
}

case "${1:-}" in
  list) list;;
  clients) clients;;
  connect) connect "${2:-}";;
  secret) secret "${2:-}" "${3:-}";;
  server) shift; server "$@";;
  rdp) shift; rdp "$@";;
  *) sed -n '2,/^# Seguridad/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 1;;
esac
